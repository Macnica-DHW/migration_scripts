     "table": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th>Spec Item</th>\r\n<th>Description</th>\r\n</tr><tr><td colspan=\"2\"><b>Communication</b></td>\r\n</tr><tr><td>Bluetooth</td>\r\n<td>Bluetooth V4.1</td>\r\n</tr><tr><td>Wireless</td>\r\n<td>IEEE 802.11a/b/g/n/ac</td>\r\n</tr><tr><td colspan=\"2\"><b>Environment</b></td>\r\n</tr><tr><td>Humidity</td>\r\n<td>10% ~ 95% (non-condensing)</td>\r\n</tr><tr><td>Operating Temperature</td>\r\n<td>-20ºC ~ 50ºC (-4ºF ~ 122ºF)</td>\r\n</tr><tr><td>Storage Temperature</td>\r\n<td>-20°C ~ 60°C (-4ºF ~ 140ºF)</td>\r\n</tr><tr><td colspan=\"2\"><b>I/O Interface</b></td>\r\n</tr><tr><td>Audio</td>\r\n<td>AMP 3W + 3W (internal speaker)</td>\r\n</tr><tr><td>Audio Codec</td>\r\n<td>ALC888S</td>\r\n</tr><tr><td>Ethernet</td>\r\n<td>LAN1 &amp; LAN2: Intel® I211<br>\r\nLAN3: Intel® I219</td>\r\n</tr><tr><td>RAM</td>\r\n<td>Two 260-pin 2400MHz dual-channel DDR4 SO-DIMMs supporting up to 32 GB</td>\r\n</tr><tr><td colspan=\"2\"><b>LCD</b></td>\r\n</tr><tr><td>Backlight MTBF</td>\r\n<td>30000 (LED backlight)</td>\r\n</tr><tr><td>Brightness (cd/m2)</td>\r\n<td>250</td>\r\n</tr><tr><td>Contrast Ratio</td>\r\n<td>1000:1</td>\r\n</tr><tr><td>LCD Color</td>\r\n<td>16.7M</td>\r\n</tr><tr><td>Resolution</td>\r\n<td>1366 X 768 (16:9)</td>\r\n</tr><tr><td>Size</td>\r\n<td>18.5”</td>\r\n</tr><tr><td>Viewing Angle (H-V)</td>\r\n<td>170º / 160º</td>\r\n</tr><tr><td colspan=\"2\"><b>Power</b></td>\r\n</tr><tr><td>Power Requirement</td>\r\n<td>12V, 8A</td>\r\n</tr><tr><td colspan=\"2\"><b>System</b></td>\r\n</tr><tr><td>Cooling method / System Fan</td>\r\n<td>Fanless</td>\r\n</tr><tr><td>CPU</td>\r\n<td>Intel® Core™ i5-8365UE 1.6 GHz (up to 4.1GHz, Quad-core, 6MB cache, TDP=15W)</td>\r\n</tr><tr><td>Storage</td>\r\n<td>1 x M.2 M-key 2242/60/80 PCIe 3.0 x4 (PCIe/SATA Signal)<br>\r\n1 x 2.5” SATA 3Gb/s HDD bay</td>\r\n</tr><tr><td colspan=\"2\"><b>Touch</b></td>\r\n</tr><tr><td>Touch Controller</td>\r\n<td>EXC3160</td>\r\n</tr><tr><td>Touch Screen</td>\r\n<td>PCAP with USB interface (anti-UV/AG coating)</td>\r\n</tr><tr><td colspan=\"2\">Weight</td>\r\n</tr><tr><td>Weight</td>\r\n<td>4.5kg/6.5kg</td>\r\n</tr><tr><td colspan=\"2\"><b>I/O Interface</b></td>\r\n</tr><tr><td rowspan=\"10\">I/O Interface</td>\r\n<td>1 x AT/ATX Switch</td>\r\n</tr><tr><td>1 x Clear CMOS</td>\r\n</tr><tr><td>1 x HDMI</td>\r\n</tr><tr><td>3 x LAN (GbE)</td>\r\n</tr><tr><td>1 x Power In</td>\r\n</tr><tr><td>1 x Power Switch</td>\r\n</tr><tr><td>1 x Reset Button</td>\r\n</tr><tr><td>1 x RS-232</td>\r\n</tr><tr><td>1 x RS-422/485 (RS-232/422/485)</td>\r\n</tr><tr><td>4 x USB 3.2 Gen2</td>\r\n</tr></tbody></table>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true"
