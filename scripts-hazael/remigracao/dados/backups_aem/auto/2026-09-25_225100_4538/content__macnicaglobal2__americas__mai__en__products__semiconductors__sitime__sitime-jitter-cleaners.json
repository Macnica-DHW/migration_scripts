        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li>Hyperscale data centers</li>\n<li>5G RRHs</li>\n<li>Optical modules</li>\n<li>Enterprise switches</li>\n<li>Satellite comms</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
