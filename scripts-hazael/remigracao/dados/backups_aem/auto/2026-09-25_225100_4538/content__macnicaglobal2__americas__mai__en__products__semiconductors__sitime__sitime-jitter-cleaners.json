         "type": "h2",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li>Supports integrated PLL with jitter attenuation</li>\n<li>Compliant with industry standards (PCIe, Ethernet, IEEE 1588)</li>\n<li>Fast start-up, low power, and compact footprint</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
