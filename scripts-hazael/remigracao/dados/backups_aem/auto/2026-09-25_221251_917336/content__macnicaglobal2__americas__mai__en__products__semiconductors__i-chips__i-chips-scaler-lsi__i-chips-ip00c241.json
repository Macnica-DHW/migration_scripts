       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "xvYCC/Bt-2020",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><p>Fully supported</p>\n</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_8": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "HDR",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><p>SMPTE ST2084(PQ HDR10) and HLG methods supported (RGB 10-bit each)</p>\n</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_9": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "CPU I/F",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><p>4-wire SPI</p>\n</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_10": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Bitmap OSD",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><p>Three types of graphics can be displayed at the same time: Font (2 colors), Graphic (256 colors) and Background OSD (up to 64k colors)</p>\n</li>\n<li><p>Transparent (up to 4 colors)</p>\n</li>\n<li><p>Scaling up for Background OSD (any size, 2-symbol)</p>\n</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_11": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
