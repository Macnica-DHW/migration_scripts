    "container_755057991": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": [
      "1717498052331",
      "1717498053499"
     ],
     "flex_specs_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "1718800525141",
       "1719484596357"
      ],
      "item_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>FPGA</h3>\r\n<ul>\r\n<li>Altera Stratix 10 Soc FPGA 1SX280HU2F50E1VG</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "item_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>FPGA Configuration</h3>\r\n<ul>\r\n<li>Key Features</li>\r\n<li>Agilex® 1.4MLE FPGA with an integrated 1.4GHz quad-core ARM Cortex-A53 processor system</li>\r\n<li>Two 72-bit DDR4 ECC SODIMM sockets, microSD card socket, 1Gbits of QSPI configuration flash</li>\r\n<li>On-board power regulators and board management system</li>\r\n<li>On-board high-speed Interfaces:&nbsp; FMC/FMC+, QSFP28, GigE, USB2, USB-UART, USB Blaster II</li>\r\n<li>PCIe Gen4 x16 interface via the FMC+ connectorOn-Board USB Blaster II for FPGA programming and Debug</li>\r\n<li>AS Mode configuration from QSPI Flash</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     },
     "flex_specs_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "1718800525141",
       "1719484596357"
      ],
      "item_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>Clock and User Interface</h3>\r\n<ul>\r\n<li>Four 50Mhz Single-ended Clock Source</li>\r\n<li>One 100Mhz Single-ended Clock Source</li>\r\n<li>Clock Generator Si5341</li>\r\n<li>LED x2, Button x2, Dip Switch x2, CPU Reset</li>\r\n<li>Power Switch</li>\r\n<li>FMC Adjustable Voltage 1.8V/1.5V/1.2V&nbsp;</li>\r\n<li>FMC+ Adjustable Voltage 1.8V/1.5V/1.2V&nbsp;</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "item_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>Memory</h3>\r\n<ul>\r\n<li>1024Mbit QSPI Flash (EPCQL1024 Compliant)</li>\r\n<li>Total of 64GB DDR4 x72 2133MT/s with ECC<ul>\r\n<li>Two independent DDR4 banks</li>\r\n<li>One bank is shared with FPGA and HPS</li>\r\n</ul>\r\n</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     },
     "flex_specs_3": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "1718800525141",
       "1719484596357"
      ],
      "item_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>Communication and Expansion</h3>\r\n<ul>\r\n<li>FMC (Vita57.1) connector with 10 transceivers</li>\r\n<li>FMC+ (Vita57.4) connector with 24 transceivers</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "item_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>HPS</h3>\r\n<ul>\r\n<li>MicroSD Socket</li>\r\n<li>Gigabit Ethernet with RJ45</li>\r\n<li>USB OTG with Micro USB Connector</li>\r\n<li>UART to USB with Mini USB Connector</li>\r\n<li>RTC</li>\r\n<li>LED x1, Button x1, Cold Reset Button</li>\r\n<li>1x6 GPIO Header</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
