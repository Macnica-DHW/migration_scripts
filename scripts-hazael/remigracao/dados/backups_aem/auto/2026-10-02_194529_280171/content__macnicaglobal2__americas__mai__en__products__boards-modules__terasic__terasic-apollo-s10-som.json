      "item_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>Dashboard System</h3>\r\n<ul>\r\n<li>Input Power Monitor</li>\r\n<li>FPGA and Board Temperature Monitor</li>\r\n<li>Fan Control and Monitor</li>\r\n<li>Auto Fan Speed</li>\r\n<li>Auto Shutdown</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       },
       "text_2": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3>Power Source</h3>\r\n<ul>\r\n<li>12V from 2x4 PCIe connector</li>\r\n<li>12V from Samtec connector (reserved for carrier board)</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
