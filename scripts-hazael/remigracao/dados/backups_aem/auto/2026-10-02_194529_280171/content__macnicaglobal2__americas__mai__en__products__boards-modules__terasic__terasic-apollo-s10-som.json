    "container_930892": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "1717498052331",
      "1717498053499"
     ],
     "textwithimage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/terasic/images/Terasic Apollo S10 SOM%0A.jpeg",
      "imageRatio": "30",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "alt": "Terasic Apollo S10 SOM",
      "text": "<p>Terasic Apollo S10 System-on-Module (SOM), is a cutting-edge solution designed for highly adaptable and scalable FPGA prototyping and HPC applications. Despite its compact size, the Apollo S10 SOM delivers unparalleled performance and energy efficiency. In fact, it offers an astounding 90X increase in performance compared to CPUs when handling critical workloads like simulation acceleration, molecular dynamics, and machine learning.</p>\r\n<p>The secret behind the Terasic Apollo S10 SOM lies in its utilization of the latest Altera Stratix® 10 SoC, boasting an impressive 2800K logic elements, which enables remarkable speed and power advancements with up to 70% lower energy consumption. Additionally, the Apollo S10 SOM incorporates a range of high-end hardware interfaces, including high-capacity and high-bandwidth DDR4 SDRAM (up to 64GB), an on-board USB-Blaster II, and FMC/FMC+ connectors for I/O expansion. As a result, this board delivers over 2X the performance of previous-generation development kits.</p>\r\n<p>The Terasic Apollo S10 SOM is designed to be highly extensible. To facilitate our client's development process, we offer the Apollo Carrier board, which is tailor-made for the Apollo S10 SOM. This carrier board provides essential features for evaluating and integrating the Apollo S10 SOM into custom systems. Notably, it includes two ultra-low-latency 40Gbps QSFP+ modules and Thunderbolt™ 3 connectivity. This enables clients to assess their desired I/O configuration and seamlessly build their own tailored systems around the Apollo S10 SOM.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "jcr:lastModified": "Thu Sep 24 2026 15:13:04 GMT+0000",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
      "cq:styleIds": [
       "1718154328384",
       "",
       ""
      ],
