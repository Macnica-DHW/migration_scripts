         "text": "<table width=\"100%\" cellpadding=\"1\" cellspacing=\"0\" border=\"1\"><tbody><tr><th style=\"\ttext-align: center;\n\">Core Technology</th><th style=\"\ttext-align: center;\n\">Module Type</th><th style=\"\ttext-align: center;\n\">Speed</th><th style=\"\ttext-align: center;\n\">Operating Temperature</th><th style=\"\ttext-align: center;\n\">Capacities</th><th style=\"\ttext-align: center;\n\">Chip Brand</th></tr><tr><td width=\"10%\" rowspan=\"5\" style=\"\ttext-align: center;\n\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/transcend/transcend-ddr5-dram-modules.html\">DDR5</a></td><td style=\"\ttext-align: center;\n\">U-DIMM</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">6400MHz<br />\r\n5600MHz<br />\r\n4800MHz</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">Standard Temp:  -20 ~ 95° C<br />\r\nIndustrial Temp: -40 ~ 95° C</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">8GB<br />\r\n16GB<br />\r\n32GB<br />\r\n48GB<br />\r\n64GB</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">Primary: Samsung<br />\r\nSecondary: Micron</td></tr><tr><td style=\"\ttext-align: center;\n\">SO DIMM</td></tr><tr><td style=\"\ttext-align: center;\n\">U-DIMM w/ ECC</td></tr><tr><td style=\"\ttext-align: center;\n\">SO DIMM w/ ECC</td></tr><tr><td style=\"\ttext-align: center;\n\">Server R-DIMM</td></tr><tr><td rowspan=\"5\" style=\"\ttext-align: center;\n\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/transcend/transcend-ddr4-dram-modules.html\">DDR4</a></td><td style=\"\ttext-align: center;\n\">U-DIMM</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">3200MHz<br />\r\n2666MHz<br />\r\n2400MHz<br />\r\n2133MHz</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">Standard Temp:  -20 ~ 95° C<br />\r\nIndustrial Temp: -40 ~ 95° C</td><td rowspan=\"5\" style=\"\ttext-align: center;\n\">2GB<br />\r\n4GB<br />\r\n8GB<br />\r\n16GB<br />\r\n32GB<br />\r\n64GB</td><td rowspan=\"5\