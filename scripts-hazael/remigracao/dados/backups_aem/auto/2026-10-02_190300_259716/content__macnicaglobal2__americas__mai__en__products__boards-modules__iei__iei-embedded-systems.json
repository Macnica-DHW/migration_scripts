      "table": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\r\n<tbody><tr><th>Product Line</th>\r\n<th>Form Factor/Mounting</th>\r\n<th>Key Features</th>\r\n</tr><tr><td width=\"25%\">TANK/ECW</td>\r\n<td width=\"25%\">Rugged box PCs</td>\r\n<td width=\"50%\">Wide I/O, PCI/PCIe expansion, fanless design</td>\r\n</tr><tr><td>DRPC</td>\r\n<td>DIN-rail mount</td>\r\n<td>Slim profile, integrated I/O, modular add-ons</td>\r\n</tr><tr><td>IDS</td>\r\n<td>Compact chassis</td>\r\n<td>Multi-HDMI outputs, digital signage-ready</td>\r\n</tr><tr><td>Modular Edge</td>\r\n<td>Box and rack formats</td>\r\n<td>GPU/accelerator support, AI-ready platforms</td>\r\n</tr></tbody></table>",
       "sling:resourceType": "macnicaglobal2/components/content/table",
