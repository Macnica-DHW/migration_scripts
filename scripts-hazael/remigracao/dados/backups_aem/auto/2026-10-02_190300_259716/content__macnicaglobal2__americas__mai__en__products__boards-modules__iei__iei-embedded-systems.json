     "text": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<h3>Use Case Highlights</h3>\r\n<ul>\r\n<li><b>Factory Automation</b>: Deploy DRPC systems for machine control and data acquisition</li>\r\n</ul>\r\n<ul>\r\n<li><b>Smart Surveillance</b>: Use TANK or ECW box PCs with multiple camera inputs for monitoring</li>\r\n</ul>\r\n<ul>\r\n<li><b>Retail and Transportation</b>: IDS signage players provide reliable multi-screen displays for menus, schedules, or advertisements</li>\r\n</ul>\r\n<ul>\r\n<li><b>AI at the Edge</b>: Modular edge platforms support vision analytics and predictive maintenance in real time</li>\r\n</ul>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
