     "table": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\"><tbody><tr><th style=\"width:30%;text-align:left\">Spec Item</th><th>Description</th></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>Communication</b></th></tr><tr><td style=\"width:30%;text-align:left\">Bluetooth</td><td>Bluetooth V4.1</td></tr><tr><td style=\"width:30%;text-align:left\">Wireless</td><td>IEEE 802.11a/b/g/n/ac</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>Environment</b></th></tr><tr><td style=\"width:30%;text-align:left\">Humidity</td><td>10% ~ 95% (non-condensing)</td></tr><tr><td style=\"width:30%;text-align:left\">Operating Temperature</td><td>-20ºC ~ 50ºC (-4ºF ~ 122ºF)</td></tr><tr><td style=\"width:30%;text-align:left\">Storage Temperature</td><td>-20°C ~ 60°C (-4ºF ~ 140ºF)</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>I/O Interface</b></th></tr><tr><td style=\"width:30%;text-align:left\">Audio</td><td>AMP 3W &#43; 3W (internal speaker)</td></tr><tr><td style=\"width:30%;text-align:left\">Audio Codec</td><td>ALC888S</td></tr><tr><td style=\"width:30%;text-align:left\">Ethernet</td><td>LAN1 &amp; LAN2: Intel® I211<br />\r\nLAN3: Intel® I219</td></tr><tr><td style=\"width:30%;text-align:left\">RAM</td><td>Two 260-pin 2400MHz dual-channel DDR4 SO-DIMMs supporting up to 32 GB</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>LCD</b></th></tr><tr><td style=\"width:30%;text-align:left\">Backlight MTBF</td><td>30000 (LED backlight)</td></tr><tr><td style=\"width:30%;text-align:left\">Brightness (cd/m2)</td><td>250</td></tr><tr><td style=\"width:30%;text-align:left\">Contrast Ratio</td><td>1000:1</td></tr><tr><td style=\"width:30%;text-align:left\">LCD Color</td><td>16.7M</td></tr><tr><td style=\"width:30%;text-align:left\">Resolution</td><td>1366 X 768 (16:9)</td></tr><tr><td style=\"width:30%;text-align:left\">Size</td><td>18.5”</td></tr><tr><td style=\"width:30%;text-align:left\">Viewing Angle (H-V)</td><td>170º / 160º</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>Power</b></th></tr><tr><td style=\"width:30%;text-align:left\">Power Requirement</td><td>12V, 8A</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>System</b></th></tr><tr><td style=\"width:30%;text-align:left\">Cooling method / System Fan</td><td>Fanless</td></tr><tr><td style=\"width:30%;text-align:left\">CPU</td><td>Intel® Core™ i5-8365UE 1.6 GHz (up to 4.1GHz, Quad-core, 6MB cache, TDP&#61;15W)</td></tr><tr><td style=\"width:30%;text-align:left\">Storage</td><td>1 x M.2 M-key 2242/60/80 PCIe 3.0 x4 (PCIe/SATA Signal)<br />\r\n1 x 2.5” SATA 3Gb/s HDD bay</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>Touch</b></th></tr><tr><td style=\"width:30%;text-align:left\">Touch Controller</td><td>EXC3160</td></tr><tr><td style=\"width:30%;text-align:left\">Touch Screen</td><td>PCAP with USB interface (anti-UV/AG coating)</td></tr><tr><th colspan=\"2\" style=\"text-align:center\">Weight</th></tr><tr><td style=\"width:30%;text-align:left\">Weight</td><td>4.5kg/6.5kg</td></tr><tr><th colspan=\"2\" style=\"text-align:center\"><b>I/O Interface</b></th></tr><tr><td style=\"width:30%;text-align:left\" rowspan=\"10\">I/O Interface</td><td>1 x AT/ATX Switch</td></tr><tr><td style=\"width:30%;text-align:left\">1 x Clear CMOS</td></tr><tr><td style=\"width:30%;text-align:left\">1 x HDMI</td></tr><tr><td style=\"width:30%;text-align:left\">3 x LAN (GbE)</td></tr><tr><td style=\"width:30%;text-align:left\">1 x Power In</td></tr><tr><td style=\"width:30%;text-align:left\">1 x Power Switch</td></tr><tr><td style=\"width:30%;text-align:left\">1 x Reset Button</td></tr><tr><td style=\"width:30%;text-align:left\">1 x RS-232</td></tr><tr><td style=\"width:30%;text-align:left\">1 x RS-422/485 (RS-232/422/485)</td></tr><tr><td style=\"width:30%;text-align:left\">4 x USB 3.2 Gen2</td></tr></tbody></table>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true"
     }
