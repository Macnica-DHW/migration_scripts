     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>AM6526</li>\n<li>AM6528</li>\n<li>AM6546</li>\n<li>AM6548</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR4-SDRAM: Up to 4 GB + ECC</li>\n<li>Quad SPI NOR: Up to 512 MB</li>\n<li>eMMC Flash: Up to 64</li>\n<li>GB EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD Interface: 1x 24bit RGB LCD, 1x LVDS</li>\n<li>Camera: 1x MIPI CSI2, 1x 16-bit Video IN</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 1x Ethernet 10/100/1000 Mbit</li>\n<li>Up to 6x Ethernet 1000 Mbit (PRU)</li>\n<li>Up to 1x USB 3.1 interface</li>\n<li>Up to 1x USB 2.0 interface</li>\n<li>Up to 5x UART</li>\n<li>Up to 2x CAN FD</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>Up to 2x SDIO/MMC</li>\n<li>Up to 2x PCIe 3.0</li>\n<li>Up to 6x I2C</li>\n<li>Up to 8x SPI</li>\n<li>Up to 2x QSPI</li>\n<li>Up to 3x McASP/I²S</li>\n<li>Up to 2x ADC</li>\n<li>Up to 32 GPIO</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V</li>\n<li>Ambient conditions<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C…+85°C</li>\n<li>Dimensions 77 mm x 55 mm</li>\n</ul>\n</li>\n<li>Plug-in system Board-to-board plug-in system 560 pins 0.5 mm Pitch</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX on request</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:34:08 GMT+0000",
