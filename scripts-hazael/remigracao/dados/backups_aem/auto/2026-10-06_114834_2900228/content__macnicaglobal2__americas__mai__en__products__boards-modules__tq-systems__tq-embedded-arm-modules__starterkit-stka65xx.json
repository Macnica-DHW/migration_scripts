    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>High-Speed Communication</b>: Equipped with up to 6x real-time GBit Ethernet, 1x Gbit Ethernet, 4x USB 2.0, and 2x CAN-FD support.</li>\n<li><b>Graphics Support</b>: Provides Full HD and 3D graphics capabilities for advanced visual processing.</li>\n<li><b>Low Power Consumption</b>: Maintains a low power profile, typically around 6W.</li>\n<li><b>Integrated RF5 Controllers</b>: Features 2x integrated RF5 controllers for enhanced functionality.</li>\n<li><b>Security Functions</b>: Incorporates security features for data protection and system integrity.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:33:02 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
