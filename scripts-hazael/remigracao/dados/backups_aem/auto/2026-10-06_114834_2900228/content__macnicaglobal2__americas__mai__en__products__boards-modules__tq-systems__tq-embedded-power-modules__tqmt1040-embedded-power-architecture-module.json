     "title_spec": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Specifications",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "table_spec": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><td><b>CPU</b></td>\r\n<td><p>CPU/Processor:</p>\r\n<ul>\r\n<li>Quad T1040 Power Architecture® e5500 cores (64-bit)</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Memory</b></td>\r\n<td><p>EEPROM:</p>\r\n<ul>\r\n<li>32kbit</li>\r\n</ul>\r\n<p>NOR Flash:</p>\r\n<ul>\r\n<li>Up to 256 MB</li>\r\n</ul>\r\n<p>DDR3L:</p>\r\n<ul>\r\n<li>Up to 8 GB</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Other interfaces</b></td>\r\n<td><p>SPI:</p>\r\n<ul>\r\n<li>1x eSPI Controller</li>\r\n</ul>\r\n<p>GPIO:</p>\r\n<ul>\r\n<li>Up to 32x GPIO</li>\r\n</ul>\r\n<p>I2C:</p>\r\n<ul>\r\n<li>4x I²C, max. 400 kHz</li>\r\n</ul>\r\n<p>SATA:</p>\r\n<ul>\r\n<li>2x SATA 2.0</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>General</b></td>\r\n<td><p>Dimensions:</p>\r\n<ul>\r\n<li>74 mm x 54 mm</li>\r\n</ul>\r\n<p>Plug-in System:</p>\r\n<ul>\r\n<li>Board-to-Board plug-in system 360 pins</li>\r\n</ul>\r\n<p>Power supply:</p>\r\n<ul>\r\n<li>5 V</li>\r\n</ul>\r\n<p>Temperature range:</p>\r\n<ul>\r\n<li>Standard temperature: 0°C - +70°C</li>\r\n<li>Extended temperature: -40°C - +85°C</li>\r\n</ul>\r\n<p>Power consumption:</p>\r\n<ul>\r\n<li>typ. 7 W up to 9 W</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>OS</b></td>\r\n<td><p>OS Support:</p>\r\n<ul>\r\n<li>Linux</li>\r\n<li>PikeOS™ (on request)</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true"
     },
