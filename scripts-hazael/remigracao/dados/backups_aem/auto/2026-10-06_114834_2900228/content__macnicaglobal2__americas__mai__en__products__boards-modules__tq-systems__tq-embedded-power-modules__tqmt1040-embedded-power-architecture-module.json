    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>QorIQ® Quad T1040 Power Architecture®</li>\n<li>Quad-core up to 1400 MHz in 28nm SOI for best performance/watt ratio</li>\n<li>Simple functional expansion via PCle, eSPI, I²C and local bus</li>\n<li>High-speed communication through a combination of up to 4x Gigabit Ethernet and integrated 8-port switch, 4x PCle and two USB 2.0 interfaces</li>\n<li>Dual SATA interfaces for data storage</li>\n<li>IEEE 1588 Time synchronization in hardware</li>\n<li>Extremely compact module dimensions</li>\n</ul>",
      "jcr:lastModified": "Fri Aug 28 2026 22:54:49 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_copy_558282354": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
     "jcr:lastModified": "Thu Aug 27 2026 22:31:00 GMT+0000",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f7f7f7",
