    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Robust Security Functions</b>: Equipped with advanced security functions to safeguard data.</li>\n<li><b>IEEE 1588 Support:</b> Provides support for IEEE 1588, ensuring precise time synchronization.</li>\n<li><b>Versatile Flash Storage</b>: Offers both NOR Flash and e-MMC Flash for flexible data storage.</li>\n<li><b>Extended Temperature Range</b>: Capable of operating in an extended temperature range for diverse environments.</li>\n<li><b>Low Power Consumption</b>: Maintains an energy-efficient profile, typically consuming around 4 watts.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:43:42 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
