     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>i.MX6 Solo/Dual Lite/Dual/Quad/ Dual+/Quad+</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3L-SDRAM: Up to 2 GB</li>\n<li>(MCIMX6 Solo with 1 GB)</li>\n<li>eMMC: Up to 16 GB</li>\n<li>NOR: Up to 128 MB</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>DVI (HDMI)</li>\n<li>Parallel 2x 24-bit (RGB)</li>\n<li>Dual LVDS</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>1x Ethernet 10/100/1000 Mbit (IEEE 1588)</li>\n<li>2x FlexCAN</li>\n<li>1x USB 2.0 high speed OTG interface</li>\n<li>1x USB 2.0 high speed HOST interface</li>\n<li>Up to 5x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>WEIM Bus</li>\n<li>Up to 3x SDIO/MMC</li>\n<li>Up to 2x I²C</li>\n<li>Up to 5x SPI</li>\n<li>Up to 3x SSI/I²S</li>\n<li>ESAI</li>\n<li>2x 16-bit Camera I/F</li>\n<li>SATA</li>\n<li>PCIe</li>\n<li>SPDIF</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V Ambient conditions Standard temperature range: -25°C…+85°C Extended temperature range: -40°C…+85°C Dimensions 70 mm x 46 mm Plug-in system Board-to-board plug-in system 360 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX&nbsp;</li>\n<li>VxWorks</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:46:43 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
