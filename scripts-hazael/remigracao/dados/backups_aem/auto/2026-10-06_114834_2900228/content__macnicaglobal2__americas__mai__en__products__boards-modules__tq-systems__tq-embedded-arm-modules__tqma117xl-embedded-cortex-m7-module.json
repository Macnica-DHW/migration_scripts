     "textwithimage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/tq-systems/arm-modules/TQMa117xL Embedded Cortex-M7 module.jpeg",
