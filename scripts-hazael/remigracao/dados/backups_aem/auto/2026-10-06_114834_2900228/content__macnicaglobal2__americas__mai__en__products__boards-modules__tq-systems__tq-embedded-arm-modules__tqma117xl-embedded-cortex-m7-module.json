     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor: Single Cortex®-M7 - Up to 1GHz</li>\n<li>CPU variant:<ul>\n<li>i.MX RT1171</li>\n<li>i.MX RT1172</li>\n<li>i.MX RT1173</li>\n<li>i.MX RT1175</li>\n<li>i.MX RT1176</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LP-SDRAM: Up to 64 MB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Graphics: LCD Interface: 1x MIPI DSI (2 Lanes), Parallel LCD</li>\n<li>Camera: 1x MIPI CSI (2 Lanes)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet:<ul>\n<li>Up to 2x Gbit-Ethernet (1x TSN/1x AVB)</li>\n<li>1x Gbit Ethernet, IEEE 1588 Trigger signal</li>\n</ul>\n</li>\n<li>Serial Ports: Up to 12x UART</li>\n<li>CAN: Up to 3x CAN FD</li>\n<li>USB: Up to 2x USB 2.0</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: Up to 2x SDIO / eMMC 5.0</li>\n<li>I2C: Up to 6x I2C</li>\n<li>SPI:<ul>\n<li>Up to 6x SPI</li>\n<li>Up to 2x QSPI</li>\n</ul>\n</li>\n<li>Audio:<ul>\n<li>Up to 4x SAI</li>\n<li>Up to 8-ch DMIC</li>\n<li>Up to 1x SPDIF</li>\n</ul>\n</li>\n<li>GPIO: UP to 2x FlexIO</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Plug-in System: LGA (Land Grid Array) 277 pins</li>\n<li>Power supply: 5 V</li>\n<li>Dimensions: 31 mm x 31 mm</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Free RTOS</li>\n<li>Others on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:04:52 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
