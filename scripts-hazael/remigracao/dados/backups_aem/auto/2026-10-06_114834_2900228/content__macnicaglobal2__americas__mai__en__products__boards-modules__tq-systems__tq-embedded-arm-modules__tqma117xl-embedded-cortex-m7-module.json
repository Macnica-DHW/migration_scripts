    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Arm Cortex-M7 processor with up to 1GHz clock speed.</li>\n<li>Multiple CPU variants to choose from within the i.MX RT1170 series.</li>\n<li>Support for LP-SDRAM and Quad SPI NOR memory.</li>\n<li>Rich graphics capabilities with LCD and camera interfaces.</li>\n<li>Extensive connectivity options, including UART, CAN FD, and USB.</li>\n<li>Wide temperature range and compact form factor for industrial applications.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:03:59 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
