     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:123px;\"><p><b>TQMa28-AA</b></p>\n</td>\n<td><ul>\n<li>i.MX287 @ 450 MHz, 128 MB DDR2, 8 GB eMMC flash, 64-kbit EEPROM, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:123px;\"><p><b>TQMa28-AC</b></p>\n</td>\n<td><ul>\n<li>i.MX287 @ 450MHz, 8 GB e-MMC, 128 MB DDR2, 64 kB EEPROM, Boot EEPROM, -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:123px;\"><p><b>TQMa28-AD</b></p>\n</td>\n<td><ul>\n<li>i.MX287 @ 450MHz, 8 GB e-MMC, 128 MB DDR2, 64 kB EEPROM, Boot EEPROM, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:123px;\"><b>TQMa28-AE</b></td>\n<td><ul>\n<li>i.MX287 @ 450MHz, 8 GB e-MMC, 128 MB DDR2, 64 kB EEPROM, Boot EEPROM, Supervisor 5V,-25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:123px;\"><b>TQMa28-AF</b></td>\n<td><ul>\n<li>i.MX287 / 454MHz, 8GB eMMC-Flash, 256MB DDR2-SDRAM, 64kB EEPROM, Boot-EEPROM (-25 - +85°C)</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:123px;\"><b>STKa28-AA</b></td>\n<td><ul>\n<li>STKa28 (Eval Kit) with TQMa28-AA, i.MX287/450 MHz, 128 MB DDR2, 8 GB eMMC flash, 64-kbit EEPROM, 1x RS232, 1x RS485, GPIO 4x IN/ 8x OUT, 2x CAN 2.0 B isol., 2x USB 2.0 HOST, 2x ETH 10/100, Stereo Out, Mono Mic In, RTC, Temperature sensor, Reset button, SD interface, Power Supply, 2 GB SD card, Z-Modem Cable</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:11:06 GMT+0000",
