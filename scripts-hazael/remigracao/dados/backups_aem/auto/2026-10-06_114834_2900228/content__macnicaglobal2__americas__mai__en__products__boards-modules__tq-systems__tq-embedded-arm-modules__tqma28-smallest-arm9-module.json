     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table height=\"100%\" width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"1\">\n<tbody><tr><td style=\"text-align: left;\"><b>CPU</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">CPU/Processor: Single Arm 9 - Up to 450MHz</li>\n<li style=\"text-align: left;\">CPU variant:<ul>\n<li style=\"text-align: left;\">i.MX287</li>\n<li style=\"text-align: left;\">i.MX283</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>Memory</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">eMMC: Up to 16 GB</li>\n<li style=\"text-align: left;\">DDR2: Up to 256 MB</li>\n<li style=\"text-align: left;\">EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>Graphics</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">24-bit TFT Interface</li>\n<li style=\"text-align: left;\">Up to 8x 12-bit ADC channels</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>Communications Interfaces</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">Ethernet: Up to 2x Ethernet 10/100 Mbit</li>\n<li style=\"text-align: left;\">USB:<ul>\n<li style=\"text-align: left;\">1x USB 2.0 high-speed HOST interface</li>\n<li style=\"text-align: left;\">1x USB 2.0 high-speed OTG interface</li>\n</ul>\n</li>\n<li style=\"text-align: left;\">Serial Ports: Up to 5x UART</li>\n<li style=\"text-align: left;\">CAN: Up to 2x CAN 2.0 B</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>Other Interfaces</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">I2C: Up to 2x I2C</li>\n<li style=\"text-align: left;\">I2S: Up to 2x I2S</li>\n<li style=\"text-align: left;\">SPI: Up to 2x SPI</li>\n<li style=\"text-align: left;\">GPIO: 1x GPIO</li>\n<li style=\"text-align: left;\">SD Card: 1x SDIO/MMC</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>General</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">Plug-in System: Board-to-Board plug-in system (160 Pins) 2x80</li>\n<li style=\"text-align: left;\">General: Temperature sensor</li>\n<li style=\"text-align: left;\">Supervisor 5 V</li>\n<li style=\"text-align: left;\">Temperature range:<ul>\n<li style=\"text-align: left;\">Standard temperature range: -25°C…+85°C</li>\n<li style=\"text-align: left;\">Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n<li style=\"text-align: left;\">Power supply: 5 V</li>\n<li style=\"text-align: left;\">Up to 8x PWM</li>\n<li style=\"text-align: left;\">Dimensions: 26 mm x 40 mm</li>\n</ul>\n</td>\n</tr><tr><td style=\"text-align: left;\"><b>OS</b></td>\n<td style=\"text-align: left;\"><ul>\n<li style=\"text-align: left;\">Linux, Win CE 6.0, QNX</li>\n<li style=\"text-align: left;\">VxWorks on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 12:19:02 GMT+0000",
