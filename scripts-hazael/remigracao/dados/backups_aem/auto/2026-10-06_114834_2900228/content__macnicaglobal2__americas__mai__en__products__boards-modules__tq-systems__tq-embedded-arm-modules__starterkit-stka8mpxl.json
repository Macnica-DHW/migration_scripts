     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>i.MX 8M Plus Quad 8 ML/AI</li>\n<li>i.MX 8M Plus Quad 6 Video</li>\n<li>i.MX 8M Plus Quad 4 Lite</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4-SDRAM: Up to 8 GB</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n<li>eMMC Flash: Up to 256 GB</li>\n<li>EEPROM: 0 / 64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD Interface: 1x MIPI DSI; (4 Lanes)</li>\n<li>LVDS (4/8 Lanes),</li>\n<li>HDMI 2.0a</li>\n<li>Camera: 2x MIPI CSI2 (4 Lanes)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 2x Gbit-Ethernet (1x TSN)</li>\n<li>Up to 2x USB 3.0</li>\n<li>Up to 2x CAN FD</li>\n<li>Up to 4x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>Up to 3x SDIO / eMMC</li>\n<li>Up to 1x PCIe 3.0</li>\n<li>Up to 6x I2 C</li>\n<li>Up to 3x SPI</li>\n<li>Up to 1x QSPI</li>\n<li>Up to 18x I²S</li>\n<li>Up to 8x PDM Mic.</li>\n<li>Up to 1x SPDIF</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V</li>\n<li>Ambient conditions<ul>\n<li>Standard temperature range: -25°C...+85°C</li>\n<li>Extended temperature range: -40°C...+85°C</li>\n<li>Dimensions 38 mm x 38 mm</li>\n</ul>\n</li>\n<li>Plug-in system LGA (Land Grid Array) 366 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:49:18 GMT+0000",
