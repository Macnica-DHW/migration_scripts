     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Advanced audio with HiFi4 DSP.</li>\n<li>Machine Learning Accelerator with 2.3 TOPS.</li>\n<li>Integrated Cortex-M7.</li>\n<li>High-speed communication interfaces.</li>\n<li>Low power consumption and security features.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:48:32 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
