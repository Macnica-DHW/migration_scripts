    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Advanced audio properties</li>\n<li>Integration of Cortex M4</li>\n<li>High-speed communication with Gbit Ethernet</li>\n<li>Multiple CPU variants for varying performance needs</li>\n<li>Integrated graphics controller with GPU and hardware acceleration</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 03:18:56 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
