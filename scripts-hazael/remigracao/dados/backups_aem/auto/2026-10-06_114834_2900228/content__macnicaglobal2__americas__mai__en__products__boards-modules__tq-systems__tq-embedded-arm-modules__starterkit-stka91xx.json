     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:131px;\"><b>STKa91xxLA</b></td>\n<td>STKa91xxLA (Eval Kit) with TQMa91x1LA-AA, Single Cortex A55/1,4 GHz, 1 GB LPDDR4, 8 GB eMMC Flash, 64 kB EEPROM, RTC, 2x USB 2.0 HOST, 1x USB Type C, 2x ETH 10/100/1000, 2x CAN FD, 1x RS485, 1x LVDS, 1x MIPI CSI, 1x DP, &nbsp;1x Mini PCIe + SIM Card (USB only), WLAN, Temperature sensor, Reset-Button, Micro SD Card interface, Power Supply, 8 GB SD card, Cables, Connector</td>\n</tr></tbody></table>",
