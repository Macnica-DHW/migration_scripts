     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Arm® Cortex®-A55 based on i.MX 93</li>\n<li>High-speed communication via 2x Gbit Ethernet (1x TSN), 2x USB 2.0 interface</li>\n<li>Low power consumption (typ. 2W)</li>\n<li>Integrated security functions</li>\n<li>Advanced Secure Element SE050</li>\n<li>Gyroscope sensor</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 00:04:10 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
