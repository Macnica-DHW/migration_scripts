    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Advanced audio properties with HiFi4 DSP.</li>\n<li>Machine Learning Accelerator with 2.3 TOPS.</li>\n<li>I2x CAN FD and digital input/output options.</li>\n<li>High-speed communication via 2x Gbit Ethernet, 1x PCIe, and 2x USB 3.0.</li>\n<li>Integrated security functions.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 17:32:41 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
