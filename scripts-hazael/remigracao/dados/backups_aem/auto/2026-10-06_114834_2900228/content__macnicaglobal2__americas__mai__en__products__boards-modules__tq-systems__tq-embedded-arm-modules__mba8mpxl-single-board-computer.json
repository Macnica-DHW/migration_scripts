     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:155px;\"><b>MBa8MPxL-AB</b></td>\n<td><ul>\n<li>MBa8MPQL-AB with TQMa8MPQL-AB, Quad Cortex-A53/1.6 GHz MIMX8ML8CVNKZAB, 2 GB LPDDR4, 16 GB eMMC Flash, 64 kB EEPROM, RTC, 2x USB 3.0 HOST, 1x USB 3.0 OTG, 2x ETH 10/100/1000, 2x CAN FD, 1x HDMI, 1x DP, 1x Dual LVDS, 2x MIPI CSI, 1x PCIe M.2 + SIM Card, Audio, GPIOs (4x 24V_IN, 4x 24V_OUT, 2x AI_IN), Temperature sensor, Reset-Button, Micro SD Card interface</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:155px;\"><p><b>MBA8MPQL-AD</b></p>\n</td>\n<td><ul>\n<li>MBa8MPQL-AD with TQMa8MPQL-AD, Quad Cortex-A53/1.6 GHz MIMX8ML6CVNKZAB, 4 GB LPDDR4, 64 GB eMMC Flash, 64MB SPI NOR Flash, 64 kB EEPROM, RTC, 2x USB 3.0 HOST, 1x USB 3.0 OTG, 2x ETH 10/100/1000, 2x CAN FD, 1x HDMI, 1x DP, 1x Dual LVDS, 2x MIPI CSI, 1x PCIe M.2 + SIM Card, Audio, GPIOs (4x 24V_IN, 4x 24V_OUT, 2x AI_IN), Temperature sensor, Reset-Button, Micro SD Card interface</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:155px;\"><p><b>MBA8MPQL-AF</b></p>\n</td>\n<td><ul>\n<li>MBa8MPQL-AF with TQMa8MPQL-AF, Quad Cortex-A53/1.6 GHz MIMX8ML6CVNKZAB, 8 GB LPDDR4, 128 GB eMMC 3D TLC Flash, 64 MB SPI NOR Flash, 64 kB EEPROM, RTC, 2x USB 3.0 HOST, 1x USB 3.0 OTG, 2x ETH 10/100/1000, 2x CAN FD, 1x HDMI, 1x DP, 1x Dual LVDS, 2x MIPI CSI, 1x PCIe M.2 + SIM Card, Audio, GPIOs (4x 24V_IN, 4x 24V_OUT, 2x AI_IN), Temperature sensor, Reset-Button, Micro SD Card interface</li>\n</ul>\n</td>\n</tr></tbody></table>",
