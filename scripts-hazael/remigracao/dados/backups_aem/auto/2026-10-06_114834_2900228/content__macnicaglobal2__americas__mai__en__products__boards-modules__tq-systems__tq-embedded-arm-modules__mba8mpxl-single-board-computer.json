     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>i.MX 8M Plus Quad 8 ML/AI</li>\n<li>i.MX 8M Plus Quad 6 Video</li>\n<li>i.MX 8M Plus Quad 4 Lite</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4-SDRAM: Up to 8 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC Flash: Up to 256 GB</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Graphics: 1x Display Port</li>\n<li>1x HDMI LCD Interface: 1x MIPI DSI (4 Lanes); 1x LVDS Interface (4/8 Lanes)</li>\n<li>Camera: 2x MIPI CSI2 (4 Lanes)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Interfaces:<ul>\n<li>2x Analog Input</li>\n<li>4x Digital 24 Output</li>\n<li>4x Digital 24 Input</li>\n</ul>\n</li>\n<li>CAN: 2x CAN FD (galv. Isolated)</li>\n<li>USB: 1x USB 3.0</li>\n<li>Ethernet: Up to 2x Gbit-Ethernet (1x TSN)</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>I2C: Up to 4x I2C</li>\n<li>UART: Up to 4x UART</li>\n<li>SPI: Up to 2x SPI</li>\n<li>M.2: 1x M.2 Key B (SATA)</li>\n<li>Audio: 1x Audio jack for microphone line in/out and headphone</li>\n<li>SD Card: 1x Micro SD-Card</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Audio: SAI/SPDIF</li>\n<li>Dimensions: 160 x 100 mm</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+70°C</li>\n<li>Extended temperature: -40°C…+70°C</li>\n</ul>\n</li>\n<li>Power supply: 18-28 V</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 18:11:59 GMT+0000",
