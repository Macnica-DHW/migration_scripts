    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\r\n<li>Advanced audio properties</li>\r\n<li>Integrated Cortex-M7 for real-time and security</li>\r\n<li>High-speed communication through Gbit Ethernet and USB 2.0</li>\r\n<li>Low power consumption</li>\r\n<li>Versatile CPU variants for different performance needs</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Tue Sep 01 2026 03:01:06 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
