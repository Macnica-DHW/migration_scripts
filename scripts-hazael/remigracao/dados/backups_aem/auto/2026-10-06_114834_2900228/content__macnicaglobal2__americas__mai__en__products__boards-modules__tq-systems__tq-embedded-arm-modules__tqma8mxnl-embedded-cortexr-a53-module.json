     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor:<ul>\n<li>Cortex®-A53 - Up to 1,5GHz</li>\n</ul>\n</li>\n<li>CPU variant:<ul>\n<li>i.MX8M Nano Solo</li>\n<li>i.MX8M Nano Solo Lite</li>\n<li>i.MX8M Nano Dual</li>\n<li>i.MX8M Nano Dual Lite</li>\n<li>i.MX8M Nano Quad</li>\n<li>i.MX8M Nano Quad Lite</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4: Up to 2 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC: Up to 64 GB</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Graphics: LCD Interface: 1x MIPI DSI (4 Lanes)</li>\n<li>Camera: 1x MIPI CSI2 (4 Lanes)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: 1x Ethernet 10/100/1000 Mbit</li>\n<li>Serial Ports: Up to 4x UART</li>\n<li>USB: 1x USB 2.0 high-speed HOST interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>I2C: Up to 4x I2C</li>\n<li>I2S: Up to 12x I²S</li>\n<li>SPI:<ul>\n<li>Up to 3x SPI</li>\n<li>Up to 1x QSPI</li>\n</ul>\n</li>\n<li>Audio:<ul>\n<li>Up to 1x SPDIF</li>\n<li>Up to 8x PDM Mic.</li>\n</ul>\n</li>\n<li>SD Card: Up to 3x SDIO / eMMC</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Temperature sensor</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n<li>Power supply: 5 V</li>\n<li>Plug-in System: LGA (Land Grid Array) 280 pins</li>\n<li>Dimensions: 38 x 38 mm</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 03:06:59 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
