    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Graphics with 4K Support</b>: Ideal for applications demanding high-quality graphics with 4K support and a 3D engine.</li>\n<li><b>2x MIPI-CSI Camera Interfaces</b>: Equipped with two MIPI-CSI interfaces for camera connectivity.</li>\n<li><b>LPDDR4 with ECC Support</b>: Ensures efficient memory management with LPDDR4 and ECC support.</li>\n<li><b>High-Speed Communication</b>: Offers 1x Gbit Ethernet, 2x PCIe, 2x USB 3.0 interfaces, and 2x CAN-FD for data transfer.</li>\n<li><b>Integrated Safety Functions</b>: Enhances security and safety in embedded systems.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 00:59:09 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
