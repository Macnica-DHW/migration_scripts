    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Processor: </b>Utilizes Cortex®-A55 architecture with a single-core i.MX 91x1 CPU for reliable embedded computing performance.</li>\n<li><b>Memory Options:</b> Offers up to 2GB LPDDR4 RAM and versatile storage choices, including up to 256 MB Quad SPI NOR, up to 256 GB eMMC, and optional EEPROM.</li>\n<li><b>Comprehensive Interfaces: </b>Provides an array of communication interfaces, including 2x Gbit Ethernet (with 1x TSN support), 2x USB 2.0, up to 2x CAN FD, and up to 8x I²C, ensuring seamless integration into diverse embedded systems.</li>\n<li><b>Enhanced Security: </b>Incorporates an Advanced Secure Element (SE050) to bolster data security, essential for safeguarding sensitive information in embedded applications.</li>\n<li><b>Compact Design:</b> Features a compact 54mm x 32mm form factor compatible with both standard and extended temperature ranges, making it suitable for demanding industrial environments and a 240-pin 0.5mm pitch connector for easy plug-and-play integration</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 03:20:38 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
