     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:169px;\"><b>TQMa91x1CA-AA</b></td>\n<td><ul>\n<li>TQMa91x1CA-AA, Single Cortex®-A55/1,4 GHz, 8 GB eMMC Flash, 1 GB LPDDR4, 64 kB EEPROM, RTC, -25°C...+85°C</li>\n</ul>\n</td>\n</tr><tr><td width=\"25%\" style=\"width:169px;\"><p><b>STKa91xxCA-AA (Prototypes Q4/2023)</b></p>\n</td>\n<td><ul>\n<li>STKa91xxCA (Eval Kit) with TQMa91x2CA-AA, Single Cortex A55/1,4 GHz, 1 GB LPDDR4, 8 GB eMMC Flash, 64 kB EEPROM, RTC, 2x USB 2.0 HOST, 1x USB Type C, 2x ETH 10/100/1000, 2x CAN FD, 1x RS485, 1x LVDS, 1x MIPI CSI, 1x DP, 1x Mini PCIe + SIM Card (USB only), WLAN, Temperature sensor, Reset-Button, Micro SD Card interface, Power Supply, 8 GB SD card, Cables, Connectors</li>\n</ul>\n</td>\n</tr></tbody></table>",
