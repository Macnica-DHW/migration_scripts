     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Cortex®-A55 - Up to 1,4GHz<ul>\n<li>i.MX 91x1 Single Core</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4: Up to 2 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC: Up to 256 GB</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD interface: 1x 24 Bit RGB</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: Up to 2x Gbit-Ethernet (1x TSN)</li>\n<li>Serial Ports: Up to 2x UART</li>\n<li>CAN: Up to 2x CAN FD</li>\n<li>USB: Up to 2x USB 2.0</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: Up to 3x SDIO / eMMC</li>\n<li>I2C: Up to 8x I²C</li>\n<li>SPI:<ul>\n<li>Up to 8x SPI</li>\n<li>Up to 1x QSPI</li>\n</ul>\n</li>\n<li>I2S: Up to 7x I²S</li>\n<li>Audio:<ul>\n<li>Up to 8x PDM Mic.</li>\n<li>Up to 1x SPDIF</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Dimensions: 54mm x 32mm</li>\n<li>Power supply: 5V</li>\n<li>Plug-in System: 240 pins 0,5 mm Pitch Connector</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C...+85°C</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>Free RTOS</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 03:21:15 GMT+0000",
