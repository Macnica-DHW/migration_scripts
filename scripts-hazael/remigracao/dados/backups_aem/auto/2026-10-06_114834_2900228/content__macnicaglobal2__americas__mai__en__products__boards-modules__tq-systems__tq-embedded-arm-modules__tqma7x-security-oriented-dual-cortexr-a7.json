    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>High-performance graphics with full HD support</li>\n<li>Integrated Cortex M4 for added processing power</li>\n<li>IEEE 1588 hardware support for precision timing</li>\n<li>High-speed communication with 2x Gigabit Ethernet and 1x PCIe interface</li>\n<li>Low power consumption, ensuring energy efficiency</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 03:15:45 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
