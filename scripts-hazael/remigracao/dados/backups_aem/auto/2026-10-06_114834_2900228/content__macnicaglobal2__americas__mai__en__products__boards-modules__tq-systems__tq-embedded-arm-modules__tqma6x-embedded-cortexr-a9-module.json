    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Security functions for data protection.</li>\n<li>IEEE 1588 support for precise timing.</li>\n<li>NOR and e-MMC flash storage options.</li>\n<li>Extended temperature range for versatile usage.</li>\n<li>Low power consumption for energy efficiency.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:45:42 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
