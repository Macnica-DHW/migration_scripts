    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Quad Cortex-A72 LS1046A processor for high-performance computing.</li>\n<li>Versatile connectivity with multiple Ethernet and USB ports.</li>\n<li>DDR4 with optional ECC protection for reliable memory.</li>\n<li>Wide temperature range and voltage monitoring for rugged environments.</li>\n<li>Board-to-board plug-in system with a compact form factor.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 11:02:27 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
