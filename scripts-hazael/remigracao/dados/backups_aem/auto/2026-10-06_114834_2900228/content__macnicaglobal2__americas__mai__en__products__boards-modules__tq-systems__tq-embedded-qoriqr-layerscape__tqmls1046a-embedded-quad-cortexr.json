     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor:<ul>\n<li>Cortex®-A72 - Up to 1,8GHz</li>\n</ul>\n</li>\n<li>CPU variant:<ul>\n<li>LS1046A Quad Core</li>\n<li>LS1026A Dual Core</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR4: DDR4-SDRAM: Up to 8 GB<ul>\n<li>ECC protection (optional)</li>\n</ul>\n</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>Quad SPI NOR: Up to 512 MB</li>\n<li>eMMC: Up to 64 GB</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet:<ul>\n<li>Up to 2x Ethernet 10 Gbit</li>\n<li>Up to 10x Ethernet 10/100/1000 Mbit</li>\n</ul>\n</li>\n<li>Serial Ports: Up to 4x UART</li>\n<li>USB: Up to 3x USB 3.0 high-speed HOST interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: Up to 1x SDIO/MMC</li>\n<li>SPI: Up to 1x SPI</li>\n<li>SATA: Up to 1x SATA 3.0</li>\n<li>PCIe: Up to 3x PCIe 3.0</li>\n<li>I2C: Up to 4x I2C</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Dimensions: 80 mm x 60 mm</li>\n<li>Temperature range: Extended temperature: -40°C…+85°C</li>\n<li>Power supply: 5 V</li>\n<li>General: Temperature sensor</li>\n<li>Voltage Monitoring</li>\n<li>Plug-in System: Board-to-board plug-in system 420 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>VxWorks on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 11:03:28 GMT+0000",
