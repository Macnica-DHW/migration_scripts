     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table height=\"100%\" width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"1\">\r\n<tbody><tr><td width=\"20%\" style=\"width:167px;\"><b><i></i></b><b>ABox-8MPQL-AB</b></td>\r\n<td><ul>\r\n<li>ABox-8MPxL with MBa8MPxL-AB based on TQMa8MPQL-AB, Quad Cortex®-A53/1.6 GHz, 2 GB LPDDR4, 16 GB eMMC Flash, 64 kB EEPROM, RTC, 2x USB 3.0 HOST, 1x USB 3.0 OTG, 2x ETH 10/100/1000, 2x CAN FD, 1x HDMI, 1x DP, 1x Dual LVDS, 2x MIPI CSI, 1x PCIe M.2 + SIM Card, Audio, GPIOs (4x 24V_IN, 4x 24V_OUT, 2x AI_IN)Temperature sensor, Reset-Button, Micro SD</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "jcr:lastModified": "Wed Sep 16 2026 15:12:45 GMT+0000",
