    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>ARM Cortex-A53 technology with multiple CPU variants</li>\n<li>Graphics with HD support and DDR4 with ECC</li>\n<li>Up to 6 Gigabit Ethernet interfaces with TSN support</li>\n<li>Enhanced security with 2 Cortex R5 controllers</li>\n<li>Broad range of communication interfaces</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:35:20 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
