    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Graphics with 4K Support</b>: Ideal for applications requiring high-quality graphics with 4K resolution.</li>\n<li><b>DSP for Audio Processing</b>: Equipped with a DSP for advanced audio capabilities and sound processing.</li>\n<li><b>High-Speed Communication</b>: Provides 2x Gigabit Ethernet, 1x PCIe, and 1x USB 3.0 interfaces for efficient data transfer.</li>\n<li><b>Low Power Consumption</b>: Maintains a low power profile, typically around 4 watts.</li>\n<li><b>Integrated Cortex-M4 CPU</b>: Features an integrated Cortex-M4 CPU for real-time and security applications.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 00:02:20 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
