     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Cortex®-A35 Technology i.MX8 QuadXPlus i.MX8 DualXPlus i.MX8 DualX</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4-SDRAM: Up to 4 GB Quad SPI NOR: Up to 256 MB Up to 64 GB eMMC Flash EEPROM: 0/64 kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>2x LVDS, 1x eDP 1x Camera Sensor Interface (CSI MIPI)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 2x Ethernet 10/100/1000 Mbit (IEEE 1588) Up to 1x USB 3.0 Up to 2.0 OTG Up to 5x USB 2.0 (USB Hub) Up to 2x UART Up to 2x CAN FD</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>Periphery interfaces 1x SDIO/MMC 2x I²C 1x SPI 1x I²S 1x PCIe GPIO</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 3.3 V (optional 3.0 V ... 5.25 V) Ambient conditions Standard temperature range: -25°C…+85°C Extended temperature range: -40°C…+85°C Dimensions 82 mm x 50 mm Plug-in system SMARC 2.0/2.1 Board-to-board plug-in system 314 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>PikeOS</li>\n<li>QNX on request</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 00:03:34 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
