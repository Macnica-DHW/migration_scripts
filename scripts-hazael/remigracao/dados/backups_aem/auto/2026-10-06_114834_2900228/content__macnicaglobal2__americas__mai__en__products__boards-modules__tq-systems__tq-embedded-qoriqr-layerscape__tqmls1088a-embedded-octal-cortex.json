     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\r\n<ul>\r\n<li>Octal Cortex-A53 LS1088A processor for robust performance.</li>\r\n<li>QorIQ Trust Architecture and Arm TrustZone for enhanced security.</li>\r\n<li>Support for IEEE 1588 and QUICC Engine for precise timing.</li>\r\n<li>Low power consumption with high-speed communication interfaces.</li>\r\n<li>Extended temperature range and compact form factor for versatile deployment.</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Wed Sep 16 2026 15:20:16 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
