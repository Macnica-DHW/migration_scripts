    "container_features_c": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\r\n<ul>\r\n<li>Arm® Cortex®-A72 architecture with LS1028A</li>\r\n<li>QorIQ Trust Architecture and Arm® TrustZone® support</li>\r\n<li>IEEE 1588 compatibility</li>\r\n<li>Advanced security functions with QUICC Engine</li>\r\n<li>Extended temperature range for versatility</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Thu Sep 17 2026 19:21:16 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_234986065_": {
     "jcr:primaryType": "nt:unstructured",
