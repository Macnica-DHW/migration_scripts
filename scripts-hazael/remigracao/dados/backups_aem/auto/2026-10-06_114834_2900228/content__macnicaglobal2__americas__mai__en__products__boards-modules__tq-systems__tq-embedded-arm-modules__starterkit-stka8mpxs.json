     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Arm® Cortex® A53 based on i.MX 8M Plus</li>\n<li>Advanced Audio properties with HiFi4 DSP</li>\n<li>Machine Learning Accelerator 2.3 TOPS</li>\n<li>Integrated Cortex®-M7</li>\n<li>High-speed communication via 2x - Gbit Ethernet (1x TSN), 1x PCle and 2x USB 3.0 interface</li>\n<li>Low power consumption (typ. 4 W)</li>\n<li>Integrated security functions</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:50:22 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
