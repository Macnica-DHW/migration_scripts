     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:158px;\"><b>STKa8MPxS-AA</b></td>\n<td>STKa8MPxS (Eval Kit) with TQMa8MPxS-AA, Quad Cortex® A53/1,6 GHz 2 GB LPDDR4, 16 GB eMMC Flash, 64 kB EEPROM, RTC, 3x RS232, 2 x CAN FD separated, 1x USB 3.0 OTG, 1x USB 3.0 HOST, 1x USB 2.0 HOST, 2x ETH 10/100/1000, 1x Display Port, 1x HDMI, 1x Dual LVDS, 1x PCIe, Audio, RTC, Temperature sensor, Reset-Button, SD interface, Power Supply, 4 GB SD card, Cables, Passive cooling</td>\n</tr></tbody></table>",
