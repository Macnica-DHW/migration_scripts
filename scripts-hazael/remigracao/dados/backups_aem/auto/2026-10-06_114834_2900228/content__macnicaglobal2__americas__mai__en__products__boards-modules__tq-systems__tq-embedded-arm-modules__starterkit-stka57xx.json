     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>AM571x</li>\n<li>AM572x&nbsp;</li>\n<li>AM574x</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3L-SDRAM: Up to 4 GB ECC Protection (optional)</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n<li>Up to 32 GB eMMC flash</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD Interface (2x 24-bit RGB), HDMI-Interface</li>\n<li>Camera sensor interface (2x 24b/2x 8b)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 2x Ethernet 10/100/1000 Mbit (IEEE 1588)</li>\n<li>Up to 4x Ethernet 10/100 (PRU)</li>\n<li>Up to 2x CAN 1x USB 2.0 high speed OTG</li>\n<li>Up to 1x USB 3.0 high speed Host</li>\n<li>Up to 10x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>Up to 2x SDIO/MMC</li>\n<li>Up to 3x I²C</li>\n<li>Up to 4x SPI</li>\n<li>Up to 4x I²S</li>\n<li>Up to 1x SATA 3.0</li>\n<li>Up to 2x PCIe</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V</li>\n<li>Ambient conditions<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C…+85°C</li>\n<li>Dimensions 75 mm x 55 mm</li>\n</ul>\n</li>\n<li>Plug-in system Board-to-board plug-in system 400 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>VxWorks on request</li>\n<li>QNX on request</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:29:14 GMT+0000",
