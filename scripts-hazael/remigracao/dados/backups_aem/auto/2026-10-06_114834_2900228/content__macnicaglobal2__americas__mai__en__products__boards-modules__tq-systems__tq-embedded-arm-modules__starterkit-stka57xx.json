    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>High-Definition Graphics</b>: Provides support for high-definition graphics with HD capabilities.</li>\n<li><b>High-Speed Communication:</b> Offers extensive communication options with multiple Ethernet interfaces, PCIe, and USB support.</li>\n<li><b>Low Power Consumption</b>: Maintains low power usage, typically around 4 watts.</li>\n<li><b>Dual Cortex M4</b>: Features 2x Cortex M4 processors for efficient data handling.</li>\n<li><b>IEEE 1588 Hardware Support:</b> Supports IEEE 1588 hardware for precise time synchronization.</li>\n<li>I<b>ntegrated Security Functions:</b> Enhances data protection and security for reliable operations.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:28:26 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
