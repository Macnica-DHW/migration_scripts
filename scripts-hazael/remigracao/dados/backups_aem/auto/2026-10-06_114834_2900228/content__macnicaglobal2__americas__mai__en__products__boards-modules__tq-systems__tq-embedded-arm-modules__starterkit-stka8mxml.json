    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Advanced Audio Properties:</b> Equipped with advanced audio capabilities for high-quality sound processing.</li>\n<li><b>Integrated Cortex-M4:</b> Features an integrated Cortex-M4 processor for versatile data handling.</li>\n<li><b>High-Speed Communication: </b>Offers 1x Gbit Ethernet, 1x PCIe, and 2x USB 2.0 interfaces for efficient data transfer.</li>\n<li><b>Low Power Consumption:</b> Maintains a low power consumption profile, typically around 4 watts.</li>\n<li><b>Integrated Security Functions: </b>Enhances data protection and security for reliable operations.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:53:56 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
