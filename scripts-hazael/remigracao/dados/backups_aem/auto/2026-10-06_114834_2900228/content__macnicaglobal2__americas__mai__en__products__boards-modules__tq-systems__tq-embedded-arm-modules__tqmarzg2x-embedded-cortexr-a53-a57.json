    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\r\n<li>High-performance Cortex-A53/A57 processor</li>\r\n<li>4K graphics support with a quad-core setup</li>\r\n<li>LPDDR4 with ECC support</li>\r\n<li>High-speed communication interfaces</li>\r\n<li>Integrated security functions</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Tue Sep 01 2026 03:07:49 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
