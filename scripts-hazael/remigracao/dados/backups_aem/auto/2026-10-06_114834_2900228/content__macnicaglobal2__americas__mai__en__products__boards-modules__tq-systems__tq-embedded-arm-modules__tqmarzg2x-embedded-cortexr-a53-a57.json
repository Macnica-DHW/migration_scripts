     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td style=\"width:165px;\"><p><b>TQMaRZG2N-AA</b></p>\n</td>\n<td><ul>\n<li>TQMaRZG2N-AA, Dual Cortex®-A57/1.5 GHz, 8 GB eMMC Flash, 2 GB LPDDR4, 64 kB EEPROM, RTC, -25°C...+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:165px;\"><p><b>TQMaRZG2M-AA</b></p>\n</td>\n<td><ul>\n<li>TQMaRZG2M-AA, Quad Cortex®-A53/1.2 GHz + Dual Cortex®-A57/1.5 GHz, 8 GB eMMC Flash, 2 GB LPDDR4, 64 kB EEPROM, RTC, -25°C...+85°</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:165px;\"><p><b>TQMaRZG2H-AA</b></p>\n</td>\n<td><ul>\n<li>TQMaRZG2H-AA, Quad Cortex®--A53/1.2 GHz + Quad Cortex®--A57/1.5 GHz, 8 GB eMMC Flash, 2 GB LPDDR4 (ECC optional), 64 kB EEPROM, RTC, -25°C...+85°</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:165px;\"><p><b>STKaRZG2x-AA</b></p>\n</td>\n<td><ul>\n<li>STKaRZG2x (Eval Kit) with TQMaRZG2x-AA, Quad Cortex®-A53/1.2 GHz + 2x Cortex®-A57/1.5 GHz, 2 GB LPDDR4, 8 GB eMMC Flash, 64 kB EEPROM, RTC, 2x CAN separated, 2x USB 3.0 HOST, 2x USB 2.0, 1x ETH 10/100/1000, 1x HDMI, 1x Digital RGB, 1x LVDS, 2x MIPI CSI, 1x Mini PCIe + SIM Card, 1x M.2 SATA/PCIe, Audio, Temperature sensor, Reset-Button, SD Card interface, Power Supply, 4 GB Micro SD Card, Cables</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 03:13:30 GMT+0000",
