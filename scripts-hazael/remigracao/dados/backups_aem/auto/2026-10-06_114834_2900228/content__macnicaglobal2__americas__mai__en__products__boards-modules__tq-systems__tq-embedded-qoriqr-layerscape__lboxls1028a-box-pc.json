      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>High-speed 4-port TSN Gigabit Ethernet switch</li>\n<li>Graphics with 3D GPU and 4K support</li>\n<li>Wide temperature range</li>\n<li>Low power consumption</li>\n<li>Modular and customizable design</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 10:29:56 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
