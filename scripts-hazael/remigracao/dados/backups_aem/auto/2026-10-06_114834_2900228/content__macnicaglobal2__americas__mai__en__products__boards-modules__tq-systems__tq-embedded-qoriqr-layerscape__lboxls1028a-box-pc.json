     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Layerscape LS1028A</li>\n<li>Layerscape LS1018A</li>\n<li>Layerscape LS1027A</li>\n<li>Layerscape LS1017A</li>\n<li>CPU JTAG interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR4: DDR4-SDRAM: Up to 8 GB</li>\n<li>EEPROM: 0/256 kbit</li>\n<li>Quad SPI NOR: Up to 512 MB</li>\n<li>eMMC: Up to 64 GB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>eDP/DP Phy</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet:<ul>\n<li>1x 4 Port TSN Ethernet Switch up to 1 Gbit</li>\n<li>1x TSN Ethernet 1 Gbit</li>\n<li>1x Ethernet 1 Gbit</li>\n</ul>\n</li>\n<li>SATA: 1x SATA 3.0 (M.2)</li>\n<li>CAN: 2x CAN</li>\n<li>USB:<ul>\n<li>1x USB 3.0</li>\n<li>1x USB 3.0 OTG</li>\n<li>USB-Debug (RS232)</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>PCIe: 1x SIM Card (mini PCIe)</li>\n<li>SD Card:<ul>\n<li>1x Micro SD card socket</li>\n<li>1x SDIO/MMC</li>\n</ul>\n</li>\n<li>SPI: Up to 2x SPI</li>\n<li>I2C: Up to 1x I2C</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply: 16 - 28 V DC</li>\n<li>Temperature sensor</li>\n<li>Temperature range: Extended temperature: -40°C…+70°C</li>\n<li>Dimensions: 170 x 103 x 35 mm</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 10:38:12 GMT+0000",
