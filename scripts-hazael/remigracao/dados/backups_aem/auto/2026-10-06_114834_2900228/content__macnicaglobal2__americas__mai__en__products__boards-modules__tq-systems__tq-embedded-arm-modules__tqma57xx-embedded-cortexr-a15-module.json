    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>High-performance graphics with HD support</li>\n<li>Versatile high-speed communication interfaces, including GbE, real-time Ethernet, PCIe, and USB</li>\n<li>Low power consumption, offering efficiency in operation</li>\n<li>Integrated 2x Cortex M4 for additional processing power</li>\n<li>IEEE 1588 hardware support and robust security functions</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:17:46 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
