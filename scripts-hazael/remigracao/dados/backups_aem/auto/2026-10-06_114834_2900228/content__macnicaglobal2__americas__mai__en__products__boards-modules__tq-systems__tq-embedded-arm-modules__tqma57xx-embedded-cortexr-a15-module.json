     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Cortex®-A15 - Up to 1,5GHz</li>\n<li>CPU variant:<ul>\n<li>AM571x Single Core</li>\n<li>AM572x Dual Core</li>\n<li>AM574x Dual Core</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>EEPROM: 0/64-kbit</li>\n<li>DDR3L: Up to 4 GB<ul>\n<li>ECC protection (optional)</li>\n</ul>\n</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n<li>eMMC: Up to 32 GB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD Interface (24-bit RGB)</li>\n<li>HDMI-Interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>CAN: Up to 2x CAN 2.0 B</li>\n<li>Serial Ports: Up to 10x UART</li>\n<li>USB:<ul>\n<li>1x USB 2.0 high-speed OTG interface</li>\n<li>Up to 1x USB 3.0 high speed Host</li>\n</ul>\n</li>\n<li>Ethernet:<ul>\n<li>Up to 2x Ethernet 10/100/1000 Mbit</li>\n<li>Up to 4x Ethernet 10/100 (PRU)</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SPI: Up to 4x SPI</li>\n<li>I2S: Up to 4x I2S</li>\n<li>SATA: Up to 1x SATA 3.0</li>\n<li>PCIe: Up to 2x PCIe</li>\n<li>I2C: Up to 3x I2C</li>\n<li>SD Card: Up to 2x SDIO/MMC</li>\n<li>MIPI: Camera sensor interface (2x 24b/2x 8b)</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply: 5 V</li>\n<li>Temperature sensor</li>\n<li>Plug-in System: Board-to-board plug-in system 400 pins</li>\n<li>Dimensions: 75 x 55 mm</li>\n<li>Temperature range:</li>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>VxWorks on request</li>\n<li>QNX on request</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:18:33 GMT+0000",
