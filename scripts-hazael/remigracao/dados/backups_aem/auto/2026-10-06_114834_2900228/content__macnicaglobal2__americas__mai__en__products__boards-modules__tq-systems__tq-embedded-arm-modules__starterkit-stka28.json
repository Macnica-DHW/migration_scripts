    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Access to All Functional CPU Pins: </b>Allows engineers to easily access all functional CPU pins on module connectors.</li>\n<li><b>Compact Dimensions: </b>A space-efficient design while offering a well-balanced computing and graphics performance.</li>\n<li><b>IEC 61850 Stack:</b> Supports integration with the IEC 61850 standard for intelligent networks.</li>\n<li><b>Extended Temperature Range: </b>Operates reliably across a wide temperature range, suitable for various environments.</li>\n<li><b>2x IEEE1588 Ethernet:</b> Offers precise time synchronization for time-critical applications with L2 Switch functionality.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:23:45 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
