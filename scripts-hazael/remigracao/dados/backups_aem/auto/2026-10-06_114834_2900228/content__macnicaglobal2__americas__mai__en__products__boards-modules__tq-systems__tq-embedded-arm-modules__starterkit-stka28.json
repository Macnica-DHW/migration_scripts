     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>i.MX287 (450 MHz)</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR2-SDRAM: up to 256 MB</li>\n<li>eMMC flash: up to 16 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>24-bit TFT Interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 2x Ethernet 10/100 Mbit (L2 Switch)</li>\n<li>Up to 2x CAN 2.0 B Up to 5x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>1x USB 2.0 high-speed HOST interface</li>\n<li>1x USB 2.0 high-speed OTG interface</li>\n<li>1x SDIO/MMC</li>\n<li>Up to 2x I2C</li>\n<li>Up to 2x I2S</li>\n<li>Up to 2x SPI</li>\n<li>GPIO</li>\n<li>Up to 8x 12-bit</li>\n<li>ADC channels Up to 8x PWM</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V</li>\n<li>Ambient conditions<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C…+85°C</li>\n</ul>\n</li>\n<li>Plug-in system Board-to-Board plug-in system (160 Pins) 2* 80</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>WCE 6</li>\n<li>VxWorks on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:24:36 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
