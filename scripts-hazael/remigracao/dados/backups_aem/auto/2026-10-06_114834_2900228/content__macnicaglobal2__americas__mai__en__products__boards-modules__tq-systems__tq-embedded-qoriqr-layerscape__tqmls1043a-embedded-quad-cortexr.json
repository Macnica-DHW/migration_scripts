     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:169px;\"><p><b>TQMLS1043A-AA</b></p>\n</td>\n<td><ul>\n<li>LS1043/1 ,0 GHz, 64MB QSPI NOR Flash, 8GB eMMC, 1GB DDR4+ ECC, 64kB EEPROM , RTC, -40°C- +85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>TQMLS1043A-AA</b></p>\n</td>\n<td><ul>\n<li>LS1043/1.0 GHz, 64 MB QSPI NOR Flash, 8 GB eMMC, 2 GB DDR4+ ECC, 64 kB EEPROM, RTC, -40°C...+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>STKLS10xxA-AA</b></p>\n</td>\n<td><ul>\n<li>STKLS10xxA (Eval Kit) mit TQMLS10xx-AA, LS10xxA/ 1,6 GHz, 2GB DDR4, 128MB QSPI NOR Flash, 8GB eMMC, RTC, 64kB EEPROM, 1x RS232, 1x RS485, 1x SATA M.2, 1x CAN 2.0B gtr., 3x USB 2.0 HOST, 1 x USB 3.0 OTG , 10x ETH 10/100/1000, 2x ETH 10 Gigabit, Temperatursensor, 1x PCIe , 2x Mini PCIe (1x SIM Card), Reset-Button, SD-Interface, Power Supply, SD-Card, Accessoires, Cable</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 11:02:02 GMT+0000",
