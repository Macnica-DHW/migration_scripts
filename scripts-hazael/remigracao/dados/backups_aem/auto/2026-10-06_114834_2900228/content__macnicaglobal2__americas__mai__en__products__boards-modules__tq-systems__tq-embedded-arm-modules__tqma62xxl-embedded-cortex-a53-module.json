    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Scalable Cortex A53 Cores</b>: Offers 4/2/1 Cortex A53 cores for adaptable computing performance to meet various application needs.</li>\n<li><b>Dual-Display Support</b>: Provides LVDS and RGB support for dual-display configurations along with an optional 3D GPU for versatile graphics capabilities.</li>\n<li><b>Memory Efficiency</b>: Features LPDDR4 support with ECC, ensuring efficient and reliable memory performance.</li>\n<li><b>Robust Communication:</b> Facilitates high-speed communication through 2x Gbit Ethernet switches with TSN support, 3 x CAN FD, and 2x USB 2.0 interfaces.</li>\n<li><b>Integrated Security</b>: Enhances data protection with integrated security functions, making it suitable for secure industrial applications</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:32:11 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
