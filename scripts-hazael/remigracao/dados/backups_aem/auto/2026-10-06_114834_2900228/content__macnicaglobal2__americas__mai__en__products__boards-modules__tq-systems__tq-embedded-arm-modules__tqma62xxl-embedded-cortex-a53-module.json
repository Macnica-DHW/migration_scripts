     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>AM6254</li>\n<li>AM6252</li>\n<li>AM6251</li>\n<li>AM6234</li>\n<li>AM6232</li>\n<li>AM6231</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>LPDDR4: Up to 2 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC: Up to 64 GB</li>\n<li>NOR Flash: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>1x LVDS (4 lanes)</li>\n<li>1x RGB (24bit)</li>\n<li>3D GPU (8G FLOPFS)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: Up to 2x Gbit-Ethernet (TSN)</li>\n<li>Serial Ports: Up to 9x UART</li>\n<li>CAN: Up to 3x CAN FD</li>\n<li>USB:Up to 2x USB 2.0 interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: Up to 3x SDIO</li>\n<li>I2C: Up to 6x I2C</li>\n<li>SPI: Up to 5x SPI |Up to 1x OSPI</li>\n<li>GPMC: Up to 1x GPMC</li>\n<li>PWM frequency: Up to 3x PWM</li>\n<li>Audio: 3x McASP</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li><p>Power supply: 3,3V</p>\n</li>\n<li><p>Plug-in System: LGA (Land Grid Array) 366 pins</p>\n</li>\n<li><p>Dimensions: 38 x 38 mm</p>\n</li>\n<li><p>Temperature range: Standard temperature range: -25°C…+85°C |Extended temperature: -40°C…+85°C</p>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n</ul>\n</td>\n</tr></tbody></table>",
