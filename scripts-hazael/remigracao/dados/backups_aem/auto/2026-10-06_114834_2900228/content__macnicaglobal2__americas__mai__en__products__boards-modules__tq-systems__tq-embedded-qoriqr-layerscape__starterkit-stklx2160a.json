     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>10G/100G Ethernet support</li>\n<li>High-speed communication via 24x SerDes lanes</li>\n<li>DDR4 memory with ECC support</li>\n<li>100Gb/s Data Compression Engine</li>\n<li>Integrated security functions</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 10:54:34 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_234986065": {
