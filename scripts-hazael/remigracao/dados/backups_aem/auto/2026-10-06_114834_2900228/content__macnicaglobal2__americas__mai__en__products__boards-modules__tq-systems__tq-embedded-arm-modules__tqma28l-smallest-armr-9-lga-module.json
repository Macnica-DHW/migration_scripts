     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table height=\"100%\" width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"1\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor: Single Arm 9 - Up to 450MHz</li>\n<li>CPU variant:<ul>\n<li>i.MX287</li>\n<li>i.MX283</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>eMMC: Up to 16 GB</li>\n<li>DDR2: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Up to 8x 12-bit ADC channels</li>\n<li>24-bit TFT Interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: Up to 2x Ethernet 10/100 Mbit</li>\n<li>USB:<ul>\n<li>1x USB 2.0 high-speed HOST interface</li>\n<li>1x USB 2.0 high-speed OTG interface</li>\n</ul>\n</li>\n<li>Serial Ports: Up to 5x UART</li>\n<li>CAN: Up to 2x CAN 2.0 B</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>I2C: Up to 2x I2C</li>\n<li>I2S: Up to 2x I2</li>\n<li>SPI: Up to 2x SPI</li>\n<li>GPIO: 1x GPIO</li>\n<li>SD Card: 1x SDIO/MMC</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply: 5 V<ul>\n<li>Up to 8x PWM</li>\n</ul>\n</li>\n<li>Dimensions: 31 mm x 31 mm</li>\n<li>Plug-in System: LGA (Land Grid Array) 191 pins</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux, Win CE 6.0, QNX</li>\n<li>VxWorks on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:13:37 GMT+0000",
