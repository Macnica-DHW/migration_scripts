    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Compact and energy-efficient Arm9™ module.</li>\n<li>Low power consumption for energy-efficient operation.</li>\n<li>Wide temperature range for versatile deployment.</li>\n<li>2x IEEE1588 Ethernet support for precise timing.</li>\n<li>Compatibility with various operating systems, including Linux, Win CE 6.0, and QNX.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:11:28 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
