    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Long-term availability for reliable embedded solutions</li>\n<li>Enhanced security functions for data protection</li>\n<li>Camera sensor interface for imaging applications</li>\n<li>Low power consumption, consuming only 1 W typically</li>\n<li>Dual Ethernet support with IEE1588 for network connectivity</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:42:41 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
