     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor:</li>\n<li>Single Cortex®-A7 - Up to 700MHz @ i.MX6UL</li>\n<li>Single Cortex®-A7 - Up to 800MHz @ i.MX6ULL</li>\n<li>CPU variant:</li>\n<li>i.MX6UL1</li>\n<li>i.MX6UL2</li>\n<li>i.MX6UL3</li>\n<li>i.MX6ULL0</li>\n<li>i.MX6ULL1</li>\n<li>i.MX6ULL2</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3L: Up to 1 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC: Up to 32 GB</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>LCD Interface (24-bit RGB)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>CAN: Up to 2x CAN 2.0 B</li>\n<li>USB: Up to 2x USB 2.0 high-speed OTG</li>\n<li>Ethernet: Up to 2x Ethernet 10/100 Mbit</li>\n<li>Serial Ports: Up to 8x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>I2C: Up to 4x I²C</li>\n<li>I2S: Up to 3x I²S</li>\n<li>SPI: Up to 4x SPI</li>\n<li>MIPI: 1x 16-bit Camera Sensor Interface</li>\n<li>SD Card: Up to 2x SDIO/MMC</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Dimensions: 46 x 32 mm</li>\n<li>Temperature sensor</li>\n<li>Power supply: 5 V</li>\n<li>Temperature range:</li>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n<li>Plug-in System: Board-to-board plug-in system 200 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>VxWorks on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:43:26 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
