     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:157px;\"><b>TQMa6UL1-AA</b></td>\n<td><ul>\n<li>i.MX6UL1 (G1) / 528 MHz, 8 GB eMMC Flash 256 MB DDR3L, 64 kB EEPROM, RTC, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><p><b>TQMa6UL2-AA</b></p>\n</td>\n<td><ul>\n<li>i.MX6UL2 (G2) / 528 MHz, 8 GB eMMC Flash 256 MB DDR3L, 64 kB EEPROM, RTC, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><b>TQMa6UL2-AB</b></td>\n<td><ul>\n<li>i.MX6UL2 (G2) / 528MHz,8GB eMMC-Flash, 64MB Q-SPI NOR Flash, 256MB DDR3L-SDRAM, RTC, 64kB EEPROM, -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><b>TQMa6UL3-AA</b></td>\n<td><ul>\n<li>i.MX6UL3 (G3) / 528 MHz, 8 GB eMMC Flash 256 MB DDR3L, 64 kB EEPROM, RTC, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><b>TQMa6ULL2-AA</b></td>\n<td><ul>\n<li>i.MX6ULL2 (Y2) / 528MHz,8GB eMMC-Flash, 256MB DDR3L-SDRAM, RTC, 64kB EEPROM, -25°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><b>TQMa6ULL2-AB</b></td>\n<td><ul>\n<li>i.MX6ULL2 (Y2) / 528MHz,8GB eMMC-Flash, 64MB Q-SPI NOR Flash, 512MB DDR3L-SDRAM, RTC, 64kB EEPROM, -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:157px;\"><b>STKa6ULx-AA</b></td>\n<td><ul>\n<li>STKa6ULx (Eval Kit) with TQMa6ULx-AA, Cortex A7/528 MHz, 256 MB DDR3L, 8 GB eMMC Flash, 64 kB EEPROM, RTC, 1x RS232, 1x RS485, 2 x CAN 2.0 B separated, 3x USB 2.0 HOST, 1x USB 2.0 OTG, 2x ETH 10/100, LCD Port, LVDS, 1x Mini PCIe (only USB), RTC, Temperature sensor, Reset-Button, SD interface, Power supply, 4 GB SD card, Cables</li>\n</ul>\n</td>\n</tr></tbody></table>",
