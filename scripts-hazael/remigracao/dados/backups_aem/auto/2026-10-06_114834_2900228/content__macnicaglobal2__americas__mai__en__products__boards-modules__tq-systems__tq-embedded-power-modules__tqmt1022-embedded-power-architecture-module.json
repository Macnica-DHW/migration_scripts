     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td style=\"width:181px;\"><b>TQMT1022-AA</b></td>\n<td><p>TQ Minimodule with T1022 Dual Core CPU with up to 2x 1400 MHz, no Crypto, 2 GB DDR3 SDRAM, 128 MB NOR flash, 32 KB EEPROM, -40°C - +85°C</p>\n</td>\n</tr><tr><td style=\"width:181px;\"><b>STKT1022-SET-AA</b></td>\n<td><p>Starterkit with TQ Minimodule TQMT1022-AA and baseboard STKT104X, Power Supply, Z-Modem cable, module extractor, heat spreader and documentation</p>\n</td>\n</tr><tr><td style=\"width:181px;\"><b>Baseboard STKT104X</b></td>\n<td><p>The baseboard STKT104X supports all modules of the type series TQMT104x and represents an universal platform for evaluation and development of customer specific platforms for those modules</p>\n</td>\n</tr><tr><td colspan=\"2\" style=\"width:181px;\"><b>Other configurations on request</b></td>\n</tr></tbody></table>",
      "jcr:lastModified": "Fri Aug 28 2026 22:47:02 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
