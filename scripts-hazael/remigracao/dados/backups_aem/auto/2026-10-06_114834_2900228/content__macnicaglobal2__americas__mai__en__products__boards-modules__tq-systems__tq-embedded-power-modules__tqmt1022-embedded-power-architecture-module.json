    "container_features_c": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\r\n<ul>\r\n<li>QorIQ® Dual T1022 Power Architecture®</li>\r\n<li>High-speed communication via 5x Gigabit Ethernet, 4x PCle and two USB 2.0 High-speed interfaces</li>\r\n<li>Dual SATA interfaces for data storage</li>\r\n<li>Quad-core up to 1400 MHz in 28nm SOI for best performance/watt ratio</li>\r\n<li>Display interface Unit</li>\r\n<li>Simple functional expansion via PCle, eSPI, I²C and IFC (Local Bus)</li>\r\n<li>Security functions</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Thu Sep 17 2026 19:16:20 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
