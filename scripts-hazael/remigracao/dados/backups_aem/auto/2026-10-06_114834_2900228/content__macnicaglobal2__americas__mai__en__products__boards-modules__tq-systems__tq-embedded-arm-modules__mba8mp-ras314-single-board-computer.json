    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Arm® Quad-Cortex® A53 on i.MX 8M Plus</li>\n<li>LPDDR4, Quad SPI NOR, eMMC, EEPROM</li>\n<li>Multi-display, HDMI, LVDS, MIPI DSI, MIPI CSI</li>\n<li>Machine Learning Accelerator: 2.3 TOPS</li>\n<li>WIFI, Bluetooth 5.2</li>\n<li>2x Gbit Ethernet (1x TSN)</li>\n<li>4x USB 3.0, 1x USB 3.0 device</li>\n<li>Micro SD card</li>\n<li>Raspberry Pi HAT compatible IO connector</li>\n<li>Integrated security functions</li>\n<li>OS: Armbian, Yocto-Linux, Android on request</li>\n<li>Low Power: Typ 3W, 12 VDC</li>\n<li>Compact: 100mm x 100mm</li>\n<li>Extended Temp available: -40 to 70C</li>\n<li>Long-term availability: 10-15 years</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 17:52:40 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     },
     "text_whitepaper": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p><a href=\"/content/dam/macnicaglobal2/americas/mai/en/images/pdfs/EMB_Whitepaper_MBa8MP-RAS314_EN_Rev0101.pdf\" target=\"_self\" rel=\"noopener noreferrer\">Read the whitepaper for prototype transition, support resources, and more information.</a></p>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_copy_558282354": {
     "jcr:primaryType": "nt:unstructured",
