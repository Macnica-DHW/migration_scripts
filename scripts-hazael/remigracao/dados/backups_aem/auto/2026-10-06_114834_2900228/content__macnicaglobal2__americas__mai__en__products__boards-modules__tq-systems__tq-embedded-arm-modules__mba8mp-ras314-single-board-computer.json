     "title_spec": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Specifications",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "table_spec": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><td><b>CPU</b></td>\r\n<td><ul>\r\n<li>i.MX 8M Plus Quad 8 ML/AI</li>\r\n<li>i.MX 8M Plus Quad 6 Video</li>\r\n<li>i.MX 8M Plus Quad 4 Lite</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Memory</b></td>\r\n<td><ul>\r\n<li>LPDDR4-SDRAM: Up to 8GB</li>\r\n<li>Quad SPI NOR: Up to 256 MB</li>\r\n<li>eMMC Flash: Up to 256 GB</li>\r\n<li>EEPROM: 0/64 kbit</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Graphics</b></td>\r\n<td><ul>\r\n<li>1x HDMI</li>\r\n<li>LCD Interface: 1x MIPI DSI (2 Lanes); 1x LVDS Interface (4 Lanes)</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Communications Interfaces</b></td>\r\n<td><ul>\r\n<li>Bis zu 2x PWM</li>\r\n<li>Bis zu 28x GPIO</li>\r\n<li>2x Gbit-Ethernet (1x TSN)</li>\r\n<li>4x USB 3.0</li>\r\n<li>1x USB 3.0 device</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Other Interfaces</b></td>\r\n<td><ul>\r\n<li>I2C: Up to 2x I2C</li>\r\n<li>UART: Up to 1x UART</li>\r\n<li>SPI: Up to 1x SPI</li>\r\n<li>Audio: 1x Audio jack for microphone and headphone</li>\r\n<li>SD Card: 1x Micro SD-Card</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>General</b></td>\r\n<td><ul>\r\n<li>Dimensions - 100mm x 100mm</li>\r\n<li>Standard temperature range: -25°C…+70°C</li>\r\n<li>Extended temperature: -40°C…+70°C</li>\r\n<li>Power supply&nbsp; - 12v</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>OS</b></td>\r\n<td><ul>\r\n<li>Armbian, Yocto-Linux</li>\r\n<li>Android on request</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true"
     },
     "title": {
