     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" rowspan=\"2\" style=\"width:202px;\"><p><b>MBa8MP-RAS314-AA</b></p>\n</td>\n<td><ul>\n<li>MBa8MP-RAS314-AA with TQMa8MPxL-Ax, Quad CortexR-A53/1.6 GHz, 2 GB LPDDR4, 16 GB eMMC Flash, 64 kB EEPROM, RTC, 4x USB 3.0 HOST, 1x USB 3.0 Device, 2x ETH 10/100/1000, 1x HDMI, 1x LVDS, 1x MIPI, CSI, 1x MIPI DSI, Audio, GPIO PIN Header, WiFi, 2x User LED, Temperature sensor, Reset-Button, Micro SD</li>\n<li>Two Memory sizes (on-board modules):<ul>\n<li>2 GB LPDDR4, 16 GB eMMC Flash (Module: TQMa8MPxL-AB)</li>\n<li>4 GB LPDDR4, 64 GB eMMC Flash (Module: TQMa8MPxL-AB)</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:202px;\">Other configurations upon request</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 17:54:03 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
