    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Real-time Communication Subsystem: </b>Tailored for applications with strict real-time communication requirements.</li>\n<li><b>Low Power Consumption: </b>Energy-efficient, typically consuming around 2 watts.</li>\n<li><b>2x IEEE1588 Ethernet:</b> Offers precise time synchronization for time-critical applications.</li>\n<li><b>Long-term Availability:</b> Ensures consistent project support over time.</li>\n<li><b>High Integration:</b> Integrates numerous interfaces and module functions in the CPU for streamlined baseboard development.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:25:15 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
