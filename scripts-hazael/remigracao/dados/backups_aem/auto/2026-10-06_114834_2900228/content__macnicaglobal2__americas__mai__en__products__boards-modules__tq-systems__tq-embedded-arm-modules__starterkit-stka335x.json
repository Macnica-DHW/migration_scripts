     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>AM3352&nbsp;</li>\n<li>AM3354,</li>\n<li>AM3358,</li>\n<li>AM3359 (Up to 1 GHz)</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3L-SDRAM: up to 512 MB</li>\n<li>eMMC flash: up to 16 GB</li>\n<li>NOR flash: up to 128 MB</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>24-bit TFT Interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Up to 2x Ethernet 10/100/1000 Mbit (L2 Switch)</li>\n<li>Up to 2x CAN 2.0 B</li>\n<li>Up to 6x UART</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>2x USB 2.0 high speed OTG interface</li>\n<li>Up to 2x SDIO/MMC</li>\n<li>Up to 3x I2C</li>\n<li>Up to 2x McASP (4ch)</li>\n<li>Up to 2x SPI GPIO</li>\n<li>Up to 8x 12-bit ADC channels</li>\n<li>Up to 3x PWM</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 3,3 V</li>\n<li>Ambient conditions</li>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C…+85°C</li>\n<li>Plug-in system Board-to-Board plug-in system (240 Pins) 2* 120</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>WEC2013</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:26:25 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
