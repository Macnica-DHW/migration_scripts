     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor:<ul>\n<li>Cortex®-A53 - Up to 1,2GHz</li>\n</ul>\n</li>\n<li>CPU variant:<ul>\n<li>i.MX8X Dual</li>\n<li>i.MX8X Dual Plus</li>\n<li>i.MX8X Quad Plus</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>eMMC: Up to 64 GB</li>\n<li>LPDDR4: Up to 4 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Dual LVDS Interface</li>\n<li>2x MIPI DSI</li>\n<li>1x MIPI CSI</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: Up to 2x Ethernet 10/100/1000 Mbit</li>\n<li>USB:<ul>\n<li>Up to 1x USB 3.0 OTG interface</li>\n<li>Up to 2x USB 2.0 high-speed OTG</li>\n</ul>\n</li>\n<li>CAN: Up to 3x CAN FD</li>\n<li>Serial Ports:<ul>\n<li>Up to 4x UART</li>\n<li>Up to 2x SPDIF</li>\n<li>Up to 4x ESAI</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SPI: Up to 4x SPI</li>\n<li>GPIO: Up to 32x GPIO</li>\n<li>I2C: Up to 8x I²C</li>\n<li>SD Card: 1x SDIO/MMC</li>\n<li>PCIe: Up to 1x PCIe</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Dimensions: 55 x 44 mm</li>\n<li>Temperature sensor</li>\n<li>Power supply: 3.3 V</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n<li>Plug-in System: Board-to-board plug-in system 280 pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>PikeOS™</li>\n<li>QNX on request</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:07:35 GMT+0000",
