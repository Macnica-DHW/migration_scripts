    },
    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>High-performance ARM Cortex-A35 core</li>\n<li>4K graphics support</li>\n<li>Integrated security functions</li>\n<li>Cortex M4 CPU for real-time and security</li>\n<li>Extensive connectivity, including multiple CAN FD interfaces</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:06:47 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
