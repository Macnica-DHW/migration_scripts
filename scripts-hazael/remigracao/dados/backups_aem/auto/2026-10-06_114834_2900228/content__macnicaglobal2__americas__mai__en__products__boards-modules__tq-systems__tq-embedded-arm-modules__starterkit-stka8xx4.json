    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Graphics with 4K Support:</b> Ideal for high-quality graphics applications with 4K support.</li>\n<li><b>Security Functions</b>: Includes integrated security functions for data protection.</li>\n<li><b>Integrated Cortex-M4 CPU</b>: Features a Cortex-M4 CPU for real-time and security applications.</li>\n<li><b>Low Power Consumption</b>: Maintains low power consumption, typically around 4 watts.</li>\n<li><b>DSP for Audio Processing</b>: Equipped with a DSP for high-quality audio processing.</li>\n<li><b>3x CAN FD</b>: Offers 3x CAN-FD interfaces for versatile connectivity.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 00:00:47 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
