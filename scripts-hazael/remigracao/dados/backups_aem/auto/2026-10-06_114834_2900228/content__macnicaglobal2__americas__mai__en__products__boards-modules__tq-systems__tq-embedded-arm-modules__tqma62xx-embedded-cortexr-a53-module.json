    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Dual-Display Support: </b>It offers dual-display support with options for LVDS and RGB interfaces, enhancing visual output flexibility.</li>\n<li><b>LPDDR4 Memory with ECC:</b> The module supports LPDDR4 memory with Error-Correcting Code (ECC), ensuring reliable and efficient memory operations.</li>\n<li><b>High-Speed Communication Interfaces:</b> With 2x Gbit Ethernet switches (TSN), 3x CAN FD, and 2x USB 2.0 interfaces, this module facilitates high-speed data communication in various industrial applications.</li>\n<li><b>Integrated Security Functions:</b> The module includes integrated security functions, including a Secure Element (SE050) and a Real-Time Clock (RTC), enhancing security and timekeeping capabilities</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:19:16 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
