     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table height=\"100%\" width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"1\">\r\n<tbody><tr><td>CPU</td>\r\n<td><ul>\r\n<li>QorIQ LS1012A</li>\r\n<li>CPU JTAG interface</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>Memory</td>\r\n<td><ul>\r\n<li>DDR3L: Up to 1 GB</li>\r\n<li>EEPROM: 0/64-kbit</li>\r\n<li>Quad SPI NOR: Up to 256 MB</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>Graphics</td>\r\n<td><ul>\r\n<li>Up to 4 independent 4K display outputs</li>\r\n<li>3x DP/DP++ 1.4a with up to 8K / HDMI</li>\r\n<li>1x eDP 1.4b or dual channel LVDS interface</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>Communications Interfaces</td>\r\n<td><ul>\r\n<li>Ethernet:<ul>\r\n<li>1x Ethernet 10/100/1000 Mbit</li>\r\n<li>4x Ethernet 10/100/1000Mbit (Ethernet Switch)</li>\r\n</ul>\r\n</li>\r\n<li>Serial Ports: Up to 1x UART</li>\r\n<li>USB:<ul>\r\n<li>2x USB 3.0</li>\r\n<li>USB-Debug (RS232)</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>Other Interfaces</td>\r\n<td><ul>\r\n<li>SATA: 1x SATA 3.0 (M.2)</li>\r\n<li>PCIe: 2x Mini PCIe (1x only USB, SIM-Card)</li>\r\n<li>GPIO: Up to 5x GPIO</li>\r\n<li>I2C: Up to 1x I2C</li>\r\n<li>SD Card: 1x SD-Card</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>General</td>\r\n<td><ul>\r\n<li>Power supply: 16 - 28 V DC</li>\r\n<li>General: Temperature sensor</li>\r\n<li>Temperature range:<ul>\r\n<li>Standard temperature range: -25°C…+70°C</li>\r\n<li>Extended temperature: -40°C…+70°C</li>\r\n</ul>\r\n</li>\r\n<li>Dimensions: 170 x 103 x 35 mm</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td>OS</td>\r\n<td><ul>\r\n<li>Linux</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "jcr:lastModified": "Thu Sep 17 2026 19:09:40 GMT+0000",
