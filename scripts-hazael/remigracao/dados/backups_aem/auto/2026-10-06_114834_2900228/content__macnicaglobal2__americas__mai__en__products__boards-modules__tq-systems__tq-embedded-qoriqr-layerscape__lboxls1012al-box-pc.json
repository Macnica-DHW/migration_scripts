    "container_features_c": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\r\n<ul>\r\n<li>QorIQ LS1012A processor for high-performance computing.</li>\r\n<li>Ample DDR3L memory and Quad SPI NOR flash for efficient data processing and storage.</li>\r\n<li>Extensive connectivity options, including Ethernet, USB, UART, SATA, and PCIe.</li>\r\n<li>Wide operating temperature range for versatility.</li>\r\n<li>Linux support for robust software capabilities.</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Thu Sep 17 2026 19:08:47 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
