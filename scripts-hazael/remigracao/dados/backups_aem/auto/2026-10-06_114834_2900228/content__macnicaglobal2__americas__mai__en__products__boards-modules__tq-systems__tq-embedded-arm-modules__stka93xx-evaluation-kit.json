    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>Arm Cortex-A55:</b> Powered by NXP's Arm Cortex-A55 processor, this kit delivers enhanced processing performance.</li>\n<li><b>Machine Learning Accelerator:</b> With a machine learning accelerator capable of 0.5 TOPS, it supports advanced AI applications.</li>\n<li><b>Integrated Cortex-M33:</b> Benefit from an integrated Cortex-M33 for added processing capabilities.</li>\n<li><b>High-speed Connectivity: </b>Equipped with 2x Gbit Ethernet (1x TSN) and 2x USB 2.0 interfaces for fast data transfer.</li>\n<li><b>Low Power Consumption:</b> Operating with typical power consumption of just 2W, it ensures energy efficiency.</li>\n<li><b>NXP Hardware Partner:</b> Leveraging NXP's hardware expertise, this kit offers reliability and performance.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:00:53 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
