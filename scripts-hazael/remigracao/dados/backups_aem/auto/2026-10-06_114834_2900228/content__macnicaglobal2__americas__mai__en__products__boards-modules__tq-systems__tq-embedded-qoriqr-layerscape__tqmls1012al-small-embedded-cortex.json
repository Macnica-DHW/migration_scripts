     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table height=\"100%\" width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"1\">\n<tbody><tr><td>CPU</td>\n<td><ul>\n<li>CPU/Processor: Single Cortex®-A53 - Up to 1GHz</li>\n<li>CPU variant: LS1012A</li>\n</ul>\n</td>\n</tr><tr><td>Memory</td>\n<td><ul>\n<li>DDR3L: Up to 1 GB</li>\n<li>Quad SPI NOR: Up to 2x QSPI (NOR Flash)<ul>\n<li>Up to 256 MB</li>\n</ul>\n</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td>Communications Interfaces</td>\n<td><ul>\n<li>Ethernet: Up to 2x Ethernet 10/100/1000 Mbit</li>\n<li>Serial Ports: Up to 2x UART RS232</li>\n<li>USB:<ul>\n<li>1x USB 2.0</li>\n<li>1x USB 3.0</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td>Other Interfaces</td>\n<td><ul>\n<li>I2C: Up to 2x I2C</li>\n<li>SPI: Up to 1x SPI</li>\n<li>I2S: Up to 5x I²S</li>\n<li>SATA: Up to 1x SATA 3.0</li>\n<li>PCIe: Up to 1x PCIe</li>\n<li>SD Card: Up to 2x SDIO/MMC</li>\n</ul>\n</td>\n</tr><tr><td>General</td>\n<td><ul>\n<li>Dimensions: 31 mm x 31 mm</li>\n<li>Temperature sensor</li>\n<li>Plug-in System: LGA (Land Grid Array) 155 Pins</li>\n<li>Power supply: 3.3 V</li>\n<li>Temperature range: Extended temperature: -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td>OS</td>\n<td><ul>\n<li>Linux</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Wed Aug 26 2026 20:56:21 GMT+0000",
