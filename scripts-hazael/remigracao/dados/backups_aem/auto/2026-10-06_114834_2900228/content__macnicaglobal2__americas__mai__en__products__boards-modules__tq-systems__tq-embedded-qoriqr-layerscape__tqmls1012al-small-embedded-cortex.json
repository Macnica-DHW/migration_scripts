    "container_features_c": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\r\n<ul>\r\n<li>Single Cortex-A53 LS1012A processor with up to 1GHz clock speed.</li>\r\n<li>1GB DDR3L memory for efficient data handling.</li>\r\n<li>Versatile communication interfaces, including Ethernet, USB, UART RS232, and more.</li>\r\n<li>Extended temperature range for rugged applications.</li>\r\n<li>Compact LGA form factor with a temperature sensor.</li>\r\n</ul>\r\n",
      "jcr:lastModified": "Thu Sep 17 2026 19:26:32 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
