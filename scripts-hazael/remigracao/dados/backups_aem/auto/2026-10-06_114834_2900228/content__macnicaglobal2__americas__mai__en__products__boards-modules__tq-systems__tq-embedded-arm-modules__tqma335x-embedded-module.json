    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Real-time communication subsystem for precise timing.</li>\n<li>Low power consumption, optimizing energy efficiency.</li>\n<li>Dual IEEE1588 Ethernet for reliable connectivity.</li>\n<li>Long-term availability for dependable solutions.</li>\n<li>Versatile communication interfaces and functions for simplified development.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:13:58 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
