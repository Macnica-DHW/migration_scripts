     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Single Cortex®-A8 - Up to 1GHz</li>\n<li>CPU variant:<ul>\n<li>AM3352</li>\n<li>AM3354</li>\n<li>AM3358</li>\n<li>AM3359</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>eMMC: Up to 16 GB</li>\n<li>DDR3L: Up to 512 MB</li>\n<li>NOR Flash: Up to 128 MB</li>\n<li>EEPROM: 0/64-kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>24-bit TFT Interface</li>\n<li>Up to 8x 12-bit ADC channels</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>CAN: Up to 2x CAN 2.0 B</li>\n<li>USB: 2x USB 2.0 high-speed OTG interface</li>\n<li>Serial Ports: Up to 6x UART</li>\n<li>Ethernet: Up to 2x Ethernet 10/100/1000 Mbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>GPIO: 1x GPIO</li>\n<li>I2C: Up to 3x I2C</li>\n<li>SPI: Up to 2x SPI</li>\n<li>SD Card: Up to 2x SDIO/MMC</li>\n<li>Audio: Up to 2x McASP (4ch)</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply: 3.3 V</li>\n<li>Up to 3x PWM</li>\n<li>Temperature sensor</li>\n<li>Plug-in System: Board-to-board plug-in system 240 pins</li>\n<li>Dimensions: 54 x 38 mm</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>Windows Embedded Compact 2013</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:14:32 GMT+0000",
