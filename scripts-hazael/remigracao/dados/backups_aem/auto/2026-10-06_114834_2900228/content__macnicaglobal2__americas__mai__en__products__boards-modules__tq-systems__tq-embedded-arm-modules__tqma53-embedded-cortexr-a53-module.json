    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Comprehensive CPU pin connectivity.</li>\n<li>Support for IEEE 1588 for precise timing.</li>\n<li>Versatile security functions.</li>\n<li>High-resolution graphics capabilities.</li>\n<li>Support for multiple communication interfaces.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 01:16:21 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
