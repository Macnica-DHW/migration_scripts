     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>Cortex®-A8 Technology</li>\n<li>MCIMX537 / MCIMX535</li>\n<li>CPU JTAG interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3: DDR3-SDRAM: up to 1 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>eMMC: Up to 16 GB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Analog VGA</li>\n<li>Parallel 1x24 bit (RGB) UXGA</li>\n<li>Dual LVDS UXGA</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet:<ul>\n<li>1x Ethernet 10/100 Mbit (IEEE 1588)</li>\n<li>1x WEIM</li>\n</ul>\n</li>\n<li>SATA: 1x SATA</li>\n<li>USB:<ul>\n<li>2x USB 2.0 high-speed HOST interface</li>\n<li>2x USB 2.0 high-speed OTG interface</li>\n</ul>\n</li>\n<li>Serial Ports:<ul>\n<li>Up to 5x UART</li>\n<li>1x ESAI</li>\n<li>SPDIF</li>\n</ul>\n</li>\n<li>CAN: 2x FlexCAN</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: Up to 3x SDIO/MMC</li>\n<li>I2C: Up to 2x I2C</li>\n<li>SPI: up to 3x CSPI</li>\n<li>I2S: Up to 3x SSI/I2S</li>\n<li>MIPI: 1x 16 bit Camera I/F</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Dimensions: 55 x 44 mm</li>\n<li>Plug-in System: Board-to-board plug-in system 240 pins</li>\n<li>Temperature range:<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature: -40°C…+85°C</li>\n</ul>\n</li>\n<li>Power supply: 5 V</li>\n<li>Temperature sensor</li>\n<li>Supervisor 5 V</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>Android on request</li>\n<li>Windows Embedded Compact 2013 on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 01:17:21 GMT+0000",
