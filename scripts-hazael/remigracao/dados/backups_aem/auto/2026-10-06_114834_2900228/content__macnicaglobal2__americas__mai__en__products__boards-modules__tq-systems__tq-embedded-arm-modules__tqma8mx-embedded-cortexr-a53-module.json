     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>CPU/Processor:<ul>\n<li>Cortex®-A53 - Up to 1,5GHz</li>\n</ul>\n</li>\n<li>CPU variant:<ul>\n<li>i.MX8M Dual</li>\n<li>i.MX8M Quad Lite</li>\n<li>i.MX8M Quad</li>\n</ul>\n</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>eMMC Flash: Up to 64 GB</li>\n<li>EEPROM: 0/64-kbit</li>\n<li>Quad SPI NOR: Up to 256 MB</li>\n<li>LPDDR4-SDRAM: Up to 4 GB</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>1x HDMI</li>\n<li>DSI Display (MIPI DSI 4 lane)</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>Ethernet: 1x Ethernet 10/100/1000 Mbit</li>\n<li>Serial Ports: Up to 4x UART</li>\n<li>USB:</li>\n<li>Up to 1x USB 3.0 OTG interface</li>\n<li>Up to 1x USB 2.0 OTG interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>SD Card: 1x SDIO/MMC</li>\n<li>I2C: Up to 4x I²C</li>\n<li>SPI:<ul>\n<li>Up to 3x SPI</li>\n<li>Up to 2x QSPI</li>\n</ul>\n</li>\n<li>MIPI: 2x MIPI CSI</li>\n<li>GPIO: 1x GPIO</li>\n<li>PCIe: Up to 2x PCIe</li>\n<li>I2S: Up to 6x I2S</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Temperature sensor</li>\n<li>Plug-in System: Board-to-board plug-in system 340 pins</li>\n<li>Dimensions: 55 x 36 mm</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>Android</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 03:18:17 GMT+0000",
