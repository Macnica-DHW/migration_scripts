    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Cortex-A53 processor with enhanced audio and video functions</li>\n<li>4K graphics support with VP9/4K HDR10</li>\n<li>Integrated Cortex-M4 CPU for real-time and security</li>\n<li>Low power consumption</li>\n<li>Multiple high-speed communication interfaces</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 03:17:08 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
