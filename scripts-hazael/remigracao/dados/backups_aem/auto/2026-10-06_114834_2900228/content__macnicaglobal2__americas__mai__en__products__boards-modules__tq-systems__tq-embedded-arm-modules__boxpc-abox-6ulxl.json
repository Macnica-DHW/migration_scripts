     "title_spec": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Specifications",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "table_spec": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><td><b>CPU</b></td>\r\n<td><ul>\r\n<li>MX6UL2, MX6UL3, MX6ULL2</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Memory</b></td>\r\n<td><ul>\r\n<li>EEPROM: 0/64-kbit</li>\r\n<li>Quad SPI NOR: Up to 256 MB</li>\r\n<li>DDR3L: Up to 1 GB</li>\r\n<li>eMMC: Up to 32 GB</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Graphics</b></td>\r\n<td><ul>\r\n<li>Up to 4 independent 4K display outputs</li>\r\n<li>3x DP/DP++ 1.4a with up to 8K / HDMI</li>\r\n<li>1x eDP 1.4b or dual channel LVDS interface</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Communications Interfaces</b></td>\r\n<td><ul>\r\n<li>Ethernet: 2x Ethernet 10/100/Mbit</li>\r\n<li>Serial Ports: Up to 2x UART RS232</li>\r\n<li>CAN: Up to 2x CAN 2.0 B</li>\r\n<li>USB:<ul>\r\n<li>1x USB 2.0 high-speed OTG interface</li>\r\n<li>2x USB 2.0 high-speed HOST interface</li>\r\n</ul>\r\n</li>\r\n<li>USB-Debug (RS232)</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Other Interfaces</b></td>\r\n<td><ul>\r\n<li>GPIO: Up to 8x GPIO</li>\r\n<li>I2C: Up to 1x I2C</li>\r\n<li>PCIe:<ul>\r\n<li>Up to 1x SIM Card (mini PCIe)</li>\r\n<li>Up to 2x Mini PCIe</li>\r\n</ul>\r\n</li>\r\n<li>SD Card: Up to 1x SD-Card</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>General</b></td>\r\n<td><ul>\r\n<li>Dimensions: 110 x 103 x 35mm</li>\r\n<li>Temperature sensor</li>\r\n<li>Power supply: 8 - 30 V DC</li>\r\n<li>Temperature range:<ul>\r\n<li>Standard temperature range: -25°C…+70°C</li>\r\n<li>Extended temperature: -40°C…+70°C</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>OS</b></td>\r\n<td><ul>\r\n<li>Linux</li>\r\n<li>QNX, INTEGRETY on request</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true"
     },
