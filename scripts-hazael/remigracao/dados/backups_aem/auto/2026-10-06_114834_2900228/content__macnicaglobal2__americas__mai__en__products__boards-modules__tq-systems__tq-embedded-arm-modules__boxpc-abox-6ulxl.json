    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Extended temperature range for challenging environments.</li>\n<li>Low power consumption for energy-efficient operation.</li>\n<li>Modular expandability to adapt to specific needs.</li>\n<li>Wide voltage input range for flexibility.</li>\n<li>Galvanically isolated 2x CAN and 2x Ethernet interfaces.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 17:32:41 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
