     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:160px;\"><b>ABox-6UL2L-AA</b></td>\n<td><ul>\n<li>ABox-6UL2, MBa6UL2L-AA, TQMa6UL2L-AA Cortex®-A7/528 MHz, 8 GB eMMC Flash, 256 MB DDR3L, 64kB EEPROM, Temperature sensor, RTC, Interfaces: 2x USB 2.0, 1x USB OTG, 2x ETH 10/100, 1x CAN, USB-Debug Interface, Reset-Button, Internal Interfaces: 1x Mini PCIe (only USB + SIM Card) SD-Card interface, -25°C…+70°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:160px;\"><p><b>ABox-6UL2L-AB</b></p>\n</td>\n<td><ul>\n<li>ABox-6UL2, MBa6UL2L-AA, TQMa6UL2L-AA Cortex®-A7/528 MHz, 8 GB eMMC Flash, 256 MB DDR3L, 64kB EEPROM, Temperature sensor, RTC, Interfaces: 2x USB 2.0, 1x USB OTG, 2x ETH 10/100, 2x CAN, USB-Debug Interface, Reset-Button, Internal Interfaces: 2x Mini PCIe (only USB + SIM Card), Expansion Interface 2,54 mm Pin Header (8x GPIO´s, 2x RS232 (RX/TX), 2x I²C, 1x SPI), Graphics (18-bit), SD-Card interface, -25°C…+70°C</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 17:43:20 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
