     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td style=\"width:169px;\"><b>TQMLX2160A-AA</b></td>\n<td><ul>\n<li>TQMLX2160A-AA, 16 Cortex®-A72/2.2 GHz, 8 GB eMMC Flash, 128 MB QSPI NOR, 32 GB DDR4, + ECC, 64 kB EEPROM, RTC, -40°C...+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>TQMLX2120A-AA</b></p>\n</td>\n<td><ul>\n<li>TQMLX2120A-AA, 12 Cortex®-A72/2.2 GHz, 8 GB eMMC Flash, 128 MB QSPI NOR, 32 GB DDR4, + ECC, 64 kB EEPROM, RTC, -40°C...+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>TQMLX2080A-AA</b></p>\n</td>\n<td><ul>\n<li>TQMLX2080A-AA, 8 Cortex®-A72/2.2 GHz, 8 GB eMMC Flash, 128 MB QSPI NOR, 32 GB DDR4, + ECC, 64 kB EEPROM, RTC, -40°C...+85°C, Other configurations on request</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>STKLX2160A-AA</b></p>\n</td>\n<td><ul>\n<li>STKLX2160A (Eval Kit) with TQMLX2160A-AA, 16x Cortex®-A72/2.2 GHz, 32 GB DDR4, + ECC, 8 GB eMMC Flash, 64 kB EEPROM, RTC, 2x CAN FD separated, 2x USB 3.0 HOST, 10x ETH 10/100/1000, 2x 10 Gbit Ethernet, 1x 100 Gbit Ethernet, 2x PCIe Gen4 (x4), 1x Mini PCIe + SIM Card, 1x M.2 SATA, 1x SATA 2.5”, 1x SD-Card, Temperature sensor, Reset-Button, Power Supply, 8 GB SD Card, Cables, Heatspreader, Heatsink</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 11:07:57 GMT+0000",
