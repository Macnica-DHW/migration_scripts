    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>10G/100G Ethernet for high-speed networking</li>\n<li>24x SerDes lanes for versatile data communication</li>\n<li>DDR4 with ECC support</li>\n<li>100Gb/s Data Compression Engine for efficient data handling</li>\n<li>Multiple connectivity interfaces, including USB 3.0 and PCIe Gen4</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 11:06:40 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
