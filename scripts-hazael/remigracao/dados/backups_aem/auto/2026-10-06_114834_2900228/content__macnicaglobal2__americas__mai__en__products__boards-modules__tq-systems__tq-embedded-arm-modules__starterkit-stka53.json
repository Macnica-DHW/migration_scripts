     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td><b>CPU</b></td>\n<td><ul>\n<li>MCIMX537 / MCIMX535</li>\n</ul>\n</td>\n</tr><tr><td><b>Memory</b></td>\n<td><ul>\n<li>DDR3-SDRAM: up to 1 GB</li>\n<li>e-MMC: up to 16 GB</li>\n<li>EEPROM: 0 / 64 kbit</li>\n</ul>\n</td>\n</tr><tr><td><b>Graphics</b></td>\n<td><ul>\n<li>Analog VGA</li>\n<li>Parallel 1x 24 bit (RGB) UXGA*</li>\n<li>Dual LVDS UXGA</li>\n</ul>\n</td>\n</tr><tr><td><b>Communications Interfaces</b></td>\n<td><ul>\n<li>1x Ethernet 10/100 Mbit (IEEE 1588)</li>\n<li>2x FlexCAN</li>\n<li>Up to 5x UART</li>\n<li>2x USB 2.0 high speed HOST interface</li>\n<li>1x USB 2.0 high speed OTG interface</li>\n</ul>\n</td>\n</tr><tr><td><b>Other Interfaces</b></td>\n<td><ul>\n<li>WEIM Bus*</li>\n<li>Up to 3x SDIO/MMC</li>\n<li>Up to 2x I²C</li>\n<li>Up to 3x CSPI</li>\n<li>Up to 3x SSI/I²S</li>\n<li>ESAI</li>\n<li>1x 16 bit Camera I/F</li>\n<li>SATA</li>\n<li>SPDIF</li>\n</ul>\n</td>\n</tr><tr><td><b>General</b></td>\n<td><ul>\n<li>Power supply 5 V</li>\n<li>Ambient conditions<ul>\n<li>Standard temperature range: -25°C…+85°C</li>\n<li>Extended temperature range: -40°C…+85°C</li>\n<li>Dimensions 55 mm x 44 mm</li>\n</ul>\n</li>\n<li>Plug-in system Board-to-board plug-in system 240 Pins</li>\n</ul>\n</td>\n</tr><tr><td><b>OS</b></td>\n<td><ul>\n<li>Linux</li>\n<li>QNX</li>\n<li>WEC 7</li>\n<li>Android on request</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Mon Aug 31 2026 23:27:45 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
