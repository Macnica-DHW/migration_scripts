    "container_features": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": "1717498053499",
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li><b>All Functional CPU Pins Lead Out:</b> This kit allows easy access to all functional CPU pins via module connectors.</li>\n<li><b>IEEE 1588 Support:</b> It provides support for IEEE 1588, facilitating precise time synchronization.</li>\n<li><b>Low Power Consumption:</b> Maintains a low power profile, typically consuming around 3 watts.</li>\n<li><b>Security Functions:</b> Offers integrated security functions to enhance data protection.</li>\n<li><b>e-MMC Flash Storage:</b> Features e-MMC Flash storage for efficient data handling.</li>\n</ul>",
      "jcr:lastModified": "Mon Aug 31 2026 23:26:57 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
