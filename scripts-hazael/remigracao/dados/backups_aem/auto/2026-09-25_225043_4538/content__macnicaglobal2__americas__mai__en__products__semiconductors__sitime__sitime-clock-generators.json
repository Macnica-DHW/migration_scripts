     "container_4": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Chorus™",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "title_2": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Low-noise, application-tuned programmable clocks",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>SiT95210 / SiT95211:</b>&nbsp;Low jitter MEMS clock generators</li>\n</ul>\n<ul>\n<li><b>SiT95314:&nbsp;</b>Dual-PLL with output skew control (good fit for Chorus-type deployment)</li>\n</ul>\n<ul>\n<li><b>SiT5801:&nbsp;</b>Also featured in low-noise applications as a jitter cleaner for 5G and PCIe Gen6</li>\n</ul>\n<ul>\n<li><b>SiT5376 / SiT5377:</b>&nbsp;Used in conjunction with Chorus-type architectures for SerDes applications</li>\n</ul>\n<ul>\n<li><b>Use Cases:&nbsp;</b>Optical modules, 100/400/800GbE links, SerDes reference clocks, PCIe Gen 4/5/6 signal integrity</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
