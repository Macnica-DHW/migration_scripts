       "flexcontaineritem_1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Key Capabilities",
         "id": "sitimebufferproductlineup",
         "type": "h2",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li>Multiple outputs (up to 12)</li>\n<li>Up to 1 GHz frequency synthesis</li>\n<li>Sub-100 fs jitter performance</li>\n<li>Programmable rise/fall times</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Applications",
         "type": "h2",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li>FPGA clock trees</li>\n<li>Automotive Ethernet</li>\n<li>5G base stations</li>\n<li>PCIe</li>\n<li>SerDes</li>\n<li>High-speed storage</li>\n</ul>",
