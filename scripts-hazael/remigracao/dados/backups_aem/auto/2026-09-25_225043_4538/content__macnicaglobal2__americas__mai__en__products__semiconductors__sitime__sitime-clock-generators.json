      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Atna™",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "title_2": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Compact, cost-effective solutions for networking and industrial",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>SiT9501:&nbsp;</b>Compact, differential output MEMS clock generator</li>\n</ul>\n<ul>\n<li><b>SiT91281 / SiT91283 / SiT91285 / SiT91288:</b>&nbsp;Automotive-grade, low-output count clock generators</li>\n</ul>\n<ul>\n<li><b>SiT30100:</b>&nbsp;Small-footprint clock generator with integrated resonator and temp sensor (ideal for handheld and mobile)</li>\n</ul>\n<ul>\n<li><b>Use Cases:&nbsp;</b>Industrial automation, embedded compute, networking cards, mobile/consumer electronics</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
