      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Cascade™",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "title_2": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Industry’s most versatile MEMS clock generator",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>SiT95141:</b>&nbsp;Quad PLL, 10-output MEMS clock generator</li>\n</ul>\n<ul>\n<li><b>SiT95145 / SiT95148:</b>&nbsp;10-output programmable jitter cleaner + generator</li>\n</ul>\n<ul>\n<li><b>SiT95312 / SiT95315 / SiT95316 / SiT95317:</b>&nbsp;Advanced Cascade II MEMS clock generators with differential outputs and jitter cleaning</li>\n</ul>\n<ul>\n<li><b>SiT95147:</b>&nbsp;Network-synchronized version of Cascade (with integrated holdover and IEEE 1588 support)</li>\n</ul>\n<ul>\n<li><b>Use Cases:&nbsp;</b>Data center switching, telecom base stations, FPGA/SoC clock trees, timing-sensitive Ethernet &amp; PCIe applications</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_3": {
      "jcr:primaryType": "nt:unstructured",
