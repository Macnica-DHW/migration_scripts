      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p style=\"text-align: justify;\">From full service high-volume complex supply chain engagements to tailored solutions for small and medium-sized enterprises, Macnica serves a diverse range of customers. Our expertise extends to:</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
