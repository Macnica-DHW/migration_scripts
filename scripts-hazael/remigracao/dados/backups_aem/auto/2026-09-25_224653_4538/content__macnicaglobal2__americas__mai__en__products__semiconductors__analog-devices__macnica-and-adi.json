        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p><b style=\"color: rgb(122,33,128);\">Telecommunications and Networking Companies:</b></p>\n<p style=\"margin-top:0\">We deliver cutting-edge hardware and software solutions for next-generation systems.​</p>",
