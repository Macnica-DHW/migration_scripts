        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p><b style=\"color: rgb(122,33,128);\">Industrial and Automotive <br>\n Manufacturers:</b></p>\n<p style=\"margin-top:0\">We supply specialized components required for demanding applications.​</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_2": {
        "jcr:primaryType": "nt:unstructured",
