       "flexcontaineritem_1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p><b style=\"color: rgb(122,33,128);\">Global OEMs: ​</b></p>\n<p style=\"margin-top:0;text-align: left;\">We support multi-regional purchasing and supply chain optimization for large-scale operations​.</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p><b style=\"color: rgb(122,33,128);\">EMS Providers and CMs: ​</b></p>\n<p style=\"margin-top:0\">We offer component sourcing, inventory management, and technical know-how.​&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p><b style=\"color: rgb(122,33,128);\">Small and Medium-sized Companies:</b></p>\n<p style=\"margin-top:0\">We provide scalable solutions and flexible finance options to support growth.</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       }
