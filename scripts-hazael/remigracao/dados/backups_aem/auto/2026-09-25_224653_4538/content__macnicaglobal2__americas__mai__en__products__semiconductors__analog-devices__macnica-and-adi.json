      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Macnica and Analog Devices",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p style=\"text-align: justify;\">Our strong collaboration with Analog Devices allows us to deliver customized supply chain and technology support tailored to various industry needs.</p>\n<ul>\n<li style=\"text-align: justify;\"><b style=\"color: rgb(122,33,128);\">Authorized ADI Distributor</b>: As one of ADI's primary volume distributors, Macnica offers a wide range of ADI products, including those from Maxim Integrated and Linear Technology.​</li>\n<li style=\"text-align: justify;\"><b style=\"color: rgb(122,33,128);\">Supply Chain Excellence</b>: We utilize advanced warehouse management systems and logistics expertise to ensure effective inventory management, quality assurance, and supply chain optimization.​</li>\n<li style=\"text-align: justify;\"><b style=\"color: rgb(122,33,128);\">Technical Expertise</b>: Macnica provides comprehensive technical support, assisting customers with product integration, application development, and specialized topics such as LTspice®&nbsp;and power supply circuit design.</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
