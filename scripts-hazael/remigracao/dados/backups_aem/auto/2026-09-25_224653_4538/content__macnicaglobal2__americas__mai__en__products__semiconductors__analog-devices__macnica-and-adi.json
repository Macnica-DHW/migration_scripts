         "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"0\" width=\"100%\" height=\"100%\">\n<tbody><tr><td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td>&nbsp;</td>\n<td style=\"text-align: center;\"><p><img src=\"/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/analog-devices/images/streamlined-inventory-management-black.png\" alt=\"\"></p>\n</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td colspan=\"7\"><p style=\"text-align: center;\"><b>Streamlined Inventory Management​</b><br>\nOur tailored programs, like just-in-time delivery, align with your schedules and ensure 99.9% on-time delivery while reducing costs.</p>\n</td>\n</tr></tbody></table>",
