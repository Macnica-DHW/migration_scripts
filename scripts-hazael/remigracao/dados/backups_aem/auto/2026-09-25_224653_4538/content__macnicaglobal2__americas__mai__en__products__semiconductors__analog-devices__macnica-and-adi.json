      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "About Macnica Americas​",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><b>Parent Company</b>: North American division of Macnica Fuji Electronics Holdings, Inc.​</p>\n<p style=\"margin-top:0\"><b>Global Presence</b>: Part of a $10 Billion global leader in technology product distribution​</p>\n<p style=\"margin-top:0\"><b>Americas Headquarters</b>: San Diego​</p>\n<p style=\"margin-top:0\"><b>Additional Offices</b>: San Jose, Dallas, Chicago, and Ottawa ​</p>\n<p style=\"margin-top:0\"><b>Distribution Centers</b>:</p>\n<p style=\"margin-top:0\">- California: ISO9001:2015 certified QMS system<br>\n- McAllen, TX: Third-party logistics (3PL) warehouse with ISO9001:2015 certified QMS system for automotive customers​</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
