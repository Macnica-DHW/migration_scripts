     "title_text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Integrate AI into IoT applications. It’s not that difficult",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title",
      "cq:styleIds": [
       "",
       "",
       "",
       "1718280235888"
