     "textwithimage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/FLEX AIoT Developer Kits.png",
      "imageRatio": "30",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "alt": "IEI FLEX AIoT Developer KIt Gen. II",
      "text": "<p>IEI has a smart platform for those looking to implement smart solutions such as Smart City, Smart Building, Smart Industry, or even Smart Medical systems.</p>\r\n<p>&nbsp;The IEI FLEX AIoT Kit (Gen II) brings industrial strength powerful processing with Intel® Core™ and Xeon™ processors, redundant drives, rich IO, and slots for optional IEI accelerators. It’s all compatible with Altera's OpenVINO toolset, libraries and models so developers get a head start on AI and Deep Learning projects.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "jcr:lastModified": "Mon Oct 05 2026 14:03:58 GMT+0000",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
      "cq:styleIds": [
       "1718154328384",
       "",
       "1783061491236"
      ],
      "spImage": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/FLEX AIoT Developer Kits.png",
       "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
       "jcr:lastModified": "Mon Oct 05 2026 14:03:58 GMT+0000",
       "sling:resourceType": "macnicaglobal2/components/content/image"
      }
     }
    },
    "container_2008508214": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f0f0f0",
     "cq:styleIds": [
      "1717498053499",
      "1717498056876"
     ],
     "textwithimage_copy": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/IEI flex.png",
      "imageRatio": "30",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "alt": "iei flex logo",
      "text": "<ul>\r\n<li>2U AI Modular PC with 10th Generation LGA 1200 Intel® Core™/Xeon® processor with Intel® Q470/W480 chipset and DDR4 memory</li>\r\n<li>Four hot-swappable and accessible HDD drive bays support RAID 0/1/5/10</li>\r\n<li>Support PCIe 3.0 by 4 and PCIe 3.0 by 8 slots</li>\r\n<li>M.2 2280 PCIe 3.0 x4 NVMe™ SSD support</li>\r\n<li>Dual independent display with high-resolution support</li>\r\n<li>TPM data protection and reliable authentication</li>\r\n<li>Support for optional Mustang-V100-MX8 PCIe Accelerator Card for offloading AI/DL workloads</li>\r\n<li>Pre-installed Intel® AC 9260 802.11 AC 2T/2R and Bluetooth V5.1</li>\r\n</ul>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "jcr:lastModified": "Thu Sep 24 2026 13:11:50 GMT+0000",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
      "cq:styleIds": [
       "1718154328384",
