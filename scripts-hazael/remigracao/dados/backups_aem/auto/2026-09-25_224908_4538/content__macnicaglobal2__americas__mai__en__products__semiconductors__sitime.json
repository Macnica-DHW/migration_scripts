      "flexcontaineritem_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "title_1": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:title": "SiTime for FPGA & SoC Designers",
        "type": "h2",
        "sling:resourceType": "macnicaglobal2/components/content/title"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<p>SiTime clock solutions meet the transceiver specs for:</p>\n<ul>\n<li><b>Intel/Altera Agilex 7 &amp; Agilex 5</b></li>\n</ul>\n<ul>\n<li><b>AMD/Xilinx Versal &amp; UltraScale+</b></li>\n</ul>\n<ul>\n<li>Clock generators, jitter attenuators, and TCXOs fully qualified</li>\n</ul>\n<p>Download full reference designs or ask Macnica to help you design your clock tree.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "title_1": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:title": "Tools & Resources",
        "type": "h2",
        "sling:resourceType": "macnicaglobal2/components/content/title"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\n<li><b>Lab Anywhere</b>: Remotely evaluate phase noise &amp; jitter live</li>\n</ul>\n<ul>\n<li><b>Online Parametric Search</b>: Filter by application, spec, or part number</li>\n</ul>\n<ul>\n<li><b>Knowledge Center</b>: Forum, app notes, design calculators</li>\n</ul>\n<ul>\n<li><b>Drop-in Quartz Replacements</b>: Save redesign effort</li>\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
    "container_4": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Work With Our Team",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>Let Macnica Americas help you choose, configure, and implement the ideal SiTime product solution. From registration programs to technical design support, we are your one-stop partner for precision timing solutions success.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
