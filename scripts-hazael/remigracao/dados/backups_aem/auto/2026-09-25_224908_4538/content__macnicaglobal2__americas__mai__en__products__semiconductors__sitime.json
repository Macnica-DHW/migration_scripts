        "embeddableResourceType": "core/wcm/components/embed/v1/embed/embeddable/youtube",
        "type": "embeddable",
        "youtubeVideoId": "VsroyjLZWPM",
        "sling:resourceType": "macnicaglobal2/components/content/embed"
       }
      }
     }
    },
    "container_2": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "",
      "1717498056876"
     ],
     "container_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Why SiTime products?",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>MEMS-based Innovation</b>: Outperforms quartz in shock, vibration, power, and size</li>\n</ul>\n<ul>\n<li><b>Drop-in Compatibility</b>: Footprint-compatible with quartz oscillators and clocks</li>\n</ul>\n<ul>\n<li><b>Extreme Reliability</b>: Up to 2.2 billion hours MTBF and 100,000g shock resistance</li>\n</ul>\n<ul>\n<li><b>Fully Programmable</b>: Flexibility in frequency, stability, voltage, and output types</li>\n</ul>\n<ul>\n<li><b>Resilient Supply Chain</b>: Fabless and geopolitically-diversified</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiTime Product Portfolio",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p>SiTime offers a complete, programmable clock tree:</p><p style=\"margin-top:0\">&nbsp;</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "table_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th>Solution Type</th>\n<th>Key Products</th>\n<th style=\"white-space:nowrap\">Applications</th>\n</tr><tr><td width=\"33%\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-mems-resonator-technology.html\" target=\"_self\" rel=\"noopener noreferrer\">MEMS Resonators</a></td>\n<td width=\"33%\">Elite Platform</td>\n<td width=\"33%\">Next-gen timing for all segments</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-oscillators.html\" target=\"_self\" rel=\"noopener noreferrer\">Oscillators</a></td>\n<td>XO, TCXO, OCXO, 32kHz</td>\n<td>IoT, medical, defense, industrial</td>\n</tr><tr><td><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-clock-generators.html\" target=\"_self\" rel=\"noopener noreferrer\">Clock Generators</a></td>\n<td>Cascade™, Chorus™, Atna™</td>\n<td>FPGA/SoC clock trees</td>\n</tr><tr><td><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-jitter-cleaners.html\" target=\"_self\" rel=\"noopener noreferrer\">Jitter Cleaners</a></td>\n<td>Chorus™, Epoch™</td>\n<td>High-speed comms, data centers</td>\n</tr><tr><td><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-network-synchronizers.html\" target=\"_self\" rel=\"noopener noreferrer\">Network Synchronizers</a></td>\n<td style=\"white-space:nowrap\">TimeSync™</td>\n<td>PTP/IEEE 1588 timing</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/sitime-clock-buffers.html\" target=\"_self\" rel=\"noopener noreferrer\">Buffers</a></td>\n<td>MEMS-integrated buffers</td>\n<td>High-reliability systems</td>\n</tr></tbody></table>",
       "sling:resourceType": "macnicaglobal2/components/content/table",
       "textIsRich": "true",
       "cq:styleIds": [
        "",
