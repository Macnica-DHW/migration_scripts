         "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"0\" width=\"100%\" height=\"100%\">\n<tbody><tr><td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td>&nbsp;</td>\n<td style=\"text-align: center;\"><p><img src=\"/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/analog-devices/images/quality-assurance-black.png\" alt=\"\"></p>\n</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td colspan=\"7\"><p style=\"text-align: center;\"><b>Quality Assurance​</b><br>\nCertified to ISO9001:2015 and TS14949, we guarantee precision in fulfillment of authentic components that meet the highest industry quality standards.​</p>\n</td>\n</tr></tbody></table>",
