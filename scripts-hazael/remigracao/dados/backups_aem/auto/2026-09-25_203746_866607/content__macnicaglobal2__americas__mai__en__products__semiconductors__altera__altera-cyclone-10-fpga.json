     "table_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><th>Altera® Cyclone® 10 GX FPGA</th>\n<th>Altera® Cyclone® 10 LP FPGA</th>\n</tr><tr><td width=\"50%\"><p>Altera Cyclone 10 GX FPGAs are designed to deliver high-bandwidth performance for applications such as machine vision, video connectivity, and smart vision cameras.</p>\n</td>\n<td width=\"50%\"><p>Altera Cyclone 10 LP FPGAs are optimized for low power consumption and cost-sensitive applications.</p>\n</td>\n</tr><tr><td><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-cyclone-10-fpga/altera-cyclone-10-gx-fpga.html\"><b>Product Overview</b></a></td>\n<td><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-cyclone-10-fpga/altera-cyclone-10-lp-fpga.html\"><b>Product Overview</b></a></td>\n</tr></tbody></table>",
