        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">H32AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">The H32AQ SoC combines 6MP30 video encoding, image/video processing, and a quad-core processor in a single, low-power design.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-a12aq.jpg",
        "alt": "Ambarella A12AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">A12AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Engineered for electronic mirrors and automotive video recording systems, the A12AQ processor provides superior visibility even in low-light or high-contrast environments, delivering a combination of advanced image processing, high dynamic range (HDR), 3D noise filtering, smart auto exposure, and high-resolution encode performance.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
