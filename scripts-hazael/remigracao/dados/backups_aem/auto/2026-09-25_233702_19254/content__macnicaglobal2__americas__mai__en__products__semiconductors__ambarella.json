       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv25aq.jpg",
        "alt": "Ambarella CV25AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">CV25AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">With the lowest power consumption in the CVflow®&nbsp;family, the CV25AQ combines advanced image processing, 6MP30 video encoding, and CVflow computer vision performance.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
