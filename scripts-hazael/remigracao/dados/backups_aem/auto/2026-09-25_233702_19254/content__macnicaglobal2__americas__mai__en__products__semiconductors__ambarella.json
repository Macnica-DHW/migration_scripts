       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV72S</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">The Ambarella CV72S SoC's combination of high performance and low power consumption makes it an ideal solution for various applications, including automotive, security cameras, drones, and other intelligent vision systems.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv2.jpg",
        "alt": "Ambarella CV2",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV2</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Designed for accurate 3D environmental modeling and real-time neural network performance, the CV2 chip enables advanced robotics and industrial applications, including autonomous robots.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
