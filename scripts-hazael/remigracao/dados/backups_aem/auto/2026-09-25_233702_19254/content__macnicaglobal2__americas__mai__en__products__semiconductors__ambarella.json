        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV25</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">The CV25 chip combines advanced image processing and real-time CVflow®&nbsp;computer vision performance for intelligent industrial/robotics applications.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_3": {
       "jcr:primaryType": "nt:unstructured",
