     "textwithimage_1": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cvflow-0.png",
      "imageRatio": "36",
      "alt": "Ambarella CV Flow",
      "text": "<h3>CVflow® Chip Architecture</h3>\n<p style=\"margin-top:0\">Ambarella CVflow®&nbsp;chip architecture is based on a deep understanding of core computer vision algorithms. Unlike general-purpose CPUs and GPUs, CVflow includes a dedicated vision processing engine programmed with a high-level algorithm description, allowing Ambarella architecture to scale performance to trillions of operations per second with extremely low power consumption.</p>\n<p>With CVflow, customers can efficiently map their own CNN networks trained with industry-standard tools (e.g., Caffe, TensorFlow, PyTorch)&nbsp;to run on Ambarella processors.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
