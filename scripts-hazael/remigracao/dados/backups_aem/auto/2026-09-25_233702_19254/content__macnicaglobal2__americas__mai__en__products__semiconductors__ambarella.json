       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv28aq.jpg",
        "alt": "Ambarella CV28AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV28AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Ambarella’s AEC-Q100 qualified CV28AQ SoC combines image processing, 6MP30 video encoding/decoding, and CVflow®&nbsp;computer vision processing in a single, low-power design, making it an ideal choice to power the next generation of intelligent automotive.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv28m.jpg",
        "alt": "Ambarella CV28M",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV28M</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Our CV28M SoC is designed for intelligent applications at the edge, including smart home security, retail monitoring, consumer robotics, and occupancy monitoring. The chip’s high-performance CVflow®&nbsp;architecture provides deep neural network (DNN) computer vision processing and 4KP30 video encoding, enabling an array of computer vision-based devices.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_3": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-h22aq.jpg",
        "alt": "Ambarella H22AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">H22AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">An industry-leading combination of low power and high performance, the H22AQ SoC delivers image/video processing and 8MP30 video encoding/decoding in a single design.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
