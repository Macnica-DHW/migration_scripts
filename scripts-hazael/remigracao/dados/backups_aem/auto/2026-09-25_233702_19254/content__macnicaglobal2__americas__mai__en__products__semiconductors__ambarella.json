      "flexcontaineritem_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv20aq.jpg",
        "alt": "Ambarella CV20AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV20AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Featuring CVflow® AI processing, the CV20AQ chip targets stereo-camera advanced driver assistance systems (ADAS), multi-camera L2+ systems, multi-camera driver monitoring systems (DMS) and occupancy monitoring solutions (OMS), multi-channel electronic mirrors with blind spot detection, and intelligent parking assistance systems.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv22.jpg",
        "alt": "Ambarella CV22",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV22</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Ambarella’s CV22 SoC combines advanced image processing with our powerful CVflow® computer vision architecture to deliver the next generation of intelligent robotics and industrial applications.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_3": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/ambarella/images/ambarella-cv22aq.jpg",
        "alt": "Ambarella CV22AQ",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">CV22AQ</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">The CV22AQ delivers next-generation image processing, 12MP30 video encoding, and CVflow® computer vision performance in an optimized, low-power design.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
