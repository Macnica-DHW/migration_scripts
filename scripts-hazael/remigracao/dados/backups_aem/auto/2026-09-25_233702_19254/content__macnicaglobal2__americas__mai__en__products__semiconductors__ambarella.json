        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">CV2FS</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">Designed for front-facing stereovision ADAS cameras, as well as computer vision ECUs for L2+ and higher levels of autonomy, the CV2FS chip features CVflow® AI processing and ASIL C compliance to enable safety-critical applications.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
