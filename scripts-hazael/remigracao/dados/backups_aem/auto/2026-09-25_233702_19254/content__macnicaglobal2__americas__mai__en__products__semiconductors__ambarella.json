       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">CV22FS</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Featuring CVflow®&nbsp;AI processing and ASIL C compliance to enable safety-critical applications, the CV22FS chip targets forward-facing monocular ADAS cameras, as well as computer vision ECUs for L2+ and higher levels of autonomy.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
