     "table_container_copy_558282354": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\n<tbody><tr><td width=\"20%\" style=\"width:169px;\"><p><b>TQMLS1028A-AA</b></p>\n</td>\n<td><ul>\n<li>TQMLS1028A, Dual Cortex®-A72/1,3 GHz, 64 MB NOR Flash, 8GB eMMC Flash, 1GB DDR4, 64kB EEPROM, -40°C…+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>TQMLS1018A-AA</b></p>\n</td>\n<td><ul>\n<li>TQMLS1018A, Single Cortex®-A72/1,3 GHz, 64 MB NOR Flash, 8GB eMMC Flash, 1 GB DDR4,<br>\n64kB EEPROM, -40°C …+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>TQMLS1017A-AA</b></p>\n</td>\n<td><ul>\n<li>TQMLS1027A, Dual Cortex®-A72/1,3 GHz, 64 MB NOR Flash, 8GB eMMC Flash, 1GB DDR4,<br>\n64kB EEPROM, -40°C …+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><b>TQMLS1027A-AA</b></td>\n<td><ul>\n<li>TQMLS1017A, Single Cortex®-A72/1,3 GHz, 64 MB NOR Flash, 8GB eMMC Flash, 1 GB DDR4, 64kB EEPROM, -40°C …+85°C</li>\n</ul>\n</td>\n</tr><tr><td style=\"width:169px;\"><p><b>STKLS1028A-AA</b></p>\n</td>\n<td><ul>\n<li>STKLS1028A (Eval Kit) with TQMLS1028AA or TQMLS101027A/Dual Cortex A72/1,3 GHz, 1GB DDR4, 64MB QSPI NOR Flash, 8GB eMMC, 64kB EEPROM, RTC, 2x CAN 2.0B gtr., 2x USB 3.0 HOST, 1 x USB 3.0 OTG , 2x ETH 10/100/1000, 4x Gigabit Ethernet TSN Switch, 1x M.2 SATA, 1x Display Port, 1x Mini PCIe + SIM, Reset-Button, Micro SD-Interface, 1x USB Debug, Power Supply, SD-Card, Accessoires, Cable</li>\n</ul>\n</td>\n</tr></tbody></table>",
      "jcr:lastModified": "Tue Sep 01 2026 10:59:17 GMT+0000",
