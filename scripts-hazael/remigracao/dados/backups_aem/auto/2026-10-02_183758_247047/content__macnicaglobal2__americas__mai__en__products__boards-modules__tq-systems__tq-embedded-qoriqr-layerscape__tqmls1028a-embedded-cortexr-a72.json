     "table": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "saichand@anionmarketing.com",
      "text": "<table cellpadding=\"0\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><td width=\"20%\"><b>CPU</b></td>\r\n<td width=\"80%\"><ul>\r\n<li>CPU/Processor:<ul>\r\n<li>Cortex®-A72 - Up to 1,3GHz</li>\r\n</ul>\r\n</li>\r\n<li>CPU variant:<ul>\r\n<li>LS1028A Dual Core</li>\r\n<li>LS1027A Dual Core</li>\r\n<li>LS1018A Single Core</li>\r\n<li>LS1017A Single Core</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Memory</b></td>\r\n<td><ul>\r\n<li>Quad SPI NOR: Up to 512 MB</li>\r\n<li>eMMC: Up to 64 GB</li>\r\n<li>DDR4: Up to 8 GB</li>\r\n<li>ECC protection (optional)</li>\r\n<li>EEPROM: 0/256 kbit</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Graphics</b></td>\r\n<td><ul>\r\n<li>3D GPU</li>\r\n<li>4K LCD Controller with eDP/DP Phy</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Communications Interfaces</b></td>\r\n<td><ul>\r\n<li>Serial Ports:<ul>\r\n<li>Up to 6x UART</li>\r\n<li>Up to 6x SAI</li>\r\n</ul>\r\n</li>\r\n<li>Ethernet:<ul>\r\n<li>1x 4 Port TSN Gbit Ethernet Switch</li>\r\n<li>Up to 1x Ethernet 2.5 Gbit</li>\r\n<li>Up to 1x Ethernet 1 Gbit</li>\r\n</ul>\r\n</li>\r\n<li>CAN: Up to 2x CAN 2.0 B</li>\r\n<li>USB: 2x USB 3.0</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>Other Interfaces</b></td>\r\n<td><ul>\r\n<li>SPI: Up to 2x SPI</li>\r\n<li>I2C: Up to 8x I²C</li>\r\n<li>SATA: Up to 1x SATA 3.0</li>\r\n<li>PCIe: Up to 2x PCIe 3.0</li>\r\n<li>SD Card: Up to 2x SDIO/MMC</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>General</b></td>\r\n<td><ul>\r\n<li>Power supply: 5 V</li>\r\n<li>Temperature range: Extended temperature: -40°C…+85°C</li>\r\n<li>Dimensions: 55 x 44 mm</li>\r\n<li>Plug-in System: Board-to-board plug-in system 240 pins</li>\r\n</ul>\r\n</td>\r\n</tr><tr><td><b>OS</b></td>\r\n<td><ul>\r\n<li>Linux</li>\r\n</ul>\r\n</td>\r\n</tr></tbody></table>\r\n",
      "jcr:lastModified": "Thu Oct 01 2026 15:36:21 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/table",
