     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<h3>Features</h3>\n<ul>\n<li>Cortex-A72 processor up to 1.3GHz for high-performance computing.</li>\n<li>Multiple LS1028A CPU variants to suit different requirements.</li>\n<li>Graphics capabilities with a 3D GPU and 4K LCD controller.</li>\n<li>Versatile connectivity options, including USB 3.0, CAN, and Ethernet.</li>\n<li>Board-to-board plug-in system, compact form factor, and wide temperature range.</li>\n</ul>",
      "jcr:lastModified": "Tue Sep 01 2026 10:58:27 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
