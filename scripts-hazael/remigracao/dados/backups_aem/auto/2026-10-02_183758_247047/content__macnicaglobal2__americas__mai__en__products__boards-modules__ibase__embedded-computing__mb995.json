     "table_ordering": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th>MB995VF-C246</th>\r\n<td width=\"80%\">LGA1151 C246 ATX motherboard w/ HDMI, DVI-D, DisplayPort (1.2), dual Gigabit LAN, RAID, iAMT (11.0), TPM (2.0), iSMART (3.5)</td>\r\n</tr><tr><th>MB995VF</th>\r\n<td>LGA1151 Q370 ATX motherboard w/ HDMI, DVI-D, DisplayPort (1.2), dual Gigabit LAN, RAID, iAMT (11.6), TPM (2.0), iSMART (3.5)</td>\r\n</tr></tbody></table>\r\n<h3>&nbsp;</h3>",
