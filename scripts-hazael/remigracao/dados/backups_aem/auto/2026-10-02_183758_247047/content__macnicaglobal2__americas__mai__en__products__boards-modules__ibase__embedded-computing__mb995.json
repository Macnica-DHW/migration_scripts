     "text": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<h3><b>About IBASE</b></h3>\r\n<ul>\r\n<li>IBASE offers advanced embedded computing solutions for industrial applications.</li>\r\n<li>Their products feature high-performance processors and extensive I/O capabilities.</li>\r\n<li>IBASE motherboards support remote management and system integrity through features like iAMT and TPM.</li>\r\n<li>Energy-efficient operations are facilitated by IBASE's proprietary iSMART technology.</li>\r\n<li>IBASE products are designed for various industries including industrial automation, digital signage, and gaming.</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
