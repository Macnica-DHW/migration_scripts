     "textwithimage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/ibase/images/MB995.jpeg",
      "imageRatio": "40",
      "alt": "MI997 board",
      "text": "<ul>\r\n<li>8th Gen Intel® Xeon® E/ Core™ i7/i5/i3 processors, up to 4.7GHz</li>\r\n<li>Support for up to 64GB DDR4 DIMM memory</li>\r\n<li>Dual Intel® Gigabit LAN for reliable network connectivity</li>\r\n<li>Extensive I/O capabilities including USB3.1, USB3.0, COM ports, and SATAIII</li>\r\n<li>Advanced features like iAMT (11.6), TPM (2.0), vPro, and iSMART</li>\r\n</ul>",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
