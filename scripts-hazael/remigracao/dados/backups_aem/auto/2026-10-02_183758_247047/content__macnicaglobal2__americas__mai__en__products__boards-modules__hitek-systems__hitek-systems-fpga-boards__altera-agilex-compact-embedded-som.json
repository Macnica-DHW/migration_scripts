      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/hitek-systems/Altera Agilex Compact.jpg",
      "imageRatio": "40",
      "alt": "Altera Agilex Compact",
      "text": "<p>Altera 10nm Agilex 7 Series FPGA based compact embedded SOM (eSOM™) module for embedded, edge processing, wireless communication and networking centric designs.&nbsp; Up to 1.2Tbps high speed transceivers bandwidth supporting up to 58Gbps PAM4 and x16 PCIe Gen 4 interfaces. Integrated quad-core 64-bit A53 ARM processor complex with network, control and storage peripherals. This Altera Agilex SOM has flexible clocking with an integrated network synchronizer.</p>",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
