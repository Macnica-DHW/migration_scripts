      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/P8-10.png",
      "imageRatio": "30",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "jcr:created": "Thu Sep 24 2026 13:23:41 GMT+0000",
      "alt": "kino 420",
      "text": "<p>The M.2 2230, a key slot with PCIe Gen3 x1 and USB 2.0, has adopted the latest Wi-Fi 6E technology. Wi-Fi 6E enhances low latency and supports service levels that are equivalent to 5G networks.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "jcr:lastModified": "Thu Sep 24 2026 13:48:32 GMT+0000",
      "titleValueFromDAM": "true",
