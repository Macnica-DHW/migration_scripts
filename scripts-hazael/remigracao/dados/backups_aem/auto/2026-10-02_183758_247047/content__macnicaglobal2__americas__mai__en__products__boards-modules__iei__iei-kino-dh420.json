     "heading_2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Delivers Triple Low-Latency 2.5G LAN Powered by Intel",
      "type": "h1",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "textwithimage_copy": {
