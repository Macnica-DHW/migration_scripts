      "alt": "kino 420",
      "text": "<ul>\r\n<li>LGA1200 Intel® 10th Generation Core™ i9/i7/i5/i3, Celeron® and Pentium® processor</li>\r\n<li>Support triple Intel® 2.5Gb Ethernet controller</li>\r\n<li>Support HDMI, DP display output</li>\r\n<li>Support 1 x PCIe Gen3 x16, 1 x M.2 A key, 1 x M.2 B key expansion</li>\r\n</ul>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "jcr:lastModified": "Thu Sep 24 2026 13:27:09 GMT+0000",
