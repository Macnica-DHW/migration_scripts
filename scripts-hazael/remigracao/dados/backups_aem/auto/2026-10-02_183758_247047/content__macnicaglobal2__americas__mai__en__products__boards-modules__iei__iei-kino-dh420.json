      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "jcr:created": "Thu Sep 24 2026 13:23:41 GMT+0000",
      "alt": "kino 420",
      "text": "<p>The KINO-DH420 also offers one M.2 3042/3052/2242/2280 B key socket supporting AI accelerator / NVMe SSD as well as SIM card slot for LTE deployment.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
