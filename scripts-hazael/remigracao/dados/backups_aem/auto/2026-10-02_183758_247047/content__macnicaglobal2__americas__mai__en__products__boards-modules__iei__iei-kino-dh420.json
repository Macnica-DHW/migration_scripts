     "heading_8": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "One PCIe Gen3 x16 Slot Easily Adds on GPGPU, AI Accelerator, Frame Grabber and More",
      "type": "h1",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_12": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>The KINO-DH420 brings high-performance industrial Edge with one PCIe x16 slot. This provides a greater range of support for GPGPU, frame grabber card and AI accelerators. It is designed for the most intensive applications from Edge AI system to automated optical inspection (AOI).</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
