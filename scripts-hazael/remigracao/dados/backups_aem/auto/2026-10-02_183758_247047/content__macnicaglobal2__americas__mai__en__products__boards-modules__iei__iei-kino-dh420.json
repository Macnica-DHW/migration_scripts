      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "jcr:created": "Thu Sep 24 2026 13:23:41 GMT+0000",
      "alt": "kino 420",
      "text": "<p>IEI KINO-DH420 features unprecedented network connectivity with three rear 2.5 Gigabit LAN ports, and it is small enough to fit into any space-confined situations.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
