       "text": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "valter.toffolo@macnicadhw.com.br",
        "text": "<h3>Applications</h3>\r\n<ul>\r\n<li><b>Aviation: </b>Data loggers, aircraft cabin systems</li>\r\n<li><b>Industrial Automation:</b> AI/vision applications, PLC, industrial control and automation.</li>\r\n<li><b>Robotics:</b> Robots for welding, painting, assistance</li>\r\n<li><b>Energy:</b> Smart grid and solar, wind equipment</li>\r\n<li><b>Transportation and Signage:</b> Information/ticketing systems,</li>\r\n<li><b>Digital signage, outdoor kiosks, etc:</b>&nbsp; IBASE is an industry leader in this space</li>\r\n<li><b>Real-time control in general</b></li>\r\n</ul>\r\n",
        "jcr:lastModified": "Sun Sep 06 2026 15:07:43 GMT+0000",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
