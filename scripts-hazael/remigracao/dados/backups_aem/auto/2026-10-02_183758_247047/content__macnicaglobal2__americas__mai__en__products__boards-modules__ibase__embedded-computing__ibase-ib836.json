       "table_787459565": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "valter.toffolo@macnicadhw.com.br",
        "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th>IB836F-6425E</th>\r\n<td width=\"79%\">Intel® Atom™ x6425E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), LVDS,mSATA, M.2, EuP/ErP, 9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>IB836FE-6425E</th>\r\n<td>Intel® Atom™ x6425E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), eDP,mSATA, M.2, EuP/ErP, 9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>IB836F-6413E</th>\r\n<td>Intel® Atom™ x6413E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), LVDS(24-bit LVDS Dual-channel), mSATA, M.2, EuP/ErP,9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>IB836FE-6413E</th>\r\n<td>Intel® Atom™ x6413E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), eDP,mSATA, M.2, EuP/ErP, 9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>IB836F-6211E</th>\r\n<td>Intel® Atom™ x6211E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), LVDS,mSATA, M.2, EuP/ErP, 9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>IB836FE-6211E</th>\r\n<td>Intel® Atom™ x6211E, 3.5-inch Disk Size SBC w/ 3x GbE LAN, 2x DisplayPort (DP connector and Type-C), eDP,mSATA, M.2, EuP/ErP, 9V~36V DC-in, wide temp support</td>\r\n</tr><tr><th>HSIB836-X-A</th>\r\n<td>Heatsink for IB836</td>\r\n</tr><tr><th>HSIB836-A</th>\r\n<td>Heat spreader for IB836</td>\r\n</tr><tr><th>IB76A-2</th>\r\n<td>Cable kit w/ USB, COM, Power, SATA + Power</td>\r\n</tr></tbody></table>\r\n<h3>&nbsp;</h3>",
