       "text": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
        "text": "<h3>About IBASE</h3>\r\n<ul>\r\n<li>20-year history of producing a wide portfolio of robust industrial embedded computing solutions</li>\r\n<li>SBC’s, industry standard modules, packaged solutions, ISO certified quality offerings</li>\r\n<li>Wide variety of platform performance, cost, features and partners: Intel, AMD, NXP (ARM)</li>\r\n<li>High performance edge computing solutions</li>\r\n<li>Digital signage industry leadership (multi-displays)</li>\r\n<li>Flexibility with cost effective customization option</li>\r\n</ul>\r\n",
        "jcr:lastModified": "Tue Sep 29 2026 19:06:09 GMT+0000",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
