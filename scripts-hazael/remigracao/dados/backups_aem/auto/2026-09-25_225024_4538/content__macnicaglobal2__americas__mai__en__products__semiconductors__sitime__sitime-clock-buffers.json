     "textwithimage_1": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sitime/images/sitime-buffers.png",
      "imageRatio": "29",
      "alt": "SiTime buffers",
      "text": "<h3><b>Reliable Signal Distribution for Precision Timing Architectures</b></h3>\n<p style=\"margin-top:0\">In advanced electronic systems, precision timing doesn't stop at the oscillator. It must be <b>cleanly and consistently distributed</b> across multiple clock domains. SiTime’s <b>MEMS-based clock buffers</b> provide high fan-out, low additive jitter, and robust performance under demanding environmental and EMI conditions.&nbsp;Designed to work seamlessly with SiTime’s programmable oscillators and clock generators, these buffers maintain signal integrity across harsh environments while reducing design complexity. From 5G radios to industrial robotics, SiTime's buffers are the glue that holds your timing tree together.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
      "cq:styleIds": [
       "1718154328384",
       "1783061491236"
      ]
     }
    },
