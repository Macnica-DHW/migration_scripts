     "container_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Key Features",
       "id": "keyfeatures",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>Ultra-Low Additive Jitter</b><br>\nEnsures minimal degradation of signal quality in high-speed systems - critical for PCIe, SerDes, and high-speed networking</li>\n</ul>\n<ul>\n<li><b>Flexible Output Options</b><br>\nSupports both single-ended (LVCMOS) and differential (LVPECL, LVDS, HCSL) outputs</li>\n</ul>\n<ul>\n<li><b>Rugged Performance</b><br>\nDesigned for high EMI environments, vibration-prone conditions, and wide operating temperatures - including automotive-grade options</li>\n</ul>\n<ul>\n<li><b>Pin-Compatible and Drop-In</b><br>\nCompatible with industry-standard footprints and ideal for quartz buffer replacement or MEMS-enhanced designs</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiTime Buffer Product Lineup",
       "id": "sitimebufferproductlineup",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      }
     },
     "container_3": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT92208 - 1:8 Differential Fan-Out Buffer",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>8 differential outputs</li>\n<li>Low additive jitter (&lt;50 fs RMS typical)</li>\n<li>Supports LVPECL, LVDS, HCSL</li>\n<li>Operates from 1.8V to 3.3V supply</li>\n<li>Ideal for clock tree distribution in switches, routers, and test equipment</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_4": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<hr />",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_5": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT92211 - 1:10 Low Jitter Clock Buffer",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>10 LVCMOS outputs</li>\n<li>Sub-nanosecond output skew</li>\n<li>Integrated OE/standby controls</li>\n<li>Automotive-qualified (AEC-Q100) variant available</li>\n<li>Perfect for distributed clock topologies in automotive and industrial networks</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_6": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<hr />",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_7": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT92216 - High Drive 1:6 Differential Buffer",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>6 differential outputs with selectable formats</li>\n<li>Drives long PCB traces or high-capacitance loads</li>\n<li>Additive jitter &lt;40 fs</li>\n<li>Compact QFN package</li>\n<li>Designed for PCIe Gen 4/5, Ethernet PHYs, and FPGA boards</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_8": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<hr />",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_9": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT92182 - Automotive 1:2 LVCMOS Buffer",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Ultra-low power and EMI-optimized</li>\n<li>Extended temp range (-40 °C to +125 °C)</li>\n<li>Small package size for ADAS and infotainment modules</li>\n<li>Low output-to-output skew</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_10": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<hr />",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_11": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT92184 - Rugged 1:4 Automotive Buffer",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>4 single-ended LVCMOS outputs</li>\n<li>Designed for synchronization of multiple domains within zonal and body ECUs</li>\n<li>Excellent power supply rejection and low EMI profile</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_12": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Applications",
       "id": "applications",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>5G Base Stations and Fronthaul Gateways</b><br>\nDistribute synchronized clock signals across RF and digital domains</li>\n</ul>\n<ul>\n<li><b>Automotive (ADAS, Zonal, Telematics)</b><br>\nRugged buffers with AEC-Q100 support for harsh conditions</li>\n</ul>\n<ul>\n<li><b>FPGA / SoC-Based Systems</b><br>\nClean clock delivery to high-speed interfaces, SerDes blocks, and peripherals</li>\n</ul>\n<ul>\n<li><b>Test &amp; Measurement Equipment</b><br>\nEnsures repeatable, precise timing for signal analysis and compliance testing</li>\n</ul>\n<ul>\n<li><b>Industrial and Robotics</b><br>\nLow skew and jitter for motor control, real-time sensors, and vision systems</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_13": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Why SiTime Buffers?",
       "id": "whysitimebuffers",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "table_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th style=\"white-space:nowrap\">Feature</th>\n<th>Traditional Buffer ICs</th>\n<th>SiTime MEMS Buffers</th>\n</tr><tr><td width=\"33%\">Additive Jitter</td>\n<td width=\"33%\">~100 fs – 1 ps</td>\n<td width=\"33%\">&lt;50 fs typical</td>\n</tr><tr><td>Vibration Tolerance</td>\n<td style=\"white-space:nowrap\">Low</td>\n<td>100,000 g MEMS core</td>\n</tr><tr><td>Automotive Grade Options</td>\n<td style=\"white-space:nowrap\">Limited</td>\n<td>AEC-Q100 qualified</td>\n</tr><tr><td>Integration with Timing Tree</td>\n<td>Manual tuning</td>\n<td>Seamless with SiTime clocks</td>\n</tr><tr><td>EMI Robustness</td>\n<td style=\"white-space:nowrap\">Average</td>\n<td style=\"white-space:nowrap\">Excellent</td>\n</tr></tbody></table>",
       "sling:resourceType": "macnicaglobal2/components/content/table",
       "textIsRich": "true",
       "cq:styleIds": [
        "",
        "",
        "1722939215525"
       ]
      }
     }
