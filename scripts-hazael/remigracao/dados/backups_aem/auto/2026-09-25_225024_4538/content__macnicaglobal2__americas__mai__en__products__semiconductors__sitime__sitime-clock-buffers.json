     },
     "container_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p>Macnica Americas offers full support to help you evaluate and integrate SiTime’s buffer solutions into your timing architecture. Whether you’re designing for rugged automotive applications or high-speed networking equipment, we’re here to assist with product selection, samples, and integration guidance.</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
