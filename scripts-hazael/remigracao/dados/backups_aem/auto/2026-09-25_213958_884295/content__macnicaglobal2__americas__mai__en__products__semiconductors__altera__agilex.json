     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Agilex™ 7 FPGAs and SoCs",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>Altera Agilex 7 Series FPGAs combine 10 nm and 20 nm technologies, offering flexibility for tailored designs. Featuring Hyperflex Architecture, they provide PCIe 5.0 and Compute Express Link support ideal for data centers and networking, Agilex 7 FPGAs balance performance and power efficiency for practical applications.</p><p style=\"margin-top:0\">&nbsp;</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     },
     "table_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\">\n<tbody><tr><th>&nbsp;</th>\n<th style=\"white-space:nowrap\">F-Series</th>\n<th style=\"white-space:nowrap\">I-Series</th>\n<th style=\"white-space:nowrap\">M-Series</th>\n</tr><tr><td><b>Logic Elements</b></td>\n<td>573K-2.7M LE</td>\n<td>up to 4.0M LE</td>\n<td>up to 3.9M LE</td>\n</tr><tr><td style=\"white-space:nowrap\"><b>PCIe</b></td>\n<td>PCIe 4.0</td>\n<td>PCIe 5.0</td>\n<td>PCIe 5.0</td>\n</tr><tr><td><b>Memory Support</b></td>\n<td style=\"white-space:nowrap\">DDR4</td>\n<td style=\"white-space:nowrap\">DDR4</td>\n<td>LPDDR5 / DDR5/ DDR4</td>\n</tr></tbody></table>",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
      "cq:styleIds": [
       "",
       "",
       "1722939215525"
      ]
     },
