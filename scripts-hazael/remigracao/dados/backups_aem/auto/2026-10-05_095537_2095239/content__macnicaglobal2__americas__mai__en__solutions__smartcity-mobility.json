        "flexcontaineritem_1": {
         "jcr:primaryType": "nt:unstructured",
         "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
         "text_1": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
          "id": "senseplus",
          "text": "<p><b>Sense Plus</b></p>\r\n<p>Explore our groundbreaking Sense Plus, where we tap into the driver's brain activity to monitor and predict their states and emotions - ranging from concentration and stress to drowsiness. Designed to support automotive engineers crafting futuristic applications, our product revolutionizes the understanding of human responses within automotive contexts. InnerEye's Sense Plus platform is an advanced system that deciphers human emotions and mental states from brain activity, visualizing them as precise numerical data in real-time.</p>\r\n<p><a href=\"https://www.macnica.co.jp/en/business/ai/manufacturers/innereye/\">Learn more</a></p>\r\n",
          "jcr:lastModified": "Thu Sep 24 2026 12:36:39 GMT+0000",
          "sling:resourceType": "macnicaglobal2/components/content/text",
          "textIsRich": "true"
         }
        },
        "flexcontaineritem_2": {
         "jcr:primaryType": "nt:unstructured",
         "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
