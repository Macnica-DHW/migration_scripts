      },
      "flexcontainer_882332": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
       "cq:styleIds": [
        "1719484596357"
       ],
       "flexcontaineritem": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<h3>Typical Applications</h3>\r\n<ul>\r\n<li>Mobile robots and AMRs</li>\r\n<li>Inspection and quality control</li>\r\n<li>Industrial vehicles</li>\r\n<li>Smart city analytic</li>\r\n<li>Autonomous systems</li>\r\n<li>Multi-camera vision</li>\r\n<li>Sensor fusion and mapping</li>\r\n</ul>\r\n",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_725535719": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text_copy": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<h3>Carriers and Cameras</h3>\r\n<ul>\r\n<li><b>Carriers:</b> Connect Tech Rogue and Rogue-X carrier boards for AGX Xavier</li>\r\n<li><b>Camera expansion:</b> MIPI boards for Allied Vision Alvium, FPD-Link III, SDI, and HDMI ingest</li>\r\n<li><b>Storage and comms:</b> NVMe via M.2, multiple USB 3.x, dual Ethernet options on supported carriers</li>\r\n</ul>\r\n",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "flexcontaineritem_918953594": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "text_copy": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<h3>Ordering Information</h3>\r\n<ul><li><b>Jetson AGX Xavier:</b> 16 GB or 32 GB module options</li></ul>\r\n<p><a href=\"/content/macnicaglobal2/americas/mai/en/contact/form.html\">Contact us</a> for availability, lead time, recommended carriers, thermal solutions, and camera kits.</p>\r\n",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       }
      }
     }
    },
    "container_1400520223_2000416047": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "#f7f7f7",
     "cq:styleIds": [
