        "1717498056876"
       ],
       "table": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" height=\"100%\"><tbody><tr><th style=\"width:20%;text-align:left\">Category</th><th>Interfaces</th></tr><tr><td style=\"width:20%;text-align:left\">Form factor</td><td>100 mm x 87 mm module with integrated thermal transfer plate</td></tr><tr><td style=\"width:20%;text-align:left\">AI performance</td><td>Up to 32 TOPS class depending on model and power mode</td></tr><tr><td style=\"width:20%;text-align:left\">CPU</td><td>8-core Arm v8.2</td></tr><tr><td style=\"width:20%;text-align:left\">GPU</td><td>NVIDIA architecture with Tensor Cores</td></tr><tr><td style=\"width:20%;text-align:left\">AI accelerators</td><td>Dual NVDLA engines</td></tr><tr><td style=\"width:20%;text-align:left\">Memory</td><td>16 GB or 32 GB LPDDR4x options</td></tr><tr><td style=\"width:20%;text-align:left\">Storage</td><td>32 GB eMMC on module</td></tr><tr><td style=\"width:20%;text-align:left\">Camera I/O</td><td>Up to 16 lanes MIPI CSI-2</td></tr><tr><td style=\"width:20%;text-align:left\">High-speed I/O</td><td>PCIe Gen 4, USB 3.x, Gigabit Ethernet</td></tr><tr><td style=\"width:20%;text-align:left\">Video</td><td>Multi-stream 4K encode and decode</td></tr><tr><td style=\"width:20%;text-align:left\">Typical power</td><td>Profile selectable in the 10 W to 30 W range</td></tr></tbody></table>\r\n<p><i style=\"\tletter-spacing: 0.0px;\n\">Values are typical for selection and may vary by exact module and software release.</i></p>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/table",
        "textIsRich": "true",
