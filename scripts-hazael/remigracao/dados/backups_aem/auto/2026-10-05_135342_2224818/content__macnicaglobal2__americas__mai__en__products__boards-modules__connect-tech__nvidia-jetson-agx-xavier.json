     "title_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Choose Your Module: Selection Guidance",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title",
      "cq:styleIds": [
       "",
       "",
       "",
       ""
      ]
     },
     "text": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<ul>\r\n<li>Choose <b>Jetson AGX Xavier</b> when you need higher model complexity, more camera streams, or faster decision loops than Xavier NX or Orin Nano class modules</li>\r\n</ul>\r\n<ul>\r\n<li>Pair with a <b>production-ready carrier</b> to shorten time to market, then add camera boards to match your sensor stack</li>\r\n</ul>\r\n",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
