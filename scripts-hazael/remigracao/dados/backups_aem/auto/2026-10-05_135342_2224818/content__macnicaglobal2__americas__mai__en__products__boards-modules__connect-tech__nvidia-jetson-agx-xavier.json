     "title_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Why Choose Jetson AGX Xavier?",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "type": "h2",
      "jcr:lastModified": "Mon Sep 21 2026 14:04:38 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/title",
      "cq:styleIds": [
       "",
       "",
       "",
       ""
      ]
     },
     "flexcontainer": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "1719484596357"
      ],
      "flexcontaineritem": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\r\n<li>Up to 32 TOPS class AI performance in a compact module</li>\r\n<li>8-core Arm CPU and NVIDIA GPU with Tensor Cores for modern AI workloads</li>\r\n<li>Flexible power profiles to match thermal and battery targets</li>\r\n<li>Camera-dense designs with CSI-2 lanes for multi-sensor pipelines</li>\r\n<li>Mature Jetson software stack, tools, and ecosystem</li>\r\n</ul>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_825470192": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem"
      }
     },
     "container": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "1717498052331",
       "1717498055877"
      ],
      "title": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Key Features",
       "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
       "type": "h2",
       "jcr:lastModified": "Mon Sep 21 2026 14:03:36 GMT+0000",
       "sling:resourceType": "macnicaglobal2/components/content/title",
       "cq:styleIds": [
        "",
        "",
        "",
        ""
       ]
      },
      "text": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\r\n<li><b>High throughput AI: </b>Run multiple DNNs in parallel for perception, tracking, and analytics</li>\r\n<li><b>Sensor-fusion-ready: </b>Abundant CSI-2 and high-speed I/O for cameras, lidar, and radar</li>\r\n<li><b>Rugged integration: </b>Small footprint with integrated heat spreader simplifies mechanical design</li>\r\n<li><b>Production-grade software:</b> JetPack SDK, CUDA, TensorRT, and containerized deployment</li>\r\n<li><b>Lifecycle support:</b> Long-term availability for industrial programs</li>\r\n</ul>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_1294279675": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
