     "textwithimage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/connect-tech/images/NVIDIA® Jetson AGX Xavier%0A.png",
      "imageRatio": "30",
      "alt": "NVIDIA® Jetson AGX Xavier",
      "text": "<h3><b>Overview</b></h3>\r\n<p>NVIDIA Jetson AGX Xavier brings data-center-class AI to embedded form factors. It combines a powerful GPU, AI accelerators, and an 8-core CPU with rich I/O for multi-sensor systems. Use it when you need more parallel inference, higher frame rates, and advanced perception on device.</p>\r\n",
      "displayPopupTitle": "true",
      "linkTarget": "_self",
      "titleValueFromDAM": "true",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
