      "title": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Why These Modules?",
       "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
       "type": "h2",
       "jcr:lastModified": "Mon Sep 21 2026 14:04:20 GMT+0000",
