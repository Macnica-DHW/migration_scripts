     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>Equipped with up to 48 full-duplex transceivers, this Altera® Arria® 10 SX SoC FPGA supports chip-to-chip communication at data rates of up to 17.4 Gbps and backplane communication at speeds up to 12.5 Gbps. Along with an ARM* Cortex*-A9 dual-core HPS, it can handle up to 660K equivalent logic elements (LEs).</p><p style=\"margin-top:0\">&nbsp;</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     },
