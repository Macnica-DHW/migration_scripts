      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Titan Platform Resonators",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>Part Numbers</b>: SiT11100, SiT11101, SiT11102, SiT11103, SiT11104</li>\n<li><b>Specifications</b>: Frequencies in the ~32‑76.8 MHz range; very small footprint; ultra‑low power; high shock/vibration tolerance</li>\n<li><b>Key Features</b>:<ul>\n<li>4× to 7× smaller than the smallest quartz resonators; enables tighter board layouts</li>\n<li>Excellent stability vs temperature and aging</li>\n<li>Rugged MEMS structure: high shock and vibration resilience</li>\n</ul>\n</li>\n<li><b>Use Cases</b>: Embedded sensors, IoT edge devices, medical wearables, any design where size and stability are critical</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
