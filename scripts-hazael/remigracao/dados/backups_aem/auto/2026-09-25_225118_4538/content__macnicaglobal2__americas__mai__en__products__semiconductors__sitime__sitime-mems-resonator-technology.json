      "imageRatio": "23",
      "alt": "SiTime MEMS resonators",
      "text": "<h3><b>Revolutionize Timing with MEMS Resonator Technology</b></h3>\n<p style=\"margin-top:0\">SiTime’s MEMS resonators deliver unmatched robustness, performance, and programmability over legacy quartz. As the only silicon MEMS resonators qualified for automotive, industrial, and aerospace-grade applications,&nbsp;SiTime MEMS resonator technology is redefining how systems synchronize in size, power, and precision.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
      "isDecorative": "false",
      "textIsRich": "true",
      "altValueFromDAM": "false",
      "cq:styleIds": [
       "1718154328384"
      ]
     }
    },
    "container_2": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "backgroundColor": "rgb(247,247,247)",
