      "1717498056876"
     ],
     "container_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Key Features",
       "id": "keyfeatures",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>Shock and Vibration-Resistant:&nbsp;</b>Operate reliably in extreme environments (up to 100,000 g)</li>\n<li><b>Unmatched MTBF:</b>&nbsp;Up to 2.2 billion hours</li>\n<li><b>Small Size, Big Flexibility:</b>&nbsp;QFN, CSP, and wafer-level packaging</li>\n<li><b>Temperature-Resilient:</b>&nbsp;Excellent thermal performance with tight coupling</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
