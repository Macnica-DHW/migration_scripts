      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Elite Platform Oscillators",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "title_2": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Industry’s most robust, high-performance MEMS resonators with ICs for demanding use cases",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li><b>Part Numbers:</b> SiT8008, SiT8021, SiT8924, SiT8925, SiT9396, SiT9397</li>\n<li><b>Specifications:</b> Frequencies up to ~725 MHz; ±0.1 ppm stability; wide temperature range (-55 °C to +125 °C); ultra-low jitter</li>\n<li><b>Key Features:</b><ul>\n<li>100× better resilience to shock, vibration, and aging than quartz</li>\n<li>Exceptional frequency stability for mission-critical applications</li>\n<li>Available in ultra-small packages with low power options</li>\n<li>Field-programmable for custom frequency, stability, and voltage needs</li>\n</ul>\n</li>\n<li><b>Use Cases:</b><span> 5G infrastructure, aerospace and defense, industrial IoT, precision networking, high-reliability automotive systems</span></li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_4": {
      "jcr:primaryType": "nt:unstructured",
