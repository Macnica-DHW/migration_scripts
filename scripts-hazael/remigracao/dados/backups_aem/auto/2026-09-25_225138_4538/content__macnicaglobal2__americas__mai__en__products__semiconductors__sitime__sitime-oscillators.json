       "jcr:title": "TCXOs",
       "id": "tcxos",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><b>Temperature-compensated oscillators with tight stability (±0.1 ppm)</b></p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_5": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT5356 (±0.1 ppm Super TCXO, 1 60 MHz, -40 °C to +105 °C)",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Outstanding dynamic stability up to 105 °C; supports LVCMOS/clipped‑sine outputs</li>\n<li>Low-noise, no micro‑jumps or activity dips</li>\n<li>Ideal for RF/Wireless, 5G, automotive, precision GNSS</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_6": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
       "1717498055877"
      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT5347 / SiT5348 (±0.1 0.25 ppm, higher frequency ranges)",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Offers precision stability over wide temperature ranges</li>\n<li>Good fit for communication systems, industrial monitoring</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_7": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
