      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "SiT8944 / SiT8945 (Extended temperature -55 °C to +125 °C oscillators)",
       "type": "h4",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>LVCMOS output; designed for harsh environment reliability</li>\n<li>Frequency range from ~1 to 110 MHz depending on model</li>\n<li>Strong choice for aerospace, automotive under‑hood, industrial control</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
