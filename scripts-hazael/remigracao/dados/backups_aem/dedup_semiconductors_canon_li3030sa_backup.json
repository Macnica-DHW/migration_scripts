   }
  },
  "table_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "table_1": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<table cellpadding=\"1\" cellspacing=\"0\" border=\"1\" width=\"100%\" height=\"5%\">\r\n<tbody><tr><th>&nbsp;</th>\r\n<th>LI3030SAM</th>\r\n<th>LI3030SAI</th>\r\n</tr><tr><td height=\"10%\">Filter Types</td>\r\n<td>Monochrome</td>\r\n<td>RGB-NIR</td>\r\n</tr><tr><td>Sensitivity (e/lx/sec)</td>\r\n<td>2,900,000</td>\r\n<td>1,100,000 (Green)</td>\r\n</tr><tr><td>Sensor Size</td>\r\n<td colspan=\"2\">41.04mm x 24.32mm</td>\r\n</tr><tr><td>Number of Effective Pixels</td>\r\n<td colspan=\"2\">2160h x 1280v</td>\r\n</tr><tr><td>Pixel Size</td>\r\n<td colspan=\"2\">19µm x 19µm</td>\r\n</tr><tr><td>Scan Type</td>\r\n<td colspan=\"2\">Progressive Scan</td>\r\n</tr><tr><td>Shutter</td>\r\n<td colspan=\"2\">Rolling Shutter</td>\r\n</tr><tr><td>Maximum Frame Rate (All Pixels)</td>\r\n<td colspan=\"2\">98 fps</td>\r\n</tr><tr><td>Dark random noise</td>\r\n<td colspan=\"2\">3.4 e rms</td>\r\n</tr><tr><td>Chip Interface</td>\r\n<td colspan=\"2\">16 ch analog outputs</td>\r\n</tr></tbody></table>\r\n",
    "sling:resourceType": "macnicaglobal2/components/content/table",
    "textIsRich": "true"
   }
  },
