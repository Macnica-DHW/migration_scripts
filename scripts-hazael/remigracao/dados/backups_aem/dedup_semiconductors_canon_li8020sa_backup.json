  "text_intro_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "text_intro": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<p>Explore more possibilities in 250 MP unprecedented resolution in a compact Canon CMOS Sensor. Capturing detail 125 times greater than in full HD resolution.</p>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
  },
