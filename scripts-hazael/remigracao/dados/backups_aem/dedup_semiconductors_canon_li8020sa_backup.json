   }
  },
  "image_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "image_1": {
    "jcr:primaryType": "nt:unstructured",
    "fileReference": "/content/dam/copia-teste/americas/mai/public/en/images/products/Canon 250Mp Color_slant_0.jpg",
    "sling:resourceType": "macnicaglobal2/components/content/image"
