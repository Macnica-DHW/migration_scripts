      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Real-Time Compute and Acceleration",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera.html\" target=\"_blank\">Altera</a> FPGAs provide deterministic performance for imaging pipelines, beamforming, and video transport. <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/deepx.html\" target=\"_blank\">DEEPX</a> AI accelerators enable low-power inference for triage, workflow assist, and quality control. <a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/tq-systems.html\" target=\"_blank\">TQ</a> embedded computing platforms (SMARC, COM-Express, x86/ARM) with medical certifications to accelerate device development.</p><p style=\"margin-top:0\">&nbsp;</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "table_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th>Platform/Supplier</th>\n<th>Key Features/Advantages</th>\n<th>Example Medical Applications</th>\n</tr><tr><td width=\"33%\">Altera FPGAs</td>\n<td width=\"33%\">Deterministic performance, high-speed DSP, PCIe Gen5, HBM options</td>\n<td width=\"33%\">Ultrasound beamforming, image reconstruction, compression pipelines</td>\n</tr><tr><td>DeepX AI Accelerators</td>\n<td>Ultra-low power inference, edge-ready modules, CNN/DNN optimized</td>\n<td>Wearables, smart hospital devices, automated triage</td>\n</tr><tr><td>TQ Embedded Platforms</td>\n<td>SMARC, COM-Express, and x86/ARM boards; IEC 60601 compliance; video modules with sub-ms latency</td>\n<td>Surgical video distribution, medical imaging systems, OEM medical device compute</td>\n</tr></tbody></table>",
       "sling:resourceType": "macnicaglobal2/components/content/table",
       "textIsRich": "true",
       "cq:styleIds": [
        "",
        "",
        "1722939215525"
       ]
      }
     },
     "container_14": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
