        "image_1": {
         "jcr:primaryType": "nt:unstructured",
         "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/medical-and-healthcare-solutions/images/operating-room-digital-surgical-monitors.jpg",
         "alt": "A modern operating room with digital surgical monitors and connected equipment",
         "sling:resourceType": "macnicaglobal2/components/content/image",
         "isDecorative": "false",
         "altValueFromDAM": "false",
