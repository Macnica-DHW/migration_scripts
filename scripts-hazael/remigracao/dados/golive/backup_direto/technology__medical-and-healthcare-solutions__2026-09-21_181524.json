       "flexcontaineritem_1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Wearables and Remote Patient Monitoring",
         "type": "h3",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Empower healthcare beyond the hospital with connected, sensor-rich wearables.</p>\n<ul>\n<li>Activity, respiration, and vital signs monitoring with <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/infineon.html\">Infineon</a> sensors</li>\n</ul>\n<ul>\n<li>Secure, low-power connectivity for longer battery life</li>\n</ul>\n<ul>\n<li>Reference designs that shorten proof-of-concept cycles</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
