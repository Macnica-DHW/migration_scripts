      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "How We Engage",
       "id": "howweengage",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ol>\n<li>Discovery and requirements gathering</li>\n<li>Rapid feasibility and component selection</li>\n<li>Reference builds and design collaboration</li>\n<li>Compliance-aware design toward IEC 60601 families</li>\n<li>Pilot, scale, and supply continuity</li>\n</ol>\n<p>Bring us your imaging stack, wearable concept, or smart hospital requirement. We will help you select the right parts, assemble a reference design, and move you toward a manufacturable solution with advanced medical technology solutions..</p>\n<p><b>Contact Macnica Americas</b> to start a technical discovery session.</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
