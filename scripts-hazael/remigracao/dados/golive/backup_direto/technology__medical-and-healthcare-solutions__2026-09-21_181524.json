      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Why Macnica for Advanced Medical Technology Solutions?",
       "id": "whymacnicaformedical",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Broad supplier depth across sensors, signal chains, compute, timing, displays, and connectivity</li>\n</ul>\n<ul>\n<li>Solution design and integration support with rapid prototyping and reference builds</li>\n</ul>\n<ul>\n<li>Compliance-aware workflows and documentation support to help you design toward IEC 60601 and related requirements</li>\n</ul>\n<ul>\n<li>Collaboration with specialty design partners for medical cameras, embedded vision, and edge AI</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_5": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
       "1717498052331",
