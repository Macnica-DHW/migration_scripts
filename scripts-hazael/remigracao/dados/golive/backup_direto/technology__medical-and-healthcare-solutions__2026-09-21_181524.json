      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Proof Points",
       "id": "proofpoints",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Endoscopy, ultrasound, and surgical imaging powered by <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/canon.html\">Canon</a> and&nbsp;<a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sony-image-sensors.html\">Sony</a> sensors, <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera.html\">Altera</a> FPGAs, and <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/analog-devices.html\">Analog Devices</a> AFEs</li>\n</ul>\n<ul>\n<li>Real-time video platforms with sub-millisecond latency and compliance-ready design from <a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/tq-systems.html\">TQ</a> and Macnica</li>\n</ul>\n<ul>\n<li>Wearables and remote patient monitoring devices using <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/infineon.html\">Infineon</a> and ADI technologies</li>\n</ul>\n<ul>\n<li>Stable, MEMS-based timing solutions from <a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sitime.html\">SiTime</a> for clinical synchronization</li>\n</ul>\n<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/displays.html\">Rugged displays</a> from Macnica engineered for clinical reliability</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "container_18": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
