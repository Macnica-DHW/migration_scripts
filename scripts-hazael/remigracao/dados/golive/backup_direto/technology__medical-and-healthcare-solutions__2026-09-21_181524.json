      ],
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Solution Building Blocks",
       "id": "solutionbuildingblocks",
       "type": "h2",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "title_2": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Imaging Sensors and Modules",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sony-image-sensors.html\" target=\"_blank\" rel=\"noopener noreferrer\">Sony sensors</a> and microdisplays deliver high precision for surgical, endoscopic, and diagnostic imaging. Through partners like iENSO, we provide <a href=\"/content/macnicaglobal2/americas/mai/en/services/imaging-and-vision-engineering-services.html\">camera design services and embedded vision modules</a> optimized for medical devices.</p><p style=\"margin-top:0\">&nbsp;</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "table_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th style=\"white-space:nowrap\">Category</th>\n<th>Key Features/Technologies</th>\n<th>Example Medical Applications</th>\n</tr><tr><td width=\"33%\">CMOS Image Sensors</td>\n<td width=\"33%\">High sensitivity, low noise, global &amp; rolling shutter options</td>\n<td width=\"33%\">Endoscopy, surgical cameras, digital pathology</td>\n</tr><tr><td>UV &amp; NIR Sensors</td>\n<td>Detection beyond visible spectrum, specialized coatings</td>\n<td>Dermatology imaging, fluorescence-guided surgery, dental diagnostics</td>\n</tr><tr><td>SWIR / SenSWIR Sensors</td>\n<td>Extended wavelength capture, high quantum efficiency</td>\n<td>Ophthalmology, tissue oxygenation studies, advanced microscopy</td>\n</tr><tr><td style=\"white-space:nowrap\">Microdisplays</td>\n<td>High-resolution OLED / LCOS panels, compact form factor</td>\n<td>Ophthalmology headsets, surgical EVFs, training simulators</td>\n</tr><tr><td>Camera Modules &amp; Design</td>\n<td>Ready-to-use modules, ISP integration, partner design (iENSO)</td>\n<td>OEM medical cameras, embedded vision in wearables and devices</td>\n</tr></tbody></table>",
       "sling:resourceType": "macnicaglobal2/components/content/table",
       "textIsRich": "true",
       "cq:styleIds": [
        "",
        "",
        "1722939215525"
       ]
      }
     },
     "container_13": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
