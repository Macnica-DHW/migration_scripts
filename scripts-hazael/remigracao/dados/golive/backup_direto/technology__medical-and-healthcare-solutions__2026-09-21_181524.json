       "flexcontaineritem_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Surgical and Interventional Rooms",
         "type": "h3",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Enable real-time, ultra-low latency video and reliable synchronization for today’s hybrid operating rooms.</p>\n<ul>\n<li>High-resolution surgical video distribution in 4K and beyond</li>\n</ul>\n<ul>\n<li>Robust timing and synchronization across multi-modal equipment</li>\n</ul>\n<ul>\n<li>Options for ST 2110 over IP to enable tele-surgery workflows</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       }
      }
     },
