        "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Smart Hospital and Home Care",
         "type": "h3",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Transform clinical workflows and patient experiences with embedded and advanced healthcare technology solutions.</p>\n<ul>\n<li>Bedside and ICU monitoring systems</li>\n</ul>\n<ul>\n<li>Asset tracking and workflow analytics</li>\n</ul>\n<ul>\n<li>Reliable, disinfectant-resistant clinical displays</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       }
      }
     },
     "container_12": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "",
