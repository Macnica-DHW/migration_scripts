     "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br",
      "text": "<p><b>Location</b>: Santa Clara, California<br>\r\n<b>Start Date</b>: Tuesday, May 20, 2025<br>\r\n<b>End Date</b>: Thursday, May 22, 2025</p>\r\n",
      "jcr:lastModified": "Tue Sep 22 2026 20:47:57 GMT+0000",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "text_1_wrap": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
