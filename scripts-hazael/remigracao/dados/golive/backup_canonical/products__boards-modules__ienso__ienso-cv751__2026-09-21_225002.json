{"quando": "2026-09-21T22:50:02", "pagina": "/content/macnicaglobal2/americas/mai/en/products/boards-modules/ienso/ienso-cv751", "jcr_content": {"jcr:primaryType": "cq:PageContent", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:title": "iENSO + Macnica: CV75 SoM Design Services for Intelligent Vision at the Edge", "manufacturer": "macnica-atd-europe:manufacturers/ienso", "businessCategories": ["macnica-atd-europe:business-categories/boards-and-modules"], "productManufacturerRanking": "5", "pwaOrientation": "any", "cq:template": "/conf/macnicaglobal2/settings/wcm/templates/atd-europe-mae-product-page", "pd_isModelNameLinkToPage": "false", "jcr:created": "Wed Sep 09 2026 11:45:08 GMT+0000", "pwaDisplay": "standalone", "cq:lastModified": "Wed Sep 09 2026 11:45:08 GMT+0000", "jcr:description": "Explore the latest System on Modules (SoM) technology with iENSO products and embedded cameras at Macnica. Powerful board modules for your projects.", "pwaCachestrategy": "staleWhileRevalidate", "pageTitle": "iENSO + Macnica: CV75 SoM Design Services for Intelligent Vision at the Edge", "sling:resourceType": "macnicaglobal2/components/maeproductpage", "cq:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "navTitle": "iENSO", "root": {"jcr:primaryType": "nt:unstructured", "jcr:lastModifiedBy": "admin", "jcr:lastModified": "Thu Jan 08 2026 18:23:07 GMT+0900", "sling:resourceType": "wcm/foundation/components/responsivegrid", "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "admin", "jcr:lastModifiedBy": "admin", "jcr:created": "Thu Jan 08 2026 18:32:09 GMT+0900", "jcr:lastModified": "Thu Jan 08 2026 18:32:46 GMT+0900", "sling:resourceType": "macnicaglobal2/components/content/container", "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:02:52 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:02:52 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717410661180", "1717498052331"], "title": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": "iENSO + Macnica: CV75 SoM Design Services for Intelligent Vision at the Edge", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:03:09 GMT+0000", "type": "h1", "jcr:lastModified": "Tue Sep 01 2026 11:03:22 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:styleIds": ["", "", "", ""]}, "title_954491212": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": "Build Smarter Cameras Faster with iENSO and Macnica Tech", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:03:27 GMT+0000", "type": "h3", "jcr:lastModified": "Tue Sep 01 2026 11:03:36 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:styleIds": ["", "", "", ""]}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:03:13 GMT+0000", "text": "<p>Develop next generation vision products with iENSO’s Embedded Vision Camera Platform as a Service and Macnica’s imaging ecosystem. The jointly developed CV75 System on Module combines Ambarella AI SoCs, Sony image sensors, and production-proven design services so you can launch intelligent, connected cameras with less risk and shorter time to market.</p>\r\n<ul>\r\n<li>Ambarella CV75 AI SoC with support for CNN and transformer-based models at ultra-low power</li>\r\n<li>Sony STARVIS and STARVIS 2 sensors for high dynamic range and low-light performance</li>\r\n<li>EVPaaS platform that connects camera, edge AI, and cloud for full camera to cloud solutions</li>\r\n<li>Co-developed CV75 SoM and evaluation platform created by iENSO and Macnica Tech engineering teams</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:03:47 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "container_1504100407": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:03:58 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:04:06 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "rgb(235,235,235)", "cq:styleIds": ["1717498056876"], "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:04:13 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:04:13 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717410661180", "1717498056876"], "tabs_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:58:09 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:05:34 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/tabs", "item_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Tab 1", "cq:panelTitle": "iENSO", "layout": "responsiveGrid", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876"], "textwithimage": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ienso-imaging-solutions.png", "imageRatio": "40", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:59:24 GMT+0000", "text": "<h3>iENSO: Your Embedded Vision Camera Design Partner</h3>\r\n<p>iENSO specializes in embedded vision systems that blend camera hardware, edge AI, and cloud connectivity to help product companies turn devices into vision data platforms. Through its EVPaaS platform, iENSO provides modular Ambarella-based camera modules, SDKs, and cloud tools so customers can deploy and manage intelligent vision solutions at scale.</p>\r\n<p>&nbsp;</p>\r\n<h4>iENSO System-on-Modules Highlights:</h4>\r\n<ul>\r\n<li>Ambarella solution partner with deep experience on the CV series, including CV28, CV22, CV72, and CV75</li>\r\n<li>End-to-end camera design and customization from image sensor and optics to edge AI integration and cloud services</li>\r\n<li>EVPaaS development framework with SDKs, libraries, and debugging tools</li>\r\n<li>Flexible engagement models that support both low volume custom designs and high-volume production programs</li>\r\n</ul>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:16:46 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "cq:styleIds": ["1718154382437"], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ienso-imaging-solutions.png", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:16:46 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}}, "item_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Tab 2", "cq:panelTitle": "CV75 SoM", "layout": "responsiveGrid", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876"], "textwithimage_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/macnica-cv75.png", "imageRatio": "40", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:59:24 GMT+0000", "text": "<h3>The Joint CV75 SoM Platform</h3>\r\n<h4>Co-Developed CV75 SoM for Camera to Cloud Intelligence</h4>\r\n<p>The CV75 SoM is a production-ready, Ambarella-based platform created through the collaboration between iENSO and Macnica Tech engineering. It serves as both an evaluation kit and a foundation for custom camera design, allowing customers to move smoothly from concept to market.</p>\r\n<h4>Designing a UAV/UAS and Robotics system?</h4>\r\n<p>Learn more about the <a href=\"https://www.macnica.com/eu/atd-europe/en/solutions/cv75/\">iENSO CV75 System-on-Module</a>, an embedded vision platform integrating ISP, video encoding, and edge AI for UAV/UAS and related applications.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:17:34 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/macnica-cv75.png", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:17:34 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}, "button": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": " Learn More", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:23:18 GMT+0000", "linkURL": "https://www.macnica.com/eu/atd-europe/en/solutions/cv75/", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:23:40 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["1722936853890"]}, "title": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": "Key Features:", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:35:57 GMT+0000", "type": "h1", "jcr:lastModified": "Tue Sep 01 2026 11:36:13 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:styleIds": ["", "", "", ""]}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:35:47 GMT+0000", "text": "<ul>\r\n<li>Ambarella CV75 AI SoC with dual Arm Cortex A76 cores and CVflow AI engine</li>\r\n<li>Integrated ISP and video pipeline with 4K processing, multi-stream encoding, HDR, stabilization, and dewarping</li>\r\n<li>Optimized support for Sony STARVIS and STARVIS 2 sensors, including IMX664 and IMX678</li>\r\n<li>Connectivity options such as USB 3.2, Ethernet or PoE, Wi-Fi, BLE, SDIO, CAN FD, and expansion interfaces</li>\r\n<li>Full integration with EVPaaS for application development, cloud management, and model deployment</li>\r\n</ul>\r\n<p>A scalable camera platform built on Ambarella CV75, tuned for Sony sensors, and backed by iENSO and Macnica Tech design teams.</p>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:36:24 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "item_1786363122687": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "Eval Kits & Development Path", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876"], "textwithimage_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ienso-cv75-evk.png", "imageRatio": "40", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:59:24 GMT+0000", "text": "<h3>Evaluation Kits and Development Path</h3>\r\n<h4>From Evaluation to Production</h4>\r\n<p>The CV75 SoM is available as an evaluation kit that functions as both a demo system and a complete development environment.</p>\r\n<p><b>Two typical engagement paths:</b></p>\r\n<p><b>1. Out of the box demo</b></p>\r\n<ul>\r\n<li>Pre-loaded applications for image quality evaluation, streaming tests, and on-board AI analytics</li>\r\n<li>Quick validation of CV75 performance with Sony sensors in real world scenes</li>\r\n</ul>\r\n<p><b>2. SDK and EVPaaS development</b></p>\r\n<ul>\r\n<li>Access to the EVPaaS portal, SDK, and development tools</li>\r\n<li>Ability for engineering teams to build camera-level applications and integrate custom CNN or transformer-based models</li>\r\n<li>Engineering support packages available from iENSO and Macnica Tech to accelerate proofs of concept and integration work</li>\r\n</ul>\r\n<p>Macnica Tech and iENSO guide customers through a structured EVT to DVT to PVT and mass production path, covering supply chain planning, firmware QA, and cloud enablement.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:18:37 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "cq:styleIds": ["1718154382437"], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ienso-cv75-evk.png", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:18:37 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}}, "item_1786363141936": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "Ambarella & Sony", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876"], "textwithimage_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ambarella-cv75s.png", "imageRatio": "40", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:59:24 GMT+0000", "text": "<h3>Engineered for Sony Sensors, Driven by Ambarella AI</h3>\r\n<p>At the center of the CV75 SoM is the Ambarella CV75 AI SoC, designed for low-power, high-performance computer vision with an integrated ISP, encoder, and dedicated CVflow AI engine.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:19:29 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "cq:styleIds": ["1718154382437"], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/ambarella-cv75s.png", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:19:29 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 19:26:42 GMT+0000", "text": "<hr>\r\n\r\n", "jcr:lastModified": "Tue Sep 01 2026 19:26:52 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "textwithimage_copy_c": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "anil@anionmarketing.com", "fileReference": "/content/dam/macnicagwi/americas/mai/public/en/images/products/sony-imx664.png", "imageRatio": "40", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Mon Aug 10 2026 11:59:24 GMT+0000", "alt": "sony-imx664", "text": "<p><b>The platform is tuned for Sony STARVIS and STARVIS 2 sensors, such as:</b></p>\r\n<ul>\r\n<li>Sony IMX664, 4 MP</li>\r\n<li>Sony IMX678, 8 MP</li>\r\n</ul>\r\n<p><b>This combination delivers:</b></p>\r\n<ul>\r\n<li>Excellent low-light performance for security, access control, and outdoor scenes</li>\r\n<li>Wide dynamic range for mixed lighting</li>\r\n<li>Strong support for modern AI workflows that rely on CNNs and transformer-based reasoning</li>\r\n</ul>\r\n<p>Optional expansions include Wi-Fi modules from Infineon, memory from Micron, and thermal cores for multi-sensor fusion.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:39:42 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "false", "cq:styleIds": ["1718154328384"], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicagwi/americas/mai/public/en/images/products/sony-imx664.png", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:39:42 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}}, "item_1788260719001": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "Apps We Enable", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876"], "textwithimage": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/agritech-drone.jpg", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:19:47 GMT+0000", "text": "<h3>Applications We Enable</h3>\r\n<p>The CV75 platform and EVPaaS ecosystem are ideal when you need embedded vision with strong on-device intelligence, tight power budgets, and a path to large scale deployment.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:20:06 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "cq:styleIds": ["", "", ""], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/agritech-drone.jpg", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:20:06 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}, "title": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": "Use cases include:", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:41:40 GMT+0000", "type": "h1", "jcr:lastModified": "Tue Sep 01 2026 11:43:07 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:styleIds": ["", "", "", ""]}, "flexcontainer": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:41:46 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:41:46 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/flexcontainer", "cq:styleIds": ["1719484597737"], "flexcontaineritem": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:41:50 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:41:50 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:42:06 GMT+0000", "text": "<h4>Smart access and security</h4>\r\n<ul>\r\n<li>Video intercoms</li>\r\n<li>Smart panels with facial recognition and liveness detection</li>\r\n<li>Privacy aware access control systems</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:43:23 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "text_1234963697": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:44:09 GMT+0000", "text": "<h4><br>\r\nIndustrial and AIoT cameras</h4>\r\n<ul>\r\n<li>Vision-based safety monitoring</li>\r\n<li>Quality inspection and anomaly detection</li>\r\n<li>Logistics and smart facility visibility</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:45:56 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "text_1234963697_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:44:09 GMT+0000", "text": "<h4><br>\r\nAutomotive aftermarket, construction, and agriculture</h4>\r\n<ul>\r\n<li>Dashcams and DMS systems as part of automotive technology solutions</li>\r\n<li>Rugged outdoor cameras</li>\r\n<li>Environmental and equipment monitoring</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:46:11 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "flexcontaineritem_714545230": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:41:54 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:41:54 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "text_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:42:06 GMT+0000", "text": "<h4>UAVs</h4>\r\n<ul>\r\n<li>Low-latency video links</li>\r\n<li>Target tracking and object detection on lightweight platforms</li>\r\n<li>Multi-sensor visible and thermal payloads</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:43:44 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "text_1234963697_copy": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:44:09 GMT+0000", "text": "<h4><br>\r\nRobotics and mobile systems</h4>\r\n<ul>\r\n<li>Perception for navigation and obstacle avoidance</li>\r\n<li>Multi-camera SLAM and sensor fusion</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:46:04 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "text_1234963697_copy_2118348602": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:44:09 GMT+0000", "text": "<p><br>\r\nCustomers can begin with the standard CV75 SoM and work with iENSO and Macnica Tech to customize sensors, optics, enclosures, AI models, and cloud integration.</p>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:46:19 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}}}}}, "container_408182752": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:46:44 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:46:52 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "rgb(245,243,249)", "cq:styleIds": ["1717498056876"], "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:47:00 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:47:00 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717410661180", "1717498052331"], "title": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:title": "Why Work with iENSO and Macnica Tech?", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:47:11 GMT+0000", "type": "h1", "jcr:lastModified": "Tue Sep 01 2026 11:47:26 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:styleIds": ["", "", "", ""]}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:47:15 GMT+0000", "text": "<h3>From Component to Full Solution</h3>\r\n<p>The iENSO and Macnica Tech partnership provides everything needed for the complete camera lifecycle.</p>\r\n<p><b>Benefits include:</b></p>\r\n<ul>\r\n<li>Design services plus platform, combining iENSO’s engineering and cloud tools with Macnica Tech’s imaging ecosystem and technical support</li>\r\n<li>Faster time to market by starting from a mature Ambarella CV75 platform tuned for Sony sensors</li>\r\n<li>Lower total cost of ownership through efficient edge AI that reduces cloud load and bandwidth requirements</li>\r\n<li>Single point of accountability from system architecture to deployment and volume production</li>\r\n</ul>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:47:39 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}, "container_2036057416": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:47:48 GMT+0000", "jcr:lastModified": "Tue Sep 01 2026 11:47:48 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717410661180", "1717498052331"], "textwithimage": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/macnica-workflow-diagram.jpg", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:48:03 GMT+0000", "text": "<h2>Ready to Build Your Next Embedded Vision Product?</h2>\r\n<p>Whether you are updating an existing camera, adding vision to connected devices, or creating a new Edge AI product line, the iENSO CV75 SoM platform and Macnica Tech design services provide a fast and low risk path to success.</p>\r\n", "displayPopupTitle": "true", "linkTarget": "_self", "jcr:lastModified": "Tue Sep 01 2026 11:48:25 GMT+0000", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "true", "cq:styleIds": ["1718154382437"], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/sony/images/macnica-workflow-diagram.jpg", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:lastModified": "Tue Sep 01 2026 11:48:25 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image"}}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "venkatesh@anionmarketing.com", "jcr:lastModifiedBy": "venkatesh@anionmarketing.com", "jcr:created": "Tue Sep 01 2026 11:49:22 GMT+0000", "text": "<p>Contact Macnica today to discuss your CV75 design.</p>\r\n", "jcr:lastModified": "Tue Sep 01 2026 11:49:28 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "button": {"jcr:primaryType"