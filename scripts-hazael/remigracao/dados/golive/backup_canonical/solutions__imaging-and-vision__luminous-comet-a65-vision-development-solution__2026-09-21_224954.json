{"quando": "2026-09-21T22:49:54", "pagina": "/content/macnicaglobal2/americas/mai/en/solutions/imaging-and-vision/luminous-comet-a65-vision-development-solution", "jcr_content": {"jcr:primaryType": "cq:PageContent", "jcr:mixinTypes": ["mix:versionable"], "jcr:createdBy": "valter.toffolo@macnicadhw.com.br", "jcr:title": "Macnica Vision Development Solution (Luminous Platform + Terasic Comet A65 SOM EVK)", "manufacturer": "mai:manufacturers/macnica-products", "businessCategories": ["mai:business-categories/imaging-vision-solutions"], "jcr:versionHistory": "85e5dfed-c2c7-4760-b0b9-e22f1817be2f", "cq:template": "/conf/macnicaglobal2/settings/wcm/templates/mai-mae-product-page", "pd_modelName": "Macnica Vision Development Solution (Luminous Platform + Terasic Comet A65 SOM EVK)", "pd_isModelNameLinkToPage": "true", "jcr:predecessors": ["660bca27-5dda-45b7-82e7-e74d21fd05ec"], "jcr:created": "Mon Sep 21 2026 20:58:16 GMT+0000", "cq:lastModified": "Mon Sep 21 2026 21:16:14 GMT+0000", "jcr:description": "The Macnica Vision Development Solution using Macnica Luminous Platform and Terasic Comet A65 EVK is a reference design for high performance machine vision products using Sony’s image sensors, SLVS-EC interface IP core and Altera Agilex 5E FPGA.", "keywords": "macnica, macnica products, imaging and vision, luminous evm, dev kit, altera, agilex, fpga, evk, machine vision, image sensor, sony image sensors", "jcr:baseVersion": "660bca27-5dda-45b7-82e7-e74d21fd05ec", "jcr:isCheckedOut": true, "pageTitle": "Macnica Vision Development Solution (Luminous Platform + Terasic Comet A65 SOM EVK)", "cq:tags": ["mai:business-categories/imaging-vision-solutions"], "jcr:uuid": "0d42d503-d49f-4a0b-84ae-59df15605770", "sling:resourceType": "macnicaglobal2/components/maeproductpage", "cq:lastModifiedBy": "valter.toffolo@macnicadhw.com.br", "navTitle": "Macnica Vision Development Solution (Luminous Platform + Terasic Comet A65 SOM EVK)", "manufacturerlogo": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/imaging-and-vision/logos/macnica-brand-logo-rgb-1.png", "alt": "Macnica logo", "sling:resourceType": "core/wcm/components/image/v3/image"}, "root": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "wcm/foundation/components/responsivegrid", "container": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "container_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331"], "title_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/title"}, "image_1": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/imaging-and-vision/images/macnica-luminous-imx901.png", "alt": "Macnica Luminous IMX901", "sling:resourceType": "macnicaglobal2/components/content/image", "isDecorative": "false", "altValueFromDAM": "false"}}, "container_2": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498056876"], "container_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Accelerate High-Performance Machine Vision Development", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "title_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "A ready-to-evaluate reference design combining Sony industrial image sensors, Macnica SLVS-EC RX IP, and the Terasic Comet A65 EVK powered by Altera Agilex™ 5E FPGA.", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p>The Macnica Vision Development Solution using Macnica Luminous Platform and Terasic Comet A65 EVK is a reference design for high performance machine vision products using Sony’s image sensor, SLVS-EC interface IP core and Altera Agilex 5E FPGA.</p>\n<p>This solution is an ideal starting point for developers who design high end products requiring high performance vision system, edge AI computing, sensor integration and high-speed communication.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "container_2": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Solutions", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "flexcontainer_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontainer", "cq:styleIds": ["", "1719484596357"], "flexcontaineritem_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Capture", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p>Macnica <a rel=\"noopener noreferrer\" target=\"_self\" href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/mpression/luminous-platform\">Luminous Sony IMX537 &amp; IMX901 industrial image sensor boards</a> with C/CS lens support.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "flexcontaineritem_2": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Process", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/terasic/terasic-comet-a65-som\" target=\"_self\">Terasic Comet A65 SOM EVK</a> with Altera Agilex™ 5E FPGA, ARM processors, memory, PCIe Gen4, and high-speed interfaces.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "flexcontaineritem_3": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Communicate", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p>Macnica <a href=\"/content/macnicaglobal2/americas/mai/en/products/ip-software/slvs-ec-3-rx-ip/\" target=\"_self\" rel=\"noopener noreferrer\">SLVS-EC 3.1 RX IP</a> enables high-speed sensor-to-FPGA image data transfer.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}}, "container_3": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "System Diagram", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "title_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Reference Design: SLVS-EC Receiver to HDMI Transmitter", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "image_1": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/imaging-and-vision/images/luminous-imx537-kit-diagram.png", "alt": "Macnica Luminous IMX901", "sling:resourceType": "macnicaglobal2/components/content/image", "isDecorative": "false", "altValueFromDAM": "false"}}, "container_4": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "flexcontainer_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontainer", "cq:styleIds": ["", "1719484596357"], "flexcontaineritem_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Target Applications", "type": "h4", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<ul>\n<li>Machine vision cameras</li>\n<li>Edge AI vision systems</li>\n<li>Robotics and AMR vision</li>\n<li>Industrial inspection</li>\n<li>Medical imaging devices</li>\n<li>High-speed sensor evaluation</li>\n<li>FPGA-based image processing</li>\n</ul>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "flexcontaineritem_2": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Platform Modules", "type": "h4", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<ul>\n<li>Lens housing</li>\n<li>Sensor board</li>\n<li>High-speed SLVS-EC cable</li>\n<li>Optional FMC card (not needed for connection with Comet A65 SOM Kit)</li>\n<li>FPGA development kit (<a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/terasic/terasic-comet-a65-som\" target=\"_self\">Terasic Comet A65 SOM Kit</a>)</li>\n</ul>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}}, "container_5": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "image_1": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/imaging-and-vision/images/platform-modules-sensor-boards.png", "alt": "Macnica Luminous IMX901", "sling:resourceType": "macnicaglobal2/components/content/image", "isDecorative": "false", "altValueFromDAM": "false"}}, "container_6": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Sensor Board Comparison", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "table_1": {"jcr:primaryType": "nt:unstructured", "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th>Sensor EVM</th>\n<th style=\"white-space:nowrap\">Sensor</th>\n<th style=\"white-space:nowrap\">Interface</th>\n</tr><tr><td>Luminous IMX537</td>\n<td>Sony IMX537</td>\n<td>SLVS-EC v2.0 x8 lanes, 4.752 Gbps/lane</td>\n</tr><tr><td>Luminous IMX901</td>\n<td>Sony IMX901</td>\n<td>SLVS-EC v3.0 x4 lanes, 9.504 Gbps/lane</td>\n</tr></tbody></table>", "sling:resourceType": "macnicaglobal2/components/content/table", "textIsRich": "true", "cq:styleIds": ["", "", "1722939215525"]}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p style=\"margin-top:0\">&nbsp;</p><p style=\"text-align: left;\">For more details, please visit <a rel=\"noopener noreferrer\" href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/mpression/luminous-platform.html#tabs-714516391e-item-18a581a37a-tab\" target=\"_blank\">the Luminous Platform page</a>.&nbsp;</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "container_7": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Comet A65 EVK", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "flexcontainer_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontainer", "cq:styleIds": ["", "1719484596357"], "flexcontaineritem_1": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Highlights:", "type": "h3", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<ul>\n<li>Altera Agilex™ 5 FPGA E-Series SOM</li>\n<li>HDMI 1.4</li>\n<li>MIPI CSI-2 and SLVS-EC camera interfaces</li>\n<li>1GbE, 2.5GbE, 10/40GbE</li>\n<li>PCIe Gen 4.0 x4</li>\n<li>USB Type-C, microSD, GPIO</li>\n</ul>\n<p>For more details, please visit <a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/terasic/terasic-comet-a65-som.html\">Terasic Comet A65 EVK page</a>.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "flexcontaineritem_2": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "image_1": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/imaging-and-vision/images/comet-a65-evk.png", "alt": "Comet A65 EVK board", "sling:resourceType": "macnicaglobal2/components/content/image", "isDecorative": "false", "altValueFromDAM": "false", "cq:styleIds": ["", "1726800547211"]}}}}, "container_8": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Resources", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/sony/sony-image-sensors\" target=\"_self\" rel=\"noopener noreferrer\">Sony image sensors</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/ip-software/slvs-ec-3-rx-ip.html\" target=\"_self\" rel=\"noopener noreferrer\">SLVS-EC 3.1 RX IP</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/services/imaging-and-vision-engineering-services.html\" target=\"_self\" rel=\"noopener noreferrer\">Imaging &amp; Vision Product Design Services</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/terasic/terasic-comet-a65-som.html\" target=\"_self\" rel=\"noopener noreferrer\">Altera Agilex 5 / Terasic development platforms</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products//boards-modules/mpression/luminous-platform\" target=\"_self\" rel=\"noopener noreferrer\">Luminous Platform page</a></li>\n</ul>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "container_9": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "title_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Support", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "image_1": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/technology/artificial-intelligence-of-things-aiot/images/macnica-workflow-diagram.jpg", "alt": "Macnica workflow diagram", "sling:resourceType": "macnicaglobal2/components/content/image", "isDecorative": "false", "altValueFromDAM": "false"}}, "container_10": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["", "1717498052331", "1717498055877"], "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p>From sensor selection to FPGA implementation, Macnica helps customers reduce vision system development risk through image sensor expertise, SLVS-EC IP, FPGA design support, and ecosystem partner solutions.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "experiencefragment_1": {"jcr:primaryType": "nt:unstructured", "fragmentVariationPath": "/content/experience-fragments/macnicaglobal2/americas/mai/en/site/products-contact-block/master", "sling:resourceType": "macnicaglobal2/components/content/experiencefragment"}}}}}}}