       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\r\n<li><b>Mounting</b> with adhesive to planar surfaces, usable in tension, compression, or shear orientations.</li>\r\n</ul>\r\n<ul>\r\n<li><b>Outputs</b> can be digital or analog depending on model and design approach.</li>\r\n</ul>\r\n<ul>\r\n<li><b>Calibration note</b> outputs are not factory calibrated. Perform one-time calibration during installation, then verify periodically to manage drift.</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
