   "section_3_wrap": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "macnicaglobal2/components/content/container",
    "cq:styleIds": [
     "1717498053499",
     "1717498052331"
    ],
    "heading_1": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:title": "What you can build with STREAL",
     "type": "h2",
     "sling:resourceType": "macnicaglobal2/components/content/title"
    },
    "text_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<ul>\r\n<li><b>Predictive machining quality</b><br>\r\nDetect subtle force changes that vibration sensors miss, reduce scrap, and prevent unplanned downtime</li>\r\n</ul>\r\n<ul>\r\n<li><b>Collaborative and industrial robots</b><br>\r\nAdd joint or gripper force feedback for safer interaction and precise pick and place</li>\r\n</ul>\r\n<ul>\r\n<li><b>Structural and asset monitoring</b><br>\r\nBond sensors to frames, tanks, or press dies and stream data to dashboards for condition-based maintenance</li>\r\n</ul>\r\n<ul>\r\n<li><b>Micromobility systems</b><br>\r\nMeasure pedal torque or suspension loads within tight power budgets for natural assist and system health monitoring</li>\r\n</ul>",
     "sling:resourceType": "macnicaglobal2/components/content/text",
     "textIsRich": "true"
    }
   },
   "section_4_wrap": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "macnicaglobal2/components/content/container",
    "cq:styleIds": [
     "1717498053499",
     "1717498052331"
    ],
    "heading_1": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:title": "Real-Time Force Insight for Robots and AMRs",
     "type": "h2",
     "sling:resourceType": "macnicaglobal2/components/content/title"
    },
    "text_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<p>With ultra-compact, high-resolution industrial strain sensors, STREAL gives robots and AMRs direct visibility into internal forces for smoother motion and safer interaction.</p>",
     "sling:resourceType": "macnicaglobal2/components/content/text",
     "textIsRich": "true"
    },
