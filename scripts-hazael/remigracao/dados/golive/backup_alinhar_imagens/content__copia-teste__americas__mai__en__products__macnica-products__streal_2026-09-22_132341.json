       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_1_846133068": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\r\n<li><b>Resolution range:</b> 0.1 to 1 µε</li>\r\n</ul>\r\n<ul>\r\n<li><b>Sensor formats:</b> compact silicon die and slim modules</li>\r\n</ul>\r\n<ul>\r\n<li><b>Typical module length:</b> under 66 mm</li>\r\n</ul>\r\n<ul>\r\n<li><b>Power:</b> from milliwatts on low power devices to tens of milliwatts on high precision devices</li>\r\n</ul>\r\n<ul>\r\n<li><b>Primary use cases:</b> robotics, machining, micromobility, structural monitoring</li>\r\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     }
    }
   },
