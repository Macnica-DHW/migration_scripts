        "jcr:title": "Optimized for low-power IoT",
        "type": "h3",
        "sling:resourceType": "macnicaglobal2/components/content/title"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\r\n<li><b>Resolution:</b> 1 µε</li>\r\n<li><b>Signal bandwidth:</b> 1.3 kHz</li>\r\n<li><b>Typical power:</b> ≤ 3 mW</li>\r\n<li><b>Die size:</b> 2.5 mm × 2.5 mm</li>\r\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
