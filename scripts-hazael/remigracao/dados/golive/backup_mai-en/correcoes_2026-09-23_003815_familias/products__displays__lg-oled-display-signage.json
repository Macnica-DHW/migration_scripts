    },
    "table_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<table cellpadding=\"0\" cellspacing=\"0\" border=\"1\" width=\"100%\">\r\n<tbody><tr><th>Part Number</th>\r\n<th>Size</th>\r\n<th>Resolution</th>\r\n<th>Brightness</th>\r\n<th>Technology</th>\r\n<th>Temperature</th>\r\n</tr><tr><td>48.0&quot; OLED UHD</td>\r\n<td>48&quot;</td>\r\n<td>3840 x 2160</td>\r\n<td>135</td>\r\n<td>OLED</td>\r\n<td>0 to 45</td>\r\n</tr><tr><td>55.0&quot; T-OLED FHD</td>\r\n<td>55&quot;</td>\r\n<td>1920 x 1080</td>\r\n<td>150</td>\r\n<td>T-OLED</td>\r\n<td>0 to 45</td>\r\n</tr><tr><td>55.0&quot; OLED FHD</td>\r\n<td>55&quot;</td>\r\n<td>1920 x 1080</td>\r\n<td>150</td>\r\n<td>OLED</td>\r\n<td>0 to 45</td>\r\n</tr><tr><td>65.0&quot; OLED UHD</td>\r\n<td>65&quot;</td>\r\n<td>3840 x 2160</td>\r\n<td>150</td>\r\n<td>OLED</td>\r\n<td>0 to 45</td>\r\n</tr><tr><td>77.0&quot; OLED UHD</td>\r\n<td>77&quot;</td>\r\n<td>3840 x 2160</td>\r\n<td>150</td>\r\n<td>OLED</td>\r\n<td>0 to 45</td>\r\n</tr><tr><td>AIO553</td>\r\n<td>55&quot;</td>\r\n<td>1920 x 1080</td>\r\n<td>150</td>\r\n<td>T-OLED Monitor</td>\r\n<td>0 to 40</td>\r\n</tr><tr><td>AIO553-T</td>\r\n<td>55&quot;</td>\r\n<td>1920 x 1080</td>\r\n<td>150</td>\r\n<td>T-OLED Monitor with Touch Screen</td>\r\n<td>0 to 40</td>\r\n</tr></tbody></table>\r\n",
