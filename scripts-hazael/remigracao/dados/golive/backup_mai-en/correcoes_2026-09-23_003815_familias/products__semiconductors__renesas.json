     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Microcontrollers/Processors",
      "id": "3",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>We offer a wide variety of microcontrollers and processors, from 8-bit low-power microcontrollers to 64-bit AI processors, including proprietary cores, ARM cores, and RISC-V.</p>\n<p style=\"margin-top:0\"><br>\nA wide range of memory, pin count and peripheral options are available to suit any application.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
