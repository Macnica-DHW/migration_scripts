      ],
      "flexcontaineritem_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\n<li>Clock</li>\n<li>Sensor</li>\n<li>Memory</li>\n<li>OpticaOptical</li>\n<li>RF</li>\n<li>CMIC (GreenPAK)</li>\n<li>CMIC (ForgeFPGA)</li>\n<li>Load Switch (GFET)</li>\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<ul>\n<li>Wireless</li>\n<li>Audio Codec</li>\n<li>Video (VSP, AHL)</li>\n<li>Haptics</li>\n<li>Interface (RS485)</li>\n<li>Photocupler</li>\n<li>OPAMP</li>\n</ul>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
