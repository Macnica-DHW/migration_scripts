     "flexcontainer_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "",
       "1719484596357"
      ],
      "flexcontaineritem_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-digital-multiphase.jpg",
        "alt": "Digital Multiphase",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">Digital Multiphase</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Computing power products extensively verified in customer designs, with fast load transient response, precise current balance, and excellent stability.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-usb-pd.jpg",
        "alt": "BMS (USB PD, Charger, FGIC)",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">BMS (USB PD, Charger, FGIC)</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">As of Fall 2024, demand for USB PD is accelerating around the world, and Renesas' products are able to provide solutions that comply with this standard.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_3": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-discrete-power.jpg",
        "alt": "Discrete Power",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">Discrete Power</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">Due to their advanced technology and high reliability, Renesas MOSFETs have an overwhelming share of the market in both the industrial and automotive fields and continue to support powertrains around the world.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_4": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-gate-driver.jpg",
        "alt": "Gate Driver",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">Gate Driver</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">Renesas' half-bridge, full-bridge, low-side, and synchronous buck MOSFET drivers can handle up to 100V, with industry-leading gate rise and fall times.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
