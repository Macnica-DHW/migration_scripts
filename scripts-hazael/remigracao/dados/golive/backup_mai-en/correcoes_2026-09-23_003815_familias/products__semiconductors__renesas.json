      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>We offer a wide range of products from general-purpose products to automotive-compatible products, supporting high-speed load response, low self-consumption current, high power density, high efficiency, and reduced external components.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_2": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "",
      "1717498052331",
      "1717498055877"
     ],
     "flexcontainer_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
      "cq:styleIds": [
       "",
       "1719484596357"
      ],
      "flexcontaineritem_1": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-ac-dc.jpg",
        "alt": "AC/DC",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">AC/DC</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">We provide a wide range of products worldwide, from general-purpose/small-sized power supplies under 75W to special topologies that configure kW-class power supplies.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_2": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-dc-dc.jpg",
        "alt": "DC/DC",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px;\">DC/DC</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">Renesas offers a wide lineup ranging from low voltage products for 5V lines to medium to high voltage products that can be used on 12V, 24V, and 48V lines.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_3": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-ldo.jpg",
        "alt": "LDOs",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">LDOs</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">Renesas offers a wide range of single and dual LDOs with the following features: high PSRR, low noise LDO, maximum 3A high current LDO, and high-voltage LDO capable of inputting up to 40V.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      },
      "flexcontaineritem_4": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
       "image_1": {
        "jcr:primaryType": "nt:unstructured",
        "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-pmic.jpg",
        "alt": "PMIC",
        "sling:resourceType": "macnicaglobal2/components/content/image",
        "isDecorative": "false",
        "altValueFromDAM": "false"
       },
       "text_1": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">PMIC</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">Renesas offers a lineup of SYSTEM PMICs that supply power to the main power supply system, and SUB PMICs that supply power to SoCs, CPUs, and GPUs.</p>",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       }
      }
     }
    },
    "container_3": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
