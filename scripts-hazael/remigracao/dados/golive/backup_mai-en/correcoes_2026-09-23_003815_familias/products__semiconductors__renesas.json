   "container_5": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "macnicaglobal2/components/content/container",
    "cq:styleIds": [
     "",
     "1717498052331"
    ],
    "title_1": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:title": "Renesas Automotive Microcontrollers/Processors",
     "id": "2",
     "type": "h2",
     "sling:resourceType": "macnicaglobal2/components/content/title"
    },
    "text_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<p>We provide automotive microcontroller products that combine high-speed processing with low power consumption, as well as processor products that support automotive applications such as autonomous driving.</p>\n<p>Equipped with functional safety and security features, our Renesas products have a proven track record of widespread adoption in <a href=\"/content/macnicaglobal2/americas/mai/en/services/automotive.html\">automotive technology solutions</a>.</p>",
     "sling:resourceType": "macnicaglobal2/components/content/text",
     "textIsRich": "true"
    }
   },
   "container_6": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "macnicaglobal2/components/content/container",
    "flexcontainer_1": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
     "cq:styleIds": [
      "",
      "1719484596357"
     ],
     "flexcontaineritem_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "image_1": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-rl78-f12.jpg",
       "alt": "Automotive MCU FL78/F Series",
       "sling:resourceType": "macnicaglobal2/components/content/image",
       "isDecorative": "false",
       "altValueFromDAM": "false"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3 style=\"margin-left: 40.0px;\">Automotive MCU RL78/F Series</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">The RL78/Fx series microcontrollers are a family of 16-bit microcontrollers for automotive applications that combine low power consumption with high performance.</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "flexcontaineritem_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "image_1": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-rh850.jpg",
       "alt": "Automotive MCU RH850 Series",
       "sling:resourceType": "macnicaglobal2/components/content/image",
       "isDecorative": "false",
       "altValueFromDAM": "false"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3 style=\"margin-left: 40.0px;\">Automotive MCU RH850 Series</h3>\n<p style=\"margin-top:0;margin-left: 40.0px;\">The RH850 family is a high-performance, low-power, high-quality 32-bit microcontroller for automotive use.</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "flexcontaineritem_3": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "image_1": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/renesas/images/renesas-r-car.jpg",
       "alt": "In-vehicle MPU R-Car Series",
       "sling:resourceType": "macnicaglobal2/components/content/image",
       "isDecorative": "false",
       "altValueFromDAM": "false"
      },
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3 style=\"margin-left: 40.0px; text-align: left;\">In-vehicle MPU R-Car Series</h3>\n<p style=\"margin-top:0;margin-left: 40.0px; text-align: left;\">The R-Car family of automotive SoCs are intelligent devices designed for applications such as Autonomous (AD/ADAS), Connected (Car Server/CoGW), and Cockpit (IVI/Cluster).</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     }
    }
   },
