    },
    "text_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<p>With a wide range of Renesas products in our portfolio, we provide optimal solutions to solve our customers' problems.</p>",
     "sling:resourceType": "macnicaglobal2/components/content/text",
     "textIsRich": "true"
    }
   },
