     "flexcontaineritem_2": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><b>Renesas Electronics Corporation</b> offers a wide variety of cutting-edge technologies and embedded solutions that combine high-performance analog, power, and sensor products centered on microcontrollers, which have the world's top-class market share, in the automotive, industrial, infrastructure, and IoT fields. We provide for customer base and end market support for Renesas automotive microcontrollers &amp; products.</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     }
    }
   },
