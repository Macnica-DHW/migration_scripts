     "item_2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Tab 2",
      "cq:panelTitle": "Automated Optical Inspection (AOI)",
      "layout": "responsiveGrid",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "1717498056876",
       "1717498055877"
