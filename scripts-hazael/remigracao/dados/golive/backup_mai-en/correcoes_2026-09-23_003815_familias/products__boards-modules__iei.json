     "item_1787868073385": {
      "jcr:primaryType": "nt:unstructured",
      "cq:panelTitle": "Building Automation",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "1717498056876",
       "1717498055877"
      ],
      "textwithimage": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Building Automation.png",
       "imageRatio": "40",
       "alt": "Building Automation",
       "text": "<p>iVEC streamlines hardware management for building automation by consolidating multiple edge computers, optimizing resource use and saving space. With virtual machines and features like remote management, remote desktop, and disaster recovery, iVEC offers enhanced control and troubleshooting capabilities, making it an ideal solution for dynamic building automation needs.</p>",
       "displayPopupTitle": "true",
       "linkTarget": "_self",
       "titleValueFromDAM": "true",
