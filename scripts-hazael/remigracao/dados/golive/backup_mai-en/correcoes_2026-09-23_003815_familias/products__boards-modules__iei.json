     "item_1787868062411": {
      "jcr:primaryType": "nt:unstructured",
      "cq:panelTitle": "Industrial IoT",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "1717498056876",
       "1717498055877"
      ],
      "textwithimage": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Industrial IoT.jpg",
       "imageRatio": "40",
       "alt": "INDUSTRIAL IOT",
       "text": "<p>iVEC stands as an optimal edge server in IIoT environments, renowned for its unparalleled flexibility and storage expandability. Tailored to meet diverse IIoT protocol requirements, iVEC leverages Intel® TCC &amp;TSN to deliver heightened real-time performance. This empowers seamless, dynamic expansion of IOT data through networked storage, ensuring a robust and efficient solution for industrial environments.</p>",
       "displayPopupTitle": "true",
       "linkTarget": "_self",
       "titleValueFromDAM": "true",
       "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
