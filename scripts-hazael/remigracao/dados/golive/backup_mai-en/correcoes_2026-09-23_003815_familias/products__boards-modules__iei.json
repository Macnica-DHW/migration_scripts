      "textwithimage": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Automated Optical Inspection (AOI).png",
       "imageRatio": "40",
       "alt": "Automated Optical Inspection (AOI)",
       "text": "<p>iVEC revolutionizes Automated Optical Inspection (AOI) with cutting-edge features. Leveraging the advanced capabilities of its 13th Gen Intel® Core™ CPUs, iVEC enhances computing power, particularly for AI tasks, through its integrated GPU. This not only reduces the need for additional GPU investments but also enables dynamic GPU resource allocation, providing a seamless solution for streamlined remote workload management and added convenience.</p>",
       "displayPopupTitle": "true",
       "linkTarget": "_self",
       "titleValueFromDAM": "true",
       "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
