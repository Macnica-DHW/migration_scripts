     "item_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Tab 1",
      "cq:panelTitle": "Digital Transformation",
      "layout": "responsiveGrid",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "cq:styleIds": [
       "1717498056876",
