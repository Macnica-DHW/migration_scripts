      "textwithimage": {
       "jcr:primaryType": "nt:unstructured",
       "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Digital Transformation.png",
       "imageRatio": "40",
       "alt": "IEI iVEC Digital Transformation",
       "text": "<p>iVEC empowers industries by seamlessly separating hardware and applications, facilitating trouble-free hardware updates without disrupting critical operations. The act of decoupling software from hardware not only streamlines the process of platform upgrades or transitions but also significantly reduces the financial and technical burdens typically associated with such endeavors. Elevate your business into the future with iVEC's innovative approach to digital transformation.</p>\r\n<p>&nbsp;</p>\r\n",
       "displayPopupTitle": "true",
