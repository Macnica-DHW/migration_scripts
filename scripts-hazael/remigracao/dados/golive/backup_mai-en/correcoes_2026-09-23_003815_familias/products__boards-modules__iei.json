     "flexcontaineritem_45562908": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "text": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3>Product Application - The IEI Virtualization Edge Computer (iVEC)</h3>\r\n<p><b>The IEI Virtualization Edge Computer (iVEC)</b> revolutionizes industrial applications by seamlessly integrating virtualization with powerful hardware, offering remote desktop accessibility for OT professionals. This transformative solution enables multiple industrial applications to run efficiently on a single physical machine, streamlining device management and optimizing hardware utilization for edge AI workloads. iVEC supports flexible workload distribution, scalable infrastructure, and remote maintenance, empowering organizations to enhance efficiency, reduce costs, and embrace the future of edge computing. With features such as software-defined networking, remote<b> </b>system<b> </b>restoration, and AI acceleration engine integration, iVEC drives Industry 4.0 agility, fostering innovation and elevating operational performance for enterprises.</p>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     }
    }
   },
