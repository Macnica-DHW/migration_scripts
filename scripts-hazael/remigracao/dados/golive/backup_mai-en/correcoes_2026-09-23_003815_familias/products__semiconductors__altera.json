        "1717498055877"
       ],
       "container_1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Overview",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Altera and its partners offer a broad selection of FPGA development kits and boards to accelerate prototyping and evaluation. Macnica helps you pick the right kit for your I/O, memory, and performance goals, then supports evaluation through pilot and production planning.</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "container_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "flexcontainer_1": {
         "jcr:primaryType": "nt:unstructured",
         "sling:resourceType": "macnicaglobal2/components/content/flexcontainer",
         "cq:styleIds": [
          "",
          "1719484596357"
         ],
         "flexcontaineritem_1": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
          "text_1": {
           "jcr:primaryType": "nt:unstructured",
           "text": "<p><b>High-Performance Kits</b></p>\n<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/agilex/altera-agilex-9-fpga-and-soc-overview.html\" target=\"_self\">Agilex 9</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/agilex/altera-agilex-7-fpga-and-soc-overview.html\" target=\"_self\">Agilex 7</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-stratix-10.html\" target=\"_self\">Stratix 10</a></li>\n</ul>",
           "sling:resourceType": "macnicaglobal2/components/content/text",
           "textIsRich": "true"
          }
         },
         "flexcontaineritem_2": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
          "text_1": {
           "jcr:primaryType": "nt:unstructured",
           "text": "<p><b>Mid-Range Kits</b></p>\n<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/agilex/altera-agilex-5-fpga-and-soc-overview.html\" target=\"_self\">Agilex 5</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-arria-10/altera-arria-10-gt-soc-fpga.html\" target=\"_self\">Arria GT</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-arria-10/altera-arria-10-sx-soc-fpga.html\" target=\"_self\">Arria SX</a></li>\n</ul>",
           "sling:resourceType": "macnicaglobal2/components/content/text",
           "textIsRich": "true"
          }
         },
         "flexcontaineritem_3": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
          "text_1": {
           "jcr:primaryType": "nt:unstructured",
           "text": "<p><b>Power and Cost-Optimized Kits</b></p>\n<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/agilex/agilex-3-fpga-and-soc-overview.html\" target=\"_self\">Agilex 3</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-max-10.html\" target=\"_self\">MAX 10, MAX V</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-cyclone-10-fpga.html\" target=\"_self\">Cyclone 10, Cyclone V, Cyclone IV</a></li>\n</ul>",
           "sling:resourceType": "macnicaglobal2/components/content/text",
           "textIsRich": "true"
          }
         }
        }
       },
       "container_3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "What teams use development kits for",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li><b>Bring-up and validation:</b>&nbsp;Confirm transceivers, PCIe, Ethernet, memory, and board-level behavior</li>\n<li><b>Rapid proof-of-concept:</b>&nbsp;Demonstrate performance, latency, or interface compatibility</li>\n<li><b>Software and firmware enablement:</b>&nbsp;Embedded tooling workflows and integration paths</li>\n<li><b>Production planning:</b>&nbsp;De-risk the path from kit to production hardware</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "container_4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Why Macnica?",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<ul>\n<li>Kit selection guidance based on required I/O, memory, expansion, and performance tier</li>\n<li>Recommendation of accessories and setup practices to speed lab bring-up</li>\n<li>Path planning from evaluation platform to production hardware, including supply continuity</li>\n<li>Engineering guidance to integrate third-party IP and reference designs with your kit</li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       }
      },
      "item_4": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Enablement and Training",
       "cq:panelTitle": "Enablement and Training",
       "layout": "responsiveGrid",
       "sling:resourceType": "macnicaglobal2/components/content/container",
       "cq:styleIds": [
        "",
        "1717498056876",
        "1717498055877"
       ],
       "container_1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Accelerate SoC bring-up and system integration",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Macnica offers hands-on enablement options and workshops that help teams build confidence in SoC and system workflows, especially when integrating custom peripherals and power considerations.</p>\n<ul>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/1-vworkshop-altera-soc-introduction.html\" target=\"_self\">Altera SoC Introduction vWorkshop</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/5-altera-soc-power-considerations.html\" target=\"_self\">Altera SoC Power Considerations Workshop</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/3-adding-and-simulating-custom-soc-peripherals.html\" target=\"_self\">Custom SoC Peripherals vWorkshop</a></li>\n<li><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/altera/altera-soc-courses.html\" target=\"_self\">Altera SoC Training Courses Online</a></li>\n</ul>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
       "container_2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Featured Resources and Next Steps",
         "type": "h3",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "title_2": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "Let’s align the device, tools, and kit to your application",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>If you share your performance targets, key interfaces, and deployment environment, Macnica can recommend an Altera device family, the right development software stack, and a development kit that matches your bring-up plan.</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        },
