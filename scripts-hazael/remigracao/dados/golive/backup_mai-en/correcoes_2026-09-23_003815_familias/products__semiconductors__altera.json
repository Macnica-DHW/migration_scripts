       "container_3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "macnicaglobal2/components/content/container",
        "cq:styleIds": [
         "",
         "1717498052331",
         "1717498055877"
        ],
        "title_1": {
         "jcr:primaryType": "nt:unstructured",
         "jcr:title": "From Components to Complete Solutions",
         "type": "h4",
         "sling:resourceType": "macnicaglobal2/components/content/title"
        },
        "text_1": {
         "jcr:primaryType": "nt:unstructured",
         "text": "<p>Macnica Americas delivers more than distribution. We help robotics innovators integrate complex technologies into practical, production-ready systems. Our global engineering teams provide architecture guidance, reference designs, and evaluation kits that accelerate design cycles and reduce risk.</p>",
         "sling:resourceType": "macnicaglobal2/components/content/text",
         "textIsRich": "true"
        }
       },
