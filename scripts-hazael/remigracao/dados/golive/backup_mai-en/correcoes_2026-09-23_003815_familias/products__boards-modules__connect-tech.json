       "table_1693902924": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th style=\"text-align: center;\">Product</th>\r\n<th style=\"text-align: center;\">Focus</th>\r\n<th style=\"text-align: center;\">Camera I/O</th>\r\n<th style=\"text-align: center;\">Networking</th>\r\n<th style=\"text-align: center;\">Expansion and notes</th>\r\n</tr><tr><td style=\"text-align: center;\">Hadron-DM</td>\r\n<td style=\"text-align: center;\">Ultra-small, rugged</td>\r\n<td style=\"text-align: center;\">Dual MIPI CSI-2</td>\r\n<td style=\"text-align: center;\">1 × GbE</td>\r\n<td style=\"text-align: center;\">Compact SODIMM-class carrier</td>\r\n</tr><tr><td style=\"text-align: center;\">Super Hadron-DM</td>\r\n<td style=\"text-align: center;\">Ultra-small with Super Mode</td>\r\n<td style=\"text-align: center;\">2 × 4-lane MIPI</td>\r\n<td style=\"text-align: center;\">1 × GbE</td>\r\n<td style=\"text-align: center;\">Adds Super Mode, M.2 NVMe 2242</td>\r\n</tr><tr><td style=\"text-align: center;\">Lepton</td>\r\n<td style=\"text-align: center;\">FPD-Link III hub</td>\r\n<td style=\"text-align: center;\">4 × FPD-Link III</td>\r\n<td style=\"text-align: center;\">Dual GbE</td>\r\n<td style=\"text-align: center;\">4 × USB 3.0, HDMI, NVMe and M.2</td>\r\n</tr><tr><td style=\"text-align: center;\">Boson-22</td>\r\n<td style=\"text-align: center;\">Compact vision carrier</td>\r\n<td style=\"text-align: center;\">4 × 22-pin MIPI</td>\r\n<td style=\"text-align: center;\">Dual GbE</td>\r\n<td style=\"text-align: center;\">Dual USB, NVMe, 9–36 V input</td>\r\n</tr></tbody></table>\r\n",
