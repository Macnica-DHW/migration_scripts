     "item_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Tab 1",
      "cq:panelTitle": "NVIDIA Jetson",
      "layout": "responsiveGrid",
      "sling:resourceType": "macnicaglobal2/components/content/container",
      "text": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/connect-tech/gauntlet-carrier-for-nvidia-jetson-thor/\">NVIDIA Jetson Thor</a></h3>\r\n<p><b>Carrier Boards: </b>Gauntlet, Thor</p>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "table": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<table border=\"1\" cellpadding=\"0\" width=\"100%\" cellspacing=\"0\" height=\"100%\">\r\n<tbody><tr><th>Product</th>\r\n<th>Type</th>\r\n<th>Dimensions</th>\r\n<th>Networking</th>\r\n<th>Camera add-ons</th>\r\n<th>Notes</th>\r\n</tr></tbody><tbody><tr><td>Gauntlet</td>\r\n<td>Carrier board</td>\r\n<td>155 × 125 mm</td>\r\n<td>High-speed Ethernet via Thor I/O</td>\r\n<td>Compatible with FPD-Link III, HDMI, SDI, MIPI kits</td>\r\n<td>Full-featured Thor carrier for high sensor count edge AI</td>\r\n</tr></tbody></table>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/table",
       "textIsRich": "true",
       "cq:styleIds": [
        "",
        "",
        "",
        ""
       ]
      },
      "text_1724108017": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3>&nbsp;</h3>\r\n<h3>NVIDIA Jetson AGX Orin</h3>\r\n<p><b>Carrier Boards:</b> Forge, Rogue, Rogue-RX</p>\r\n<p><b>Systems and Servers:</b> Anvil-RX, Sentry-X2, AGX Orin Inference Server</p>\r\n<p><b>Vision Add-Ons: </b>HDMI Camera Platform (JCB010), SDI Vision Platform (JCB003), Allied Vision MIPI board, FPD-Link III board</p>\r\n<p>&nbsp;</p>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "container": {
       "jcr:primaryType": "nt:unstructured",
       "sling:resourceType": "macnicaglobal2/components/content/container",
       "cq:styleIds": [
