       "table_1693902924": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellpadding=\"0\" width=\"100%\" cellspacing=\"0\" height=\"100%\">\r\n<tbody><tr><th style=\"text-align: center;\">Product</th>\r\n<th style=\"text-align: center;\">Class</th>\r\n<th style=\"text-align: center;\">Protection</th>\r\n<th style=\"text-align: center;\">I/O highlights</th>\r\n<th style=\"text-align: center;\">Notes</th>\r\n</tr><tr><td style=\"text-align: center;\">Anvil-RX</td>\r\n<td style=\"text-align: center;\">Rugged edge system</td>\r\n<td style=\"text-align: center;\">IP67</td>\r\n<td style=\"text-align: center;\">Sealed M12 I/O, power filtering</td>\r\n<td style=\"text-align: center;\">Outdoor and vehicle deployments</td>\r\n</tr><tr><td style=\"text-align: center;\">Sentry-X2</td>\r\n<td style=\"text-align: center;\">MIL-focused system</td>\r\n<td style=\"text-align: center;\">MIL-oriented design</td>\r\n<td style=\"text-align: center;\">SDI in and out, mixed-speed Ethernet</td>\r\n<td style=\"text-align: center;\">Tactical edge compute</td>\r\n</tr><tr><td style=\"text-align: center;\">AGX Orin Inference Server</td>\r\n<td style=\"text-align: center;\">2U deep learning server</td>\r\n<td style=\"text-align: center;\">Rackmount</td>\r\n<td style=\"text-align: center;\">Managed 10G uplinks, OOB management</td>\r\n<td style=\"text-align: center;\">Multi-module, low-wattage cluster</td>\r\n</tr></tbody></table>\r\n",
