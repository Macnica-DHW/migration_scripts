       "title_text_1489460070": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:title": "Carrier Boards",
        "type": "h1",
        "sling:resourceType": "macnicaglobal2/components/content/title"
       },
       "table_1693902924": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellpadding=\"0\" width=\"100%\" cellspacing=\"0\" height=\"100%\">\r\n<tbody><tr><th style=\"text-align: center;\">Product</th>\r\n<th style=\"text-align: center;\">Focus</th>\r\n<th style=\"text-align: center;\">Dimensions</th>\r\n<th style=\"text-align: center;\">Networking</th>\r\n<th style=\"text-align: center;\">Notable I/O</th>\r\n<th style=\"text-align: center;\">Notes</th>\r\n</tr><tr><td style=\"text-align: center;\">Forge</td>\r\n<td style=\"text-align: center;\">Commercial-deployable</td>\r\n<td style=\"text-align: center;\">155 × 125 mm</td>\r\n<td style=\"text-align: center;\">Up to dual 10GBASE-T plus dual GbE</td>\r\n<td style=\"text-align: center;\">DisplayPort, NVMe, USB 3.x</td>\r\n<td style=\"text-align: center;\">Compact AGX Orin and Industrial support</td>\r\n</tr><tr><td style=\"text-align: center;\">Rogue</td>\r\n<td style=\"text-align: center;\">High-I/O</td>\r\n<td style=\"text-align: center;\">Compact</td>\r\n<td style=\"text-align: center;\">Dual 10GbE</td>\r\n<td style=\"text-align: center;\">Multiple USB 3.x, HDMI, camera expansion header</td>\r\n<td style=\"text-align: center;\">Full-featured, production ready</td>\r\n</tr><tr><td style=\"text-align: center;\">Rogue-RX</td>\r\n<td style=\"text-align: center;\">Ruggedized</td>\r\n<td style=\"text-align: center;\">92 × 108.2 mm</td>\r\n<td style=\"text-align: center;\">Dual 10GBASE-T with locking</td>\r\n<td style=\"text-align: center;\">USB 3.2 Gen2, HDMI, rugged pin headers</td>\r\n<td style=\"text-align: center;\">Built for harsh environments</td>\r\n</tr></tbody></table>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/table",
        "textIsRich": "true",
        "cq:styleIds": [
         "",
         "",
         "",
         ""
