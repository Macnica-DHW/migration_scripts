       "text_1489460070": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<p><p>Carrier Boards</p>\r\n</p>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/text",
        "textIsRich": "true"
       },
       "table_1693902924": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th style=\"text-align: center;\">Product</th>\r\n<th style=\"text-align: center;\">Focus</th>\r\n<th style=\"text-align: center;\">Dimensions</th>\r\n<th style=\"text-align: center;\">Camera I/O</th>\r\n<th style=\"text-align: center;\">Notable I/O</th>\r\n<th style=\"text-align: center;\">Notes</th>\r\n</tr><tr><td style=\"text-align: center;\">Orbitty</td>\r\n<td style=\"text-align: center;\">Tiny, general-purpose</td>\r\n<td style=\"text-align: center;\">87 × 50 mm</td>\r\n<td style=\"text-align: center;\">Single MIPI option</td>\r\n<td style=\"text-align: center;\">HDMI, GbE, USB 3.0, microSD</td>\r\n<td style=\"text-align: center;\">Robotics and UGV-friendly</td>\r\n</tr><tr><td style=\"text-align: center;\">Spacely</td>\r\n<td style=\"text-align: center;\">Multi-camera</td>\r\n<td style=\"text-align: center;\">Compact</td>\r\n<td style=\"text-align: center;\">Up to 6 × MIPI CSI-2</td>\r\n<td style=\"text-align: center;\">GPS or GNSS expansion</td>\r\n<td style=\"text-align: center;\">Situational awareness builds</td>\r\n</tr><tr><td style=\"text-align: center;\">Sprocket</td>\r\n<td style=\"text-align: center;\">Lowest-profile</td>\r\n<td style=\"text-align: center;\">Very compact</td>\r\n<td style=\"text-align: center;\">1 × 4-lane MIPI</td>\r\n<td style=\"text-align: center;\">USB OTG, UART, I²C, GPIO</td>\r\n<td style=\"text-align: center;\">Space-constrained payloads</td>\r\n</tr><tr><td style=\"text-align: center;\">Quasar</td>\r\n<td style=\"text-align: center;\">Orbitty with more I/O</td>\r\n<td style=\"text-align: center;\">187 × 50 mm</td>\r\n<td style=\"text-align: center;\">1 × 4-lane MIPI</td>\r\n<td style=\"text-align: center;\">2 × USB 3.0, CAN, SATA, HDMI 2.0</td>\r\n<td style=\"text-align: center;\">More storage and expansion</td>\r\n</tr></tbody></table>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/table",
        "textIsRich": "true",
