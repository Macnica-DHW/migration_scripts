       "title_text_1489460070": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:title": "Vision Add-Ons",
        "type": "h1",
        "sling:resourceType": "macnicaglobal2/components/content/title"
       },
       "table_1693902924": {
        "jcr:primaryType": "nt:unstructured",
        "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" height=\"100%\">\r\n<tbody><tr><th style=\"text-align: center;\">Add-On</th>\r\n<th style=\"text-align: center;\">Inputs</th>\r\n<th style=\"text-align: center;\">Works with</th>\r\n<th style=\"text-align: center;\">Notes</th>\r\n</tr><tr><td style=\"text-align: center;\">HDMI Camera Platform (JCB010)</td>\r\n<td style=\"text-align: center;\">HDMI to CSI-2</td>\r\n<td style=\"text-align: center;\">Rogue and Forge</td>\r\n<td style=\"text-align: center;\">Dual micro HDMI plus dual 30-pin headers</td>\r\n</tr><tr><td style=\"text-align: center;\">SDI Vision Platform (JCB003)</td>\r\n<td style=\"text-align: center;\">SDI to CSI-2</td>\r\n<td style=\"text-align: center;\">Selected AGX carriers and systems</td>\r\n<td style=\"text-align: center;\">Ultra-low latency ingest</td>\r\n</tr><tr><td style=\"text-align: center;\">Allied Vision MIPI board</td>\r\n<td style=\"text-align: center;\">Up to 6 MIPI</td>\r\n<td style=\"text-align: center;\">Rogue, Rogue-X, Forge</td>\r\n<td style=\"text-align: center;\">For Alvium sensors, device tree support</td>\r\n</tr><tr><td style=\"text-align: center;\">FPD-Link III board</td>\r\n<td style=\"text-align: center;\">Multi-camera over coax</td>\r\n<td style=\"text-align: center;\">Rogue, Rogue-X, Forge</td>\r\n<td style=\"text-align: center;\">Power over coax, long cable runs</td>\r\n</tr></tbody></table>\r\n",
        "sling:resourceType": "macnicaglobal2/components/content/table",
        "textIsRich": "true",
        "cq:styleIds": [
         "",
         "",
         "",
         ""
        ]
       }
