      "text_1854220041": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/connect-tech/nvidia-jetson-orin-nx-and-orin-nano/\">NVIDIA Jetson Orin NX and Orin Nano</a></h3>\r\n<p><b>Carrier Boards:</b> Hadron-DM, Super Hadron-DM, Lepton, Boson-22</p>\r\n<p><b>Systems and Servers:</b> Polaris, Rudi-NX</p>\r\n<p><b>Vision Add-Ons: </b>Photon AI Camera Platform</p>\r\n<p>&nbsp;</p>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
