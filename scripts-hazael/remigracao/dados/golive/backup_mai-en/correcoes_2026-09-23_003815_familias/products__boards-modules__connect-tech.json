      "text_1981762888": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<h3><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/connect-tech/nvidia-jetson-tx2-tx2i-and-jetson-nano/\">NVIDIA Jetson TX2, TX2i, and Jetson Nano</a></h3>\r\n<p><b>Carrier Boards: </b>Orbitty, Spacely, Sprocket, Quasar, TX2, TX2i, Nano</p>\r\n<p>&nbsp;</p>\r\n",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "container_copy_copy__1123762262": {
       "jcr:primaryType": "nt:unstructured",
