     "flexcontaineritem_1": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem",
      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<p><i>senSPure</i><sup>TM</sup> C11U is a 3D ToF camera equipped with “hybrid ToF.&quot;&nbsp;It is ideal for using safe autonomous navigation of robots in environments such as indoor spaces near windows or stairs, as well as outdoor areas with high traffic of people and objects that are difficult for 2D LiDAR and conventional 3D cameras.</p><p style=\"margin-top:0\">&nbsp;</p>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
      "title_1": {
       "jcr:primaryType": "nt:unstructured",
       "jcr:title": "Key Features of the Toppan Industrial ToF 3D Image Sensor",
       "type": "h3",
       "sling:resourceType": "macnicaglobal2/components/content/title"
      },
      "text_2": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Strong ambient light tolerance (up to <b>100K lux</b>, usable under direct sunlight)</li>\n</ul>\n<ul>\n<li>Less motion artifacts and blurs</li>\n</ul>\n<ul>\n<li>High-speed capture with frame rates up to <b>120 fps</b></li>\n</ul>\n<ul>\n<li>Excellent durability for harsh environments with <b>IP67</b></li>\n</ul>\n<ul>\n<li>User-friendly Software Development Kit, <b><i>senSPure™</i>&nbsp;SDK</b></li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      },
