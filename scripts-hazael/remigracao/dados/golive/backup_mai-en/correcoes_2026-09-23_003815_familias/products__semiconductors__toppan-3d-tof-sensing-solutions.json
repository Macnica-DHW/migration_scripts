    "table_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th style=\"white-space:nowrap\">Model</th>\n<td width=\"80%\" style=\"white-space:nowrap\">TPHT4040</td>\n</tr><tr><th>Active pixel area</th>\n<td>640(H) × 480(V); VGA; 160(H) × 120(V); 4x4 Binning</td>\n</tr><tr><th>Optical format</th>\n<td>1/4 Type</td>\n</tr><tr><th>Shutter type</th>\n<td>Global shutter</td>\n</tr><tr><th>Frame rate</th>\n<td>30fps (Typ.); Max. 120fps (3-tap, 4 lane); VGA</td>\n</tr><tr><th>Pixel size</th>\n<td>5.6µm × 5.6µm</td>\n</tr><tr><th>Pixel structure</th>\n<td>4 Tap</td>\n</tr><tr><th>Output interface</th>\n<td>MIPI D-PHY CSI-2; 2/4 data and 1 clock lanes</td>\n</tr><tr><th style=\"white-space:nowrap\">Status</th>\n<td>Engineering Sample (MP 2025)</td>\n</tr></tbody></table>",
     "sling:resourceType": "macnicaglobal2/components/content/table",
     "textIsRich": "true",
