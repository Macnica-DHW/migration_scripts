     "table_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th style=\"white-space:nowrap\">Model</th>\n<td width=\"80%\" style=\"white-space:nowrap\">C11U</td>\n</tr><tr><th style=\"white-space:nowrap\">Sensor</th>\n<td style=\"white-space:nowrap\">TPHT4030</td>\n</tr><tr><th>Active pixel</th>\n<td>VGA (640×480)</td>\n</tr><tr><th>Working range</th>\n<td>0.5-7.0 m</td>\n</tr><tr><th style=\"white-space:nowrap\">Mode</th>\n<td>15fps, 30fps, 60fps; Max 120fps (High speed mode); HDR mode (15fps, 30fps, 60fps)</td>\n</tr><tr><th style=\"white-space:nowrap\">FOV</th>\n<td>90°(H) × 67°(V)</td>\n</tr><tr><th>Light source</th>\n<td>2 x VCSEL (λ=940nm)</td>\n</tr><tr><th style=\"white-space:nowrap\">Interface</th>\n<td>USB3.1 Gen1 (Port: Type C)</td>\n</tr><tr><th style=\"white-space:nowrap\">Availability</th>\n<td>Launching Oct 2025</td>\n</tr></tbody></table>",
      "sling:resourceType": "macnicaglobal2/components/content/table",
      "textIsRich": "true",
      "cq:styleIds": [
       "",
       "",
       "1722939215525"
      ]
     }
    }
