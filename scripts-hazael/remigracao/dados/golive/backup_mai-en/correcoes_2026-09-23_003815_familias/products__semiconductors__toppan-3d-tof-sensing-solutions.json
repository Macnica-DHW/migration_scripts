     ],
     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Why Toppan 3D ToF senSPure™ Series?",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "title_2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "hybrid ToF™ Advantage",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>hybrid ToF combines the short-pulse type indirect ToF method with multi-time window sensor control technology, achieving strong ambient light tolerance, minimizing motion artifacts, and enabling accurate capture of fast-moving objects even in bright sunlight. Additionally, the industrial ToF 3D image sensor utilizing this technology supports high frame-rate sensing, high dynamic range (HDR) operation, and flexible working range settings to meet user requirements.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_2": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "",
      "1717498052331",
      "1717498055877"
     ],
     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Key Features of the Toppan Industrial ToF 3D Image Sensor",
      "type": "h3",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<ul>\n<li>Strong ambient light tolerance (up to <b>100K lux</b>, Under a sunlight environment)</li>\n</ul>\n<ul>\n<li>Less motion artifacts and blurs</li>\n</ul>\n<ul>\n<li>High-speed capture with frame rates up to <b>120 fps</b></li>\n</ul>\n<ul>\n<li>User-friendly configuration enables adjustment of operating working range flexibly</li>\n</ul>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
