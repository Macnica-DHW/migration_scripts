    "textwithimage_1": {
     "jcr:primaryType": "nt:unstructured",
     "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/toppan/images/toppan-senspure-sdk-viewer.png",
     "imageRatio": "42",
     "alt": "Toppan senSPure™ SDK Viewer",
     "text": "<p><i>senSPure™&nbsp;</i>SDK is designed to simplify your development process and accelerate time-to-market. Here’s how our tools deliver real benefits for your projects:</p>\n<ul>\n<li><b>Various development environment </b>with Windows, Ubuntu, Jetson and ROS 2</li>\n</ul>\n<ul>\n<li><b>The flexible pipeline framework </b>enables easy integration into existing systems</li>\n</ul>\n<ul>\n<li><b>Libraries Optimized for the <i>senSPure™</i>&nbsp;Series</b></li>\n</ul>",
     "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
