    "textwithimage_1": {
     "jcr:primaryType": "nt:unstructured",
     "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/products/innolux-image001.png",
     "imageRatio": "40",
     "text": "<p>Innolux, a Taiwan-based corporation, is one of the world’s largest and most respected manufacturers of TFT-LCD displays and products, supplying panels to many of the best-known information and consumer electronics brands.</p>\r\n<p>&nbsp;</p>\r\n<p>Innolux Display Corporation's products are widely used in industrial, medical, and consumer applications, with larger displays popular for digital signage.</p>\r\n",
     "displayPopupTitle": "true",
     "linkTarget": "_self",
     "titleValueFromDAM": "true",
     "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
     "isDecorative": "false",
     "textIsRich": "true",
