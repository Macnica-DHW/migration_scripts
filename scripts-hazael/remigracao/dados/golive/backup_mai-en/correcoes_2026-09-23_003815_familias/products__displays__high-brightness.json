    "heading_1": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:title": "Rugged, Reliable & Radiant - High Brightness LCD Displays Built for Any Challenge",
     "type": "h1",
     "sling:resourceType": "macnicaglobal2/components/content/title"
    },
    "textwithimage_1": {
     "jcr:primaryType": "nt:unstructured",
     "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/stock/high-brightness-display-outdoor-mall-kiosk-1462728357.jpg",
     "imageRatio": "40",
     "alt": "High-brightness display in outdoor mall",
     "text": "<h3>Why Choose High Brightness Displays?</h3>\r\n<p>Standard screens struggle in outdoor bright environments, leading to washed-out visuals and poor readability. Our high brightness display offerings solve this problem with industry leading technology.&nbsp;Designed for outdoor and industrial applications, our high bright LCD displays maintain peak performance in direct sunlight, extreme temperatures and challenging environments.</p>\r\n",
     "displayPopupTitle": "true",
     "linkTarget": "_self",
     "titleValueFromDAM": "true",
     "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
     "isDecorative": "false",
     "textIsRich": "true",
     "altValueFromDAM": "false",
     "cq:styleIds": "1718154328384",
     "spImage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/stock/high-brightness-display-outdoor-mall-kiosk-1462728357.jpg",
      "sling:resourceType": "macnicaglobal2/components/content/image"
     }
    },
    "textwithimage_2": {
     "jcr:primaryType": "nt:unstructured",
     "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/stock/high-brightness-display-kiosk-1053603814.jpg",
     "imageRatio": "40",
     "alt": "High-brightness display kiosk indoors",
     "text": "<h3>Built for Extreme Environments</h3>\r\n<p>From digital signage and transportation hubs to marine and industrial control rooms, our high brightness LCD monitors guarantee superior visibility where it matters most.&nbsp;</p>\r\n",
     "displayPopupTitle": "true",
     "linkTarget": "_self",
     "titleValueFromDAM": "true",
     "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
     "isDecorative": "false",
     "textIsRich": "true",
     "altValueFromDAM": "false",
     "cq:styleIds": "1718154328384",
     "spImage": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/stock/high-brightness-display-kiosk-1053603814.jpg",
      "sling:resourceType": "macnicaglobal2/components/content/image"
     }
    },
    "textwithimage_3": {
     "jcr:primaryType": "nt:unstructured",
     "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/images/stock/high-brightness-display-bus-stop-2165816882.jpg",
     "imageRatio": "40",
     "alt": "High-brightness display at outdoor bus stop",
     "text": "<h3>Key Features of High Brightness Displays</h3>\r\n<ul>\r\n<li>Perfect for outdoor signage, transportation and marine applications</li>\r\n<li>Available in a wide range of sizes from 5”~75”</li>\r\n<li>Vandal-resistant glass options available for high traffic public spaces</li>\r\n</ul>\r\n",
     "displayPopupTitle": "true",
     "linkTarget": "_self",
     "titleValueFromDAM": "true",
     "sling:resourceType": "macnicaglobal2/components/content/textwithimage",
