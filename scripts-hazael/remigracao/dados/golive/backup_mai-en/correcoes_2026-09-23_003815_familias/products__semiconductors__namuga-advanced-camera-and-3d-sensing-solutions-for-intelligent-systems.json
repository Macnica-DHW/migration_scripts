      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Smart security and access control</li>\n<li>Medical and biomedical systems</li>\n<li>AI-enabled edge devices</li>\n<li>Drones and autonomous systems</li>\n<li>Intelligent transportation systems</li>\n</ul>",
