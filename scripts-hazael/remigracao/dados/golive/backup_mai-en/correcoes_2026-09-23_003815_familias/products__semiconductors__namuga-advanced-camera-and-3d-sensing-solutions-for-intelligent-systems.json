     ],
     "title_1": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Why Macnica + NAMUGA?",
      "type": "h2",
      "sling:resourceType": "macnicaglobal2/components/content/title"
     },
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>Macnica helps customers accelerate intelligent vision system development by combining NAMUGA’s advanced sensing technologies with industry-leading processing, AI, networking, and embedded compute solutions.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    },
    "container_2": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "",
      "1717498052331",
      "1717498055877"
     ],
     "image_1": {
      "jcr:primaryType": "nt:unstructured",
      "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/semiconductors/common/images/macnica-workflow-diagram.jpg",
      "alt": "Macnica workflow diagram",
      "sling:resourceType": "macnicaglobal2/components/content/image",
      "isDecorative": "false",
      "altValueFromDAM": "false"
     }
    },
    "container_3": {
     "jcr:primaryType": "nt:unstructured",
     "sling:resourceType": "macnicaglobal2/components/content/container",
     "cq:styleIds": [
      "",
      "1717498052331",
      "1717498055877"
     ],
     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p><b>Our engineering teams help customers to:</b></p>\n<ul>\n<li>Evaluate and select the right sensing architecture</li>\n<li>Accelerate AI vision development</li>\n<li>Integrate edge processing and connectivity</li>\n<li>Reduce design risk and development time</li>\n<li>Scale from prototype to production</li>\n</ul>\n<p>Macnica’s component-to-solution approach enables customers to build complete intelligent systems spanning image capture, AI processing, and system communication infrastructure.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
    }
   },
