      "text_1": {
       "jcr:primaryType": "nt:unstructured",
       "text": "<ul>\n<li>Robotics and automation</li>\n<li>Industrial machine vision</li>\n<li>Autonomous mobile robots</li>\n<li>AR/VR and spatial computing</li>\n<li>Smart mobility systems</li>\n</ul>",
       "sling:resourceType": "macnicaglobal2/components/content/text",
       "textIsRich": "true"
      }
     },
     "flexcontaineritem_2": {
      "jcr:primaryType": "nt:unstructured",
