        "text": "<table width=\"100%\" cellpadding=\"1\" cellspacing=\"0\" border=\"1\">\r\n<tbody><tr><th style=\"text-align: center;\">Core Technology</th>\r\n<th style=\"text-align: center;\">Module Type</th>\r\n<th style=\"text-align: center;\">Speed</th>\r\n<th style=\"text-align: center;\">Operating Temperature</th>\r\n<th style=\"text-align: center;\">Capacities</th>\r\n<th style=\"text-align: center;\">Chip Brand</th>\r\n</tr><tr><td width=\"10%\" rowspan=\"5\" style=\"text-align: center;\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/transcend/transcend-ddr5-dram-modules/\">DDR5</a></td>\r\n<td style=\"text-align: center;\">U-DIMM</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">6400MHz<br>\r\n5600MHz<br>\r\n4800MHz</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">Standard Temp:&nbsp; -20 ~ 95° C<br>\r\nIndustrial Temp: -40 ~ 95° C</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">8GB<br>\r\n16GB<br>\r\n32GB<br>\r\n48GB<br>\r\n64GB</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">Primary: Samsung<br>\r\nSecondary: Micron</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM</td>\r\n</tr><tr><td style=\"text-align: center;\">U-DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">Server R-DIMM</td>\r\n</tr><tr><td rowspan=\"5\" style=\"text-align: center;\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/transcend/transcend-ddr4-dram-modules/\">DDR4</a></td>\r\n<td style=\"text-align: center;\">U-DIMM</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">3200MHz<br>\r\n2666MHz<br>\r\n2400MHz<br>\r\n2133MHz</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">Standard Temp:&nbsp; -20 ~ 95° C<br>\r\nIndustrial Temp: -40 ~ 95° C</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">2GB<br>\r\n4GB<br>\r\n8GB<br>\r\n16GB<br>\r\n32GB<br>\r\n64GB</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">Primary: Micron<br>\r\nSecondary: Samsung</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM</td>\r\n</tr><tr><td style=\"text-align: center;\">U-DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">Server R-DIMM</td>\r\n</tr><tr><td rowspan=\"5\" style=\"text-align: center;\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/boards-modules/transcend/transcend-ddr3-dram-modules/\">DDR3</a></td>\r\n<td style=\"text-align: center;\">U-DIMM</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">1866MHz<br>\r\n1600MHz<br>\r\n1333MHz<br>\r\n1066MHz</td>\r\n<td rowspan=\"4\" style=\"text-align: center;\">Standard Temp:&nbsp; 0 ~ 85° C<br>\r\nIndustrial Temp: -40 ~ 85° C</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">1GB<br>\r\n2GB<br>\r\n4GB<br>\r\n8GB<br>\r\n16GB</td>\r\n<td rowspan=\"5\" style=\"text-align: center;\">Primary: Samsung&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM</td>\r\n</tr><tr><td style=\"text-align: center;\">U-DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">SO DIMM w/ ECC</td>\r\n</tr><tr><td style=\"text-align: center;\">Server R-DIMM</td>\r\n<td style=\"text-align: center;\">Standard Temp: 0 ~ 85° C</td>\r\n</tr></tbody></table>\r\n<p>&nbsp;</p>\r\n",
