    "title_2": {
     "jcr:primaryType": "nt:unstructured",
     "jcr:title": "Accelerate Video System Development",
     "type": "h3",
     "sling:resourceType": "macnicaglobal2/components/content/title"
    },
    "text_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<p>Macnica helps engineering teams evaluate i-Chips solutions for advanced video processing architectures. Whether you are designing a video wall controller, broadcast processing system, or projection platform, our team can assist with device selection and system architecture guidance.</p>\n<p>Evaluation platforms and development hardware allow designers to quickly prototype video pipelines before integrating i-Chips devices into production hardware.</p>",
     "sling:resourceType": "macnicaglobal2/components/content/text",
     "textIsRich": "true"
    }
