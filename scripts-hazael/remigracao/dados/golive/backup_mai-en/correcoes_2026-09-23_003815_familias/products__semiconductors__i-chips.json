     "text_1": {
      "jcr:primaryType": "nt:unstructured",
      "text": "<p>Macnica Americas works closely with semiconductor partners and system developers to help customers identify the right components for complex electronic systems. In addition to supplying i-Chips devices, our team helps engineering teams navigate design tradeoffs, evaluate device capabilities, and integrate video processing technologies into broader system architectures.</p>\n<p>Our expertise across imaging, video processing, networking, and edge compute technologies enables customers to build complete solutions across a wide range of professional display and embedded video applications.</p>",
      "sling:resourceType": "macnicaglobal2/components/content/text",
      "textIsRich": "true"
     }
