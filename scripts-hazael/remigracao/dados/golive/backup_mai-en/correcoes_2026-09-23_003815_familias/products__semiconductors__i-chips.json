    "table_1": {
     "jcr:primaryType": "nt:unstructured",
     "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\">\n<tbody><tr><th style=\"white-space:nowrap\">Product</th>\n<th style=\"white-space:nowrap\">Category</th>\n<th style=\"white-space:nowrap\">Inputs</th>\n<th style=\"white-space:nowrap\">Outputs</th>\n<th>Parallel Processing Units</th>\n<th>Key Capability</th>\n<th>Typical Use</th>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00cc35.html\" target=\"_self\">IP00C335</a></td>\n<td style=\"white-space:nowrap\">Scaler</td>\n<td>4</td>\n<td>4</td>\n<td>4-channel pipeline, multi-engine (scaler + de-interlacer)</td>\n<td>Quad-input/output de-interlacer and scaler with built-in memory</td>\n<td>Video wall, broadcast multi-viewer</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00c241.html\" target=\"_self\">IP00C241</a></td>\n<td style=\"white-space:nowrap\">Scaler</td>\n<td>1</td>\n<td>1</td>\n<td>Single scaler</td>\n<td>Memory-less 4K scaler</td>\n<td>Compact display systems</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00c251.html\" target=\"_self\">IP00C251</a></td>\n<td>Scaler / Switch</td>\n<td>3</td>\n<td>3</td>\n<td>3×3 cross-point switch</td>\n<td>Multi-source routing and switching</td>\n<td>AV routing</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00c331.html\" target=\"_self\">IP00C331</a></td>\n<td style=\"white-space:nowrap\">Scaler</td>\n<td>4</td>\n<td>Multiple (configurable)</td>\n<td>Multi-channel scaler + de-interlacer</td>\n<td>Multi-input display processing</td>\n<td>ProAV processors</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00c734.html\" target=\"_self\">IP00C734A</a></td>\n<td style=\"white-space:nowrap\">Scaler</td>\n<td>4</td>\n<td>4 (LVDS)</td>\n<td>4-channel scaler + de-interlacer</td>\n<td>2K60 4-channel scaler with de-interlacing and LVDS output</td>\n<td>Display control systems</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-lsi/i-chips-ip00c733a.html\" target=\"_self\">IP00C733A</a></td>\n<td style=\"white-space:nowrap\">Scaler</td>\n<td>4</td>\n<td>4</td>\n<td>4-channel scaler</td>\n<td>2K60 4-channel scaler</td>\n<td>Multi-display systems</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-warper-lsi/i-chips-ip00c341.html\" target=\"_self\">IP00C341</a></td>\n<td>Scaler + Warping</td>\n<td>2</td>\n<td>1</td>\n<td>Dual pipeline + warping engine</td>\n<td>PiP, scaling, warping, edge blending</td>\n<td>Projection systems</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-scaler-warper-lsi/i-chips-ip00c814.html\" target=\"_self\">IP00C814</a></td>\n<td>Scaler + Warping</td>\n<td>2</td>\n<td>1</td>\n<td>Dual pipeline</td>\n<td>2K60 dual-channel scaler with integrated processing</td>\n<td>Projector platforms</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-warping-lsi/i-chips-ip00c381.html\" target=\"_self\">IP00C381</a></td>\n<td style=\"white-space:nowrap\">Warping</td>\n<td>1</td>\n<td>1</td>\n<td>Warping + blending engine</td>\n<td>High-performance warping and edge blending</td>\n<td>Immersive displays</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-warping-lsi/i-chips-ip00c382.html\" target=\"_self\">IP00C382</a></td>\n<td style=\"white-space:nowrap\">Warping</td>\n<td>1</td>\n<td>1</td>\n<td>Warping engine</td>\n<td>4K warping and edge blending</td>\n<td>Projection mapping</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-warping-lsi/i-chips-ip00c790.html\" target=\"_self\">IP00C790</a></td>\n<td style=\"white-space:nowrap\">Warping</td>\n<td>1</td>\n<td>1</td>\n<td>Warping + color processing</td>\n<td>4K warping with color processing</td>\n<td>specialty displays</td>\n</tr><tr><td style=\"white-space:nowrap\"><a href=\"/content/macnicaglobal2/americas/mai/en/products/semiconductors/i-chips/i-chips-fpga-evaluation-board.html\" target=\"_self\">iEB-KXU2</a></td>\n<td>Evaluation Board</td>\n<td>4 × HDMI</td>\n<td>4 × HDMI</td>\n<td>FPGA-based (programmable)</td>\n<td>4K60 multi-channel development platform</td>\n<td style=\"white-space:nowrap\">Prototyping</td>\n</tr></tbody></table>",
