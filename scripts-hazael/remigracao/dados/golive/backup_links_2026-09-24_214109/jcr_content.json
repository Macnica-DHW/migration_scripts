{"about-us/newsletter/macnicas-medical-healthcare-solutions": {"jcr:primaryType": "cq:PageContent", "jcr:createdBy": "valter.toffolo@macnicadhw.com.br", "jcr:title": "Macnica's Medical/Healthcare Solutions", "showInLists": "true", "cq:template": "/conf/macnicaglobal2/settings/wcm/templates/mai-mae-product-page", "pd_modelName": "MACNICAS-MEDICAL-HEALTHCARE-SOLUTIONS", "pd_isModelNameLinkToPage": "true", "jcr:created": "Wed Sep 23 2026 02:27:51 GMT+0000", "cq:lastModified": "Thu Sep 24 2026 22:55:33 GMT+0000", "jcr:description": "Macnica offers various components and solutions for medical and healthcare applications, ranging from display modules, semiconductor chips, sensors, embedded modules, and board solutions to accelerate your development of medical and healthcare products.", "keywords": "macnica, macnica americas, medical, healthcare, display modules, semiconductor chips, sensors, embedded modules, board solutions, healthcare products", "cq:canonicalUrl": "/content/macnicaglobal2/americas/mai/en/about-us/newsletter/macnicas-medical-healthcare-solutions", "hideInNav": "true", "pageTitle": "Macnica's Medical/Healthcare Solutions", "cq:tags": "mai:business-categories/broadcast-proav", "sling:resourceType": "macnicaglobal2/components/technicalarticlepage", "pd_description": "Macnica offers various components and solutions for medical and healthcare applications, ranging from display modules, semiconductor chips, sensors, embedded modules, and board solutions to accelerate your development of medical and healthcare products.", "cq:lastModifiedBy": "valter.toffolo@macnicadhw.com.br", "navTitle": "Macnica's Medical/Healthcare Solutions", "root": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "wcm/foundation/components/responsivegrid", "container": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "title_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498053499"], "title": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Macnica's Medical/Healthcare Solutions", "type": "h1", "sling:resourceType": "macnicaglobal2/components/content/title"}}, "title_wrap_conteudo": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "text_intro": {"jcr:primaryType": "nt:unstructured", "text": "<p>Macnica offers various components and solutions for medical and healthcare applications, ranging from display modules, semiconductor chips, sensors, embedded modules, and board solutions to accelerate your development of medical and healthcare products.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "text_1_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f0f0f0", "cq:styleIds": ["1717498052331", "1717498053499"], "text_1": {"jcr:primaryType": "nt:unstructured", "text": "<p>Macnica offers various components and solutions for&nbsp;<b>medical and healthcare applications</b>, ranging from display modules, semiconductor chips, sensors, embedded modules, and board solutions to accelerate your development of medical and healthcare products.&nbsp;In this edition of the Macnica newsletter, we focus on&nbsp;<b>displays,&nbsp;video transmission</b>&nbsp;and&nbsp;<b>image sensors</b>&nbsp;for medical and healthcare use cases.</p>\n<hr>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "heading_1_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Macnica Medical Displays:", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}}, "heading_2_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Excellence in Performance, Reliability, and User Experience", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_2": {"jcr:primaryType": "nt:unstructured", "text": "<p>﻿Choosing Macnica medical displays is the ideal solution for designing healthcare technology with a focus on performance, reliability, and an outstanding user experience.&nbsp;Whether it’s for vital signs monitors, portable diagnostic equipment, or self-service terminals in clinics, display technology must live up to the mission: saving lives.&nbsp;That’s why we invite you to explore the critical role displays play in the medical sector - and how Macnica, with decades of expertise in advanced technology, has become a strategic partner for top medical equipment developers around the world.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "button_1_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "button_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Learn More", "linkURL": "/content/macnicaglobal2/americas/mai/en/blog", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}, "heading_3_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_3": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Live Medical Video Transmission with ST 2110 and MEP100:", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}}, "heading_4_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_4": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Transforming Hospitals and Medical Schools", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_3": {"jcr:primaryType": "nt:unstructured", "text": "<p>In modern healthcare, real-time video is essential for both surgical collaboration and medical education.&nbsp;Surgical Teams can share live imaging with support staff in adjacent rooms or even across the hospital, enabling immediate expert input without disrupting the sterile environment.&nbsp;Medical Education benefits from live surgical broadcasts to lecture halls, allowing large groups of students to observe procedures without crowding the operating theater, minimizing infection risk while enabling interactive Q&amp;A.&nbsp;Read more to learn how Macnica's MEP100 SmartNIC can contribute to transforming medical education.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "button_2_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "button_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Learn More", "linkURL": "/content/macnicaglobal2/americas/mai/en/blog/transforming-medical-video-transmission-with-st-2110-and-the-macnica-mep100", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}, "heading_5_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_5": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Sony Image Sensors for Medical Applications:", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}}, "heading_6_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_6": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Precision for Critical Applications", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_4": {"jcr:primaryType": "nt:unstructured", "text": "<p>From operating rooms to research labs, medical imaging demands uncompromising accuracy, low noise, and consistent performance. Sony’s industrial image sensors, designed for professional and scientific environments, are engineered to meet these exacting standards - delivering the fidelity healthcare professionals rely on for diagnosis, treatment, and research.</p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "button_3_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "button_3": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Learn More", "linkURL": "/content/macnicaglobal2/americas/mai/en/blog/sony-industrial-image-sensors-in-medical-imaging", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}, "heading_7_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_7": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Know someone who would like to receive this newsletter? ", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}, "text_5": {"jcr:primaryType": "nt:unstructured", "text": "<p><a href=\"/content/macnicaglobal2/americas/mai/en/about-us/newsletter-sign-up.html\" target=\"_blank\" rel=\"noopener noreferrer\">Sign up for our newsletter here.</a></p>", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "heading_8_wrap": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "heading_8": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Explore Macnica's Medical/Healthcare Solutions", "type": "h2", "sling:resourceType": "macnicaglobal2/components/content/title"}}}}}, "products": {"jcr:primaryType": "cq:PageContent", "jcr:mixinTypes": ["mix:versionable"], "jcr:createdBy": "admin", "jcr:title": "All Electric Parts & Component Products for Sale", "jcr:versionHistory": "bf093b57-fc48-499a-8099-6a63b01d731e", "pwaOrientation": "any", "cq:template": "/conf/macnicaglobal2/settings/wcm/templates/mai-page-content", "jcr:predecessors": ["00713924-126f-45f0-a828-39992b3dc312"], "jcr:created": "Thu Mar 05 2026 00:16:38 GMT+0000", "pwaDisplay": "standalone", "cq:lastModified": "Wed Sep 23 2026 20:10:12 GMT+0000", "pwaCachestrategy": "staleWhileRevalidate", "jcr:baseVersion": "00713924-126f-45f0-a828-39992b3dc312", "jcr:isCheckedOut": true, "jcr:uuid": "1fe43eae-7d7b-463c-849f-605bb17955cb", "sling:resourceType": "macnicaglobal2/components/page", "cq:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "navTitle": "Products", "root": {"jcr:primaryType": "nt:unstructured", "jcr:lastModifiedBy": "admin", "jcr:lastModified": "Thu Jan 08 2026 18:23:07 GMT+0900", "sling:resourceType": "wcm/foundation/components/responsivegrid", "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "admin", "jcr:lastModifiedBy": "admin", "jcr:created": "Thu Jan 08 2026 18:32:09 GMT+0900", "jcr:lastModified": "Thu Jan 08 2026 18:32:46 GMT+0900", "sling:resourceType": "macnicaglobal2/components/content/container", "title": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:33:51 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:33:51 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/title", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "2", "width": "8"}}}, "text": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:56:11 GMT+0000", "text": "<hr>\r\n\r\n", "jcr:lastModified": "Fri Aug 28 2026 11:56:45 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "2", "width": "8"}}}, "image": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:56:35 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:56:35 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "2", "width": "8"}}}, "text_284935450": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:57:00 GMT+0000", "text": "<h2>The electronic parts products, components, and support you need - we have both in your reach</h2>\r\n<p>Macnica offers a comprehensive selection of industrial electronic parts components for sale to develop your products, ranging from semiconductor and electronic components to boards, modules, IP, and software.</p>\r\n<p>Automotive offerings are for limited customer engagements to support and deliver for very automotive specific requirements ranging from quality management scheme and actions to just-in-time delivery of products.</p>\r\n<p><a href=\"https://www.macnica.com/content/dam/macnicagwi/americas/mai/public/en/downloads/macnica-americas-linecard.pdf\">Download the Macnica Americas Linecard here</a>.</p>\r\n", "jcr:lastModified": "Wed Sep 23 2026 20:10:12 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "2", "width": "8"}}}, "container": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:58:10 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:58:10 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "1", "width": "10"}}, "image": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:58:38 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:58:38 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "0", "width": "2"}}}, "image_1021195315": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:59:02 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:59:02 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "1", "width": "2"}}}, "image_1899426112": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 11:59:35 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 11:59:35 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "4", "width": "3"}}}, "image_66652080": {"jcr:primaryType": "nt:unstructured", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "jcr:created": "Fri Aug 28 2026 12:00:21 GMT+0000", "jcr:lastModified": "Fri Aug 28 2026 12:00:21 GMT+0000", "sling:resourceType": "macnicaglobal2/components/content/image", "cq:responsive": {"jcr:primaryType": "nt:unstructured", "default": {"jcr:primaryType": "nt:unstructured", "offset": "0", "width": "2"}}}}}}, "cq:featuredimage": {"jcr:primaryType": "nt:unstructured", "jcr:lastModifiedBy": "ohashi@yamato-ltd.com", "jcr:lastModified": "Tue Feb 17 2026 06:32:45 GMT+0000", "sling:resourceType": "core/wcm/components/image/v3/image", "altValueFromDAM": "true"}}, "products/boards-modules/iei/iei-networking-servers": {"jcr:primaryType": "cq:PageContent", "jcr:createdBy": "bruno.jaques@macnicadhw.com.br", "jcr:title": "Networking & Servers", "manufacturer": "mai:manufacturers/iei", "cq:template": "/conf/macnicaglobal2/settings/wcm/templates/mai-mae-product-page", "jcr:created": "Tue Sep 08 2026 15:32:17 GMT+0000", "cq:lastModified": "Mon Sep 21 2026 20:47:37 GMT+0000", "jcr:description": "iEi’s Networking and Servers portfolio delivers versatile and scalable solutions designed for functions such as routing, firewalling, VPN, UTM, and SD-WAN. These appliances are built for open-source integration and can be customized for ODM and OEM requirements.", "cq:canonicalUrl": "/content/macnicaglobal2/americas/mai/en/products/boards-modules/iei/iei-networking-servers", "pageTitle": "Networking & Servers", "cq:tags": "mai:business-categories/boards-modules", "sling:resourceType": "macnicaglobal2/components/maeproductpage", "cq:lastModifiedBy": "bruno.jaques@macnicadhw.com.br", "navTitle": "Networking & Servers", "root": {"jcr:primaryType": "nt:unstructured", "jcr:lastModifiedBy": "admin", "jcr:lastModified": "Thu Jan 08 2026 18:23:07 GMT+0900", "sling:resourceType": "wcm/foundation/components/responsivegrid", "container": {"jcr:primaryType": "nt:unstructured", "jcr:lastModifiedBy": "admin", "jcr:lastModified": "Thu Jan 08 2026 18:32:46 GMT+0900", "sling:resourceType": "macnicaglobal2/components/content/container", "container": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498053499"], "title": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/title"}}, "container_849791024": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "title_textwithimage": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Panel PC &amp; Monitors", "type": "h1", "sling:resourceType": "macnicaglobal2/components/content/title"}, "textwithimage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Panel PC Monitors.png", "imageRatio": "40", "alt": "Panel PC MONITORS", "text": "<p>iEi Panel PCs and industrial monitors provide reliable human-machine interfaces for healthcare, retail, factory automation, and transportation. Built with rugged designs and long lifecycle availability, these systems combine durable touchscreens, powerful processors, and flexible mounting options for mission-critical applications.</p>", "displayPopupTitle": "true", "linkTarget": "_self", "titleValueFromDAM": "true", "sling:resourceType": "macnicaglobal2/components/content/textwithimage", "isDecorative": "false", "textIsRich": "true", "altValueFromDAM": "false", "cq:styleIds": ["1718154328384", "", ""], "spImage": {"jcr:primaryType": "nt:unstructured", "fileReference": "/content/dam/macnicaglobal2/americas/mai/en/products/boards-modules/iei/Panel PC Monitors.png", "sling:resourceType": "macnicaglobal2/components/content/image"}}, "button_copy": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Networking & Servers Brochure", "linkURL": "/content/macnicaglobal2/americas/mai/en/products/boards-modules/iei/iei-networking-servers", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}, "container_2108578966": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f0f0f0", "cq:styleIds": ["1717498052331", "1717498053499"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Offerings range from:</h3>\r\n<ul>\r\n<li>Entry-level fanless or compact systems that are cost-efficient and eco-friendly</li>\r\n<li>Performance-level rack appliances powered by Intel Core processors with features like hot-swap power supplies and modular I/O</li>\r\n<li>Premium rack appliances using Xeon processors for enterprise and cloud applications with high throughput and flexible expansion</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "container_1052130662": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "backgroundColor": "#f7f7f7", "cq:styleIds": ["1717498052331", "1717498053499"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Highlighted Product Offerings</h3>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}, "tabs_copy_39779571_c": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/tabs", "item_1": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Tab 1", "cq:panelTitle": "Entry-Level Network", "layout": "responsiveGrid", "id": "view-transcend-memory-product-portfolio-id", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "container_180292821": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Entry-Level Network Appliances</h3>\r\n<h3>PUZZLE-1100</h3>\r\n<ul>\r\n<li>Desktop appliance with Intel Atom X Series processor</li>\r\n<li>4 × 2.5 GbE LAN</li>\r\n<li>DDR5 SO-DIMM and 128 GB eMMC (expandable via M.2)</li>\r\n<li>AES-NI encryption and virtualization support</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}, "item_2": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Tab 2", "cq:panelTitle": "Premium Desktop", "layout": "responsiveGrid", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Premium Desktop Appliances</h3>\r\n<h3>PUZZLE-3032 and PUZZLE-3034</h3>\r\n<ul>\r\n<li>Intel Atom C3000 processors</li>\r\n<li>PUZZLE-3032: 8 × 2.5 GbE + 2 × 10 GbE, 64 GB eMMC</li>\r\n<li>PUZZLE-3034: 8 × 2.5 GbE + 4 × 10 GbE, 64 GB eMMC</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<h3>PUZZLE-IN003A and PUZZLE-IN003B</h3>\r\n<ul>\r\n<li>PUZZLE-IN003A: Atom C3000, 8 × 1 GbE + 4 × 10 GbE, bypass capability, 32 GB eMMC</li>\r\n<li>PUZZLE-IN003B: Atom C3000, 6 × 1 GbE + 2 × 10 GbE, 2 M.2 slots, 32 GB eMMC</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "item_1789082868625": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "ARM-Based", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>ARM-Based Appliances</h3>\r\n<h3>PUZZLE-M801</h3>\r\n<ul>\r\n<li>Marvell Armada 88F8040 quad-core ARM SoC</li>\r\n<li>4 × 1 GbE and 2 × 10 GbE LAN</li>\r\n<li>1 × PCIe ×16 expansion</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<h3>PUZZLE-M902 and PUZZLE-M901</h3>\r\n<ul>\r\n<li>Marvell CN9130 (Cortex-A72 / A7) with OpenWrt pre-installed</li>\r\n<li>M902: 6 × 2.5 GbE + 3 × 10 GbE</li>\r\n<li>M901: 6 × 2.5 GbE</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "item_1789086463962": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "1U Rackmount", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>1U Rackmount Appliances (Intel Platforms)</h3>\r\n<h3>PUZZLE-5030</h3>\r\n<ul>\r\n<li>11th Gen Intel Xeon E processor</li>\r\n<li>8 × 2.5 GbE, dual bypass LAN pairs</li>\r\n<li>2 PulM slots and 2 PCIe Gen3 slots</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<h3>PUZZLE-IN001A / IN002 / IN001</h3>\r\n<ul>\r\n<li>Intel Core, Pentium, or Celeron processors</li>\r\n<li>Options include 8 × 5 GbE, 6 × 1 GbE with PCIe ×16, or 8 × 1 GbE with PulM slots</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "item_1789086473373": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "Scalable 1U/2U Rack", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Scalable 1U and 2U Rack Appliances (Enterprise)</h3>\r\n<h3>PUZZLE-IN005</h3>\r\n<ul>\r\n<li>3rd Gen Intel Xeon Scalable processor</li>\r\n<li>2 × 1 GbE, 8 PulM slots, PCIe ×8 expansion</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<h3>PUZZLE-7030A, PUZZLE-9030, PUZZLE-9040</h3>\r\n<ul>\r\n<li>High-performance rack systems with Xeon D, AMD EPYC, or dual Xeon Scalable CPUs</li>\r\n<li>Features include OCP slots, PCIe Gen4 connectivity, PulM expansion and U.2 storage options</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}, "item_1789086483961": {"jcr:primaryType": "nt:unstructured", "cq:panelTitle": "Storage Servers", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498056876", "1717498055877"], "text": {"jcr:primaryType": "nt:unstructured", "text": "<h3>Storage Servers - GRAND Series</h3>\r\n<ul>\r\n<li>3rd Gen Intel Xeon Scalable processor</li>\r\n<li>2 × 1 GbE, 8 PulM slots, PCIe ×8 expansion</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<h3>Network Modules - PulM Series</h3>\r\n<ul>\r\n<li>Flexible expansion through high-performance NIC modules<b>:</b><ul>\r\n<li>100 GbE: PulM-100G2SF-CX6, PulM-100G25F-E810</li>\r\n<li>40 GbE: PulM-40G2SF-XL710</li>\r\n<li>10 GbE: PulM-10G2SF, PulM-10G4SF variants</li>\r\n<li>1 GbE: PulM-1G4SF, PulM-1G8T and other RJ45 or bypass options</li>\r\n</ul>\r\n</li>\r\n<li>Additional modules include expansion cards, M.2 support, and the Mustang-QA100 crypto accelerator</li>\r\n</ul>\r\n", "sling:resourceType": "macnicaglobal2/components/content/text", "textIsRich": "true"}}}}, "container_2083508271": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/container", "cq:styleIds": ["1717498052331", "1717498053499"], "flexcontainer_copy_c": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontainer", "cq:styleIds": ["1718800458698", "1719484596357"], "flexcontaineritem": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "button": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Contact Us for More Information", "linkURL": "/content/macnicaglobal2/americas/mai/en/contact/form.html", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}, "flexcontaineritem_861351158": {"jcr:primaryType": "nt:unstructured", "sling:resourceType": "macnicaglobal2/components/content/flexcontaineritem", "button": {"jcr:primaryType": "nt:unstructured", "jcr:title": "Request a Quote", "linkURL": "/content/macnicaglobal2/americas/mai/en/request-a-quote.html", "linkTarget": "_self", "sling:resourceType": "macnicaglobal2/components/content/button", "cq:styleIds": ["", "1722936853890", "1717669229626"]}}}}}}}}