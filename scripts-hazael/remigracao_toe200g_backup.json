   "text_4": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<ul>\n<li><b>Ethernet:</b> 200 GbE</li>\n</ul>\n<ul>\n<li><b>User interfaces:</b> AXI4-Stream for Tx and Rx, register interface for control and stats</li>\n</ul>\n<ul>\n<li><b>Resources:</b> Pure RTL, no external DDR, no embedded CPU in the data path</li>\n</ul>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
