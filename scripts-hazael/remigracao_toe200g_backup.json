   "text_intro": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<p>200G TCP in hardware for multi-stream, line rate transport without a CPU or external DDR. TOE200G-IP implements the full TCP stack in logic and connects directly to 200 GbE MAC and PHY on supported FPGA platforms. The core is built for sustained multi-session throughput with predictable latency and a simple streaming interface to user logic.</p>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
  },
