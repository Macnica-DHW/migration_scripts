  "table_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "table_1": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<table width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody><tr><th>Filter Type</th>\r\n<td>RGB</td>\r\n</tr><tr><th>Sensor Size (diagonal)</th>\r\n<td>1/2.32” (7.75mm)</td>\r\n</tr><tr><th>Number of Effective Pixels</th>\r\n<td>1936h x 1456v</td>\r\n</tr><tr><th>Pixel Size</th>\r\n<td>3.2μm x 3.2μm</td>\r\n</tr><tr><th>Shutter</th>\r\n<td>Rolling Shutter</td>\r\n</tr><tr><th>Dynamic Range – HDR</th>\r\n<td>120 dB</td>\r\n</tr><tr><th>Dynamic Range – Normal</th>\r\n<td>75 dB</td>\r\n</tr><tr><th>Maximum Frame Rate – HDR</th>\r\n<td>30 fps</td>\r\n</tr><tr><th>Maximum Frame Rate – Normal</th>\r\n<td>60 fps</td>\r\n</tr><tr><th>Operating Temperature</th>\r\n<td>-40°C to 105°C (-40°F to 221°F )</td>\r\n</tr><tr><th>Output Format</th>\r\n<td>MIPI CSI-2</td>\r\n</tr></tbody></table>\r\n",
    "sling:resourceType": "macnicaglobal2/components/content/table",
    "textIsRich": "true"
   }
  },
