  },
  "text_intro_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "text_intro": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<p>The Canon LI5040 CMOS Sensor offers 5.33M pixels. It’s square 3.4µm x 3.4µm pixel arrangement and 2/3” frame achieves high resolution, allowing you to capture everything you need in a compact design. Find out how you can make your machine vision project a success with the LI5040 from Canon.</p>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
  },
