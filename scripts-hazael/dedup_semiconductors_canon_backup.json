   "table_1": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<table width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody><tr><th>&nbsp;</th>\r\n<th>LI5040SAC</th>\r\n<th>LI5040SAM</th>\r\n<th>LI5040SAI</th>\r\n</tr><tr><td>Filter Type</td>\r\n<td>RGB</td>\r\n<td>Monochrome</td>\r\n<td>RGB-NIR</td>\r\n</tr><tr><td>Sensitivity [e/lx/sec]</td>\r\n<td>30,000</td>\r\n<td>54,000</td>\r\n<td>30,000</td>\r\n</tr><tr><td>Resolution</td>\r\n<td colspan=\"3\">5.33 MP</td>\r\n</tr><tr><td>Pixel count</td>\r\n<td colspan=\"3\">2592 x 2056</td>\r\n</tr><tr><td>Pixel pitch</td>\r\n<td colspan=\"3\">3.4 μm</td>\r\n</tr><tr><td>Sensor Size</td>\r\n<td colspan=\"3\">2/3 inch (8.8 x 7.0 mm)</td>\r\n</tr><tr><td>Shutter Type</td>\r\n<td colspan=\"3\">Global</td>\r\n</tr><tr><td>Enhanced NIR sensitivity</td>\r\n<td colspan=\"3\">Yes</td>\r\n</tr><tr><td>Frame rate</td>\r\n<td colspan=\"3\">120 fps</td>\r\n</tr></tbody></table>\r\n",
    "sling:resourceType": "macnicaglobal2/components/content/table",
