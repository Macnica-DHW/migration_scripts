   }
  },
  "text_intro_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "text_intro": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<p>Utilizing high-speed signal readout technology, the super 35mm format Canon LI7080SA CMOS sensor boasts 4.5K resolution at 120 frames per second. With a 6.4 μm x 6.4 μm pixel size and rolling shutter technology, the LI7080SA provides professional-grade imaging that delivers performance suitable for high-end security and cinema cameras.</p>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
  },
  "carousel_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
