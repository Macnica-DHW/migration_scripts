  "text_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "text_1": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<h3><b>Full Size 19MP Global Shutter CMOS Sensor</b></h3>\r\n<h3>&nbsp;</h3>\r\n<p>LI5030SA is a CMOS type of solid-state image sensor with a 35mm full frame effective pixel array of 19 Megapixels. It uses a global shutter function instead of conventional rolling shutter. It enables simultaneous exposure timing for all 19 Mega pixels. It can output an effective 5688 x 3334 pixels of video at 57.99 fps and 12bit via 24 channels of digital signal output. LI5030SA series consists of LI5030SAC (color), LI5030SAI (RGBIR), LI5030SAM (monochrome) and LI5030SAN (Naked). LI5030SAN does not have a micro lens or color filter.</p>\r\n<p>&nbsp;</p>\r\n",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
  },
  "heading_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "heading_1": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:title": "Technical Specifications",
    "type": "h2",
    "sling:resourceType": "macnicaglobal2/components/content/title"
   }
  },
  "table_1_wrap": {
   "jcr:primaryType": "nt:unstructured",
   "sling:resourceType": "macnicaglobal2/components/content/container",
   "table_1": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<table width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody><tr><th>&nbsp;</th>\r\n<th>LI5030SAC</th>\r\n<th>LI5030SAI</th>\r\n<th>LI5030SAM</th>\r\n<th>LI5030SAN</th>\r\n</tr><tr><td>Filter Type</td>\r\n<td>Color</td>\r\n<td>RGBIR</td>\r\n<td>Monochrome</td>\r\n<td>Naked</td>\r\n</tr><tr><td>Recording screen size:</td>\r\n<td colspan=\"4\">Full frame 35mm equivalent (42.12 mm x 32.64 mm)</td>\r\n</tr><tr><td>Number of effective pixels:</td>\r\n<td colspan=\"4\">5688 x 3334 (Horizontal x Vertical)</td>\r\n</tr><tr><td>Pixel size:</td>\r\n<td colspan=\"4\">6.4 μm x 6.4 μm</td>\r\n</tr><tr><td>Output format:</td>\r\n<td colspan=\"4\">LVDS output, 720Mbps@12bit</td>\r\n</tr><tr><td>Main clock frequency:</td>\r\n<td colspan=\"4\">60 MHz (recommended)</td>\r\n</tr><tr><td>Analog gain:</td>\r\n<td colspan=\"4\">0dB, 6dB, 12dB, 18dB</td>\r\n</tr><tr><td>Saturation (Typ.):</td>\r\n<td colspan=\"4\">20,000e (Typ.)</td>\r\n</tr><tr><td>Sensitivity (Typ.):</td>\r\n<td>(Green) 81,000 e/lx/sec</td>\r\n<td>(Green) 80,000 e/lx/sec</td>\r\n<td>170,000 e/lx/sec</td>\r\n<td>30,000 e/lx/sec</td>\r\n</tr><tr><td>Dark random noise (Typ.):</td>\r\n<td colspan=\"4\">1.8 erms @Analog gain 18dB</td>\r\n</tr><tr><td>Dark current (Typ.):</td>\r\n<td colspan=\"4\">28 e/sec @Analog gain 18dB, 60°C</td>\r\n</tr><tr><td>Power consumption (Typ.):</td>\r\n<td colspan=\"4\">2400 mW @57.99 fps full area</td>\r\n</tr></tbody></table>\r\n",
    "sling:resourceType": "macnicaglobal2/components/content/table",
    "textIsRich": "true"
   }
  },
