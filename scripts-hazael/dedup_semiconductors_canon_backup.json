   "text_intro": {
    "jcr:primaryType": "nt:unstructured",
    "text": "<p>The Canon LI7030SA is a CMOS type solid-state imaging sensor having a size equivalent to 1 inch, and 3.2 μm square pixel arrangement with 12 mega effective pixels. Video of 4K3K at 24 fps (12bit), 4K2K at 60 fps (10bit) and HD720p at 120 fps (10bit) can be achieved. Based on Canon’s low-noise technology, LI7030SA has a high dynamic range and achieved excellent imaging characteristics at low illuminance.</p>",
    "sling:resourceType": "macnicaglobal2/components/content/text",
    "textIsRich": "true"
   }
