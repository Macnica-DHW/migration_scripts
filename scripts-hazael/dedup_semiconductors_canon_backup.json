    "jcr:primaryType": "nt:unstructured",
    "text": "<table width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody><tr><th>Resolution</th>\r\n<td>10 MP</td>\r\n</tr><tr><th>Pixel count</th>\r\n<td>4,288×2,398</td>\r\n</tr><tr><th>Pixel pitch</th>\r\n<td>6.4μm</td>\r\n</tr><tr><th>Sensor Size</th>\r\n<td>27.4 x 15.3 mm</td>\r\n</tr><tr><th>Shutter Type</th>\r\n<td>Global</td>\r\n</tr><tr><th>Dark Random Noise</th>\r\n<td>2.0 e-rms @ 18 dB</td>\r\n</tr><tr><th>Frame rate</th>\r\n<td>60 fps</td>\r\n</tr><tr><th>Color filter options</th>\r\n<td>RGB</td>\r\n</tr><tr><th>Sensitivity</th>\r\n<td>90,000 e/lx/sec</td>\r\n</tr></tbody></table>\r\n",
