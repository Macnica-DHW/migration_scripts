  ],
  "text_6": {
   "jcr:primaryType": "nt:unstructured",
   "text": "<ul>\n<li>Centralized 5G Units (CU/DU split architecture)</li>\n<li>Small Cells and Macro Base Stations</li>\n<li>Fronthaul and Midhaul Gateways</li>\n<li>Microwave Backhaul and O-RAN Systems</li>\n<li>Synchronized Data Centers and Edge Cloud Deployments</li>\n<li>Automotive V2X and GNSS-denied environments</li>\n</ul>",
   "sling:resourceType": "macnicaglobal2/components/content/text",
   "textIsRich": "true"
  }
 },
