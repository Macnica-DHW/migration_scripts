  "text_4": {
   "jcr:primaryType": "nt:unstructured",
   "text": "<ul>\n<li>10-output network synchronizer with programmable DPLL</li>\n<li>Supports redundant inputs and reference monitoring</li>\n<li>Compatible with high-speed SerDes (up to 112 Gbps)</li>\n<li>Ideal for timing-sensitive FPGAs and SoCs in 5G basebands</li>\n</ul>\n<hr>\n&nbsp;",
   "sling:resourceType": "macnicaglobal2/components/content/text",
   "textIsRich": "true"
  }
 },
