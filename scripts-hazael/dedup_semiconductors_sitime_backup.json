  "table_1": {
   "jcr:primaryType": "nt:unstructured",
   "text": "<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tbody><tr><th>Feature</th>\n<th>Traditional Quartz Solutions</th>\n<th>SiTime TimeSync™</th>\n</tr><tr><td width=\"33%\">Holdover Stability</td>\n<td width=\"33%\">Minutes</td>\n<td width=\"33%\">Hours+</td>\n</tr><tr><td>Vibration / Shock Resistance</td>\n<td>Low</td>\n<td>100,000 g</td>\n</tr><tr><td>Size and Integration</td>\n<td>Discrete, bulky</td>\n<td>Compact, integrated</td>\n</tr><tr><td>Hitless Switching</td>\n<td>External logic required</td>\n<td>Built-in</td>\n</tr><tr><td>Supply Chain Resilience</td>\n<td>Fragile, geographically-limited</td>\n<td>Fabless MEMS-based</td>\n</tr></tbody></table>",
   "sling:resourceType": "macnicaglobal2/components/content/table",
   "textIsRich": "true"
