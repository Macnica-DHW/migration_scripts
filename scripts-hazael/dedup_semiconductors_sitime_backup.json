  ],
  "text_5": {
   "jcr:primaryType": "nt:unstructured",
   "text": "<ul>\n<li>Focused jitter cleaner with holdover capability, suitable for SyncE deployments and PTP gateways</li>\n</ul>\n<p><i>Note: These devices are often paired with Cascade™-class clock generators for complete clock tree implementations across edge routers, radio units, and backhaul systems.</i></p>",
   "sling:resourceType": "macnicaglobal2/components/content/text",
   "textIsRich": "true"
  }
 },
