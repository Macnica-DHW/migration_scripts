  "text_1": {
   "jcr:primaryType": "nt:unstructured",
   "text": "<h3><b>Precision Network Synchronization for IEEE 1588/PTP</b></h3>\n<p>SiTime’s network synchronizers support nanosecond-level synchronization in distributed systems, enabling accurate timing across communications infrastructure - even under harsh environments and variable conditions.</p>",
   "sling:resourceType": "macnicaglobal2/components/content/text",
   "textIsRich": "true"
  }
 },
