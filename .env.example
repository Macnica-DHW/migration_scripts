# ============================================================
# Migração AEM Macnica GWI -> GLOBAL2
# Copie para .env e preencha. NUNCA versione o .env.
#   cp .env.example .env
# ============================================================

# --- Instância AEM ---
AEM_BASE_URL=https://author-p53812-e590634.adobeaemcloud.com

# --- Autenticação ---
# String COMPLETA de cookies do navegador.
#
# Como obter:
#   1. Logar no AEM pelo Chrome
#   2. F12 -> Network -> marcar "Preserve log"
#   3. Abrir qualquer página em Sites (gera tráfego)
#   4. Clicar numa requisição com status 200 do domínio author-p53812-...
#      (ignorar as entradas "data:font/opentype;base64,..." — são fontes
#       embutidas, não requisições)
#   5. Botão direito -> Copy -> Copy as cURL (bash)
#   6. Colar aqui APENAS o conteúdo entre as aspas depois de -b
#      (sem o -b, sem as aspas simples das pontas)
#
# O cookie que autentica de fato é o login-token. Se o script imprimir
# "login-token presente: NÃO", a requisição copiada foi a errada.
#
# EXPIRA EM ALGUMAS HORAS — quando aparecerem 401/403, repetir o processo.
# Basic Auth NÃO funciona nesta instância (login federado Adobe IMS).
AEM_COOKIES=

# --- Caminhos: origem (SOMENTE LEITURA) ---
AEM_SOURCE_ROOT=/content/macnicagwi/americas/mai/en/products
AEM_GWI_PREFIX=/content/macnicagwi
AEM_GLOBAL2_PREFIX=/content/macnicaglobal2

# --- Caminhos: destino (ÚNICO LUGAR ONDE SE ESCREVE) ---
# Regra inegociável do projeto: nunca escrever em macnicagwi nem em
# macnicaglobal2. Ambos são somente leitura.
AEM_TARGET_ROOT=/content/copia-teste/americas/mai/en/products
AEM_TARGET_PREFIX=/content/copia-teste

# --- Templates ---
AEM_TEMPLATES_ROOT=/conf/macnicaglobal2/settings/wcm/templates
# Buscado por TÍTULO, não pelo nome do nó. Títulos confirmados:
#   Macnica Americas Product Page | Macnica Americas Content Page
#   Top Page                      | Technical Article Page
# O template novo NÃO é dedutível do template antigo — confirmar com o time.
AEM_TEMPLATE_TITLE=Macnica Americas Product Page

# --- DAM (assets) ---
AEM_DAM_SOURCE_PREFIX=/content/dam/macnicagwi
AEM_DAM_TARGET_PREFIX=/content/dam/copia-teste

# --- Experience Fragments ---
AEM_EF_ROOT=/content/experience-fragments/copia-teste/americas/mai/en/site
AEM_XF_TEMPLATE=/conf/macnicaglobal2/settings/wcm/templates/xf-web-variation

# --- Comportamento dos scripts ---
AEM_SOURCE_DEPTH=50
AEM_REQUEST_DELAY=0.05
AEM_WRITE_DELAY=0.1
AEM_TIMEOUT=30
AEM_MAX_PAGES=3000
# Nº de 401/403 seguidos antes de considerar a sessão expirada e parar
AEM_AUTH_FAIL_THRESHOLD=5

# Caminhos a ignorar no crawl, separados por ";"
# A pasta sony-image-sensors está duplicada dentro dela mesma no GWI
# (184 páginas fantasmas vazias) — problema de dados na origem, não do script.
AEM_SKIP_PATH_CONTAINS=sony-image-sensors/sony-image-sensors
